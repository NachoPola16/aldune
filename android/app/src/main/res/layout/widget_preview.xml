<?xml version="1.0" encoding="utf-8"?>
<!-- La vista previa del selector de widgets: el fondo oscuro y tres tiras con los colores del logo de Aldune. Es arte fijo, no chrome. Solo clases
     que admite RemoteViews (un View suelto no se infla en el lanzador). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2A261F"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingBottom="6dp"
        android:text="@string/app_name"
        android:textColor="#B8B1A6"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginBottom="4dp"
        android:background="#EBD38B" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginBottom="4dp"
        android:background="#83E7F2" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:background="#F9BEF2" />
</LinearLayout>
