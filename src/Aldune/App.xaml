<Application x:Class="Aldune.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Aldune.Windowing"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnExplicitShutdown">
    <!-- OnExplicitShutdown y no OnLastWindowClose: desde que hay icono de bandeja, cerrar la
         ultima nota no debe cerrar la app. Se sale por "Salir" del menu de la bandeja, o por los
         Shutdown(1) explicitos de los fallos de arranque. -->
    <Application.Resources>
        <!-- Escala tipográfica del chrome (ventanas, diálogos, avisos): cuatro tamaños y nada más. Los
             textos usan estas claves, no números sueltos. Quedan fuera las notas (su cuerpo y sus
             controles tienen medidas propias, ligadas a la piel) y los glifos de icono. -->
        <sys:Double x:Key="AlduneTextSmall">11</sys:Double>   <!-- pistas, subtítulos, estados -->
        <sys:Double x:Key="AlduneTextBody">13</sys:Double>    <!-- el texto normal y las etiquetas -->
        <sys:Double x:Key="AlduneTextTitle">15</sys:Double>   <!-- título de una página o sección -->
        <sys:Double x:Key="AlduneTextHeading">17</sys:Double> <!-- título de una ventana o diálogo -->
        <!-- Base visual compartida. Los colores de cada nota siguen siendo independientes, pero el
             chrome de Aldune parte de estos mismos valores en todas las ventanas. -->
        <!-- Borde de las cajas de texto al pasar el ratón y con el foco: compartido por TextBox,
             PasswordBox y la caja de contraseña de PasswordPromptWindow para que no se separen. -->

        <!-- La fuente del chrome (AldunePrimaryFont) NO se pone aqui: un estilo implicito solo casa con
             el tipo exacto Window, no con NoteWindow/EdgeDockWindow/... (ver App.OnStartup, donde un
             manejador de clase la aplica a todas las ventanas). -->
        <Style TargetType="Window">
            <Setter Property="FontSize" Value="{StaticResource AlduneTextBody}" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource AlduneGroundBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBackground" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource AlduneRadius4}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource AlduneRaisedHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource AlduneHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource AlduneSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AlduneBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownButton" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Border x:Name="Field" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{DynamicResource AlduneRadius6}" Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                                          VerticalAlignment="Center" />
                                        <TextBlock Text="&#x2304;" FontSize="12"
                                                   Foreground="{DynamicResource AlduneMutedTextBrush}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" Margin="8,0,1,3" />
                                    </Grid>
                                </Border>
                            </ToggleButton>
                            <Popup x:Name="DropDown" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade" PlacementTarget="{Binding ElementName=DropDownButton}">
                                <Border Background="{DynamicResource AlduneGroundBrush}" BorderBrush="{DynamicResource AlduneBorderBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource AlduneRadius6}" Padding="3" Width="{Binding ActualWidth, ElementName=DropDownButton}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  CanContentScroll="True" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource AlduneHintBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource AlduneAccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Field" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="17" Height="17" CornerRadius="{DynamicResource AlduneRadius4}"
                                    BorderBrush="{TemplateBinding Foreground}"
                                    BorderThickness="1.5" Background="Transparent"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock x:Name="Tick" Text="&#x2713;" FontSize="12"
                                               FontWeight="Bold" Foreground="{TemplateBinding Background}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                    <Border x:Name="Dash" Width="9" Height="2" CornerRadius="1"
                                            Background="{TemplateBinding Background}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Box" Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra de scroll fina y oscura, aquí y no en cada ventana: la barra por defecto de WPF es
             gris claro con flechas, y canta sobre cualquier superficie de esta app. Estaba definida
             solo dentro de NotesManagerWindow; subirla a la aplicación evita duplicarla en cada
             ventana nueva que necesite scroll (Ajustes ya es la segunda). -->
        <Style x:Key="SlimThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar"
                                Background="{DynamicResource AlduneSelectionBrush}"
                                BorderBrush="{DynamicResource AlduneAccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource AlduneRadius4}"
                                Margin="1,2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AlduneAccentBrush}" />
                                <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource AlduneScrollThumbBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AlduneAccentHoverBrush}" />
                                <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource AlduneScrollThumbDragBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filas de los paneles de acciones (el "⋯" de la nota y el clic derecho en una pestaña del
             dock). Van sobre el fondo oscuro del panel, alineadas a la izquierda y a todo el ancho,
             como las filas de un menú. Aquí y no en cada ventana: son los dos sitios que abren el
             mismo panel. -->
        <Style x:Key="NoteMenuItemStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource AlduneRadius6}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneRaisedHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NoteMenuDangerStyle" TargetType="Button" BasedOn="{StaticResource NoteMenuItemStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AlduneDangerTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource AlduneRadius6}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneDangerHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- El tooltip de sistema es claro (blanco/gris), y desentona tanto sobre el chrome oscuro
             del dock/Ajustes/gestor como sobre el pastel de una nota — es el único texto flotante
             de toda la app que no sigue su propio estilo. Aquí y no en cada ventana, como el resto
             de estilos de esta sección: son implícitos (sin x:Key), así que un ToolTip="..." normal
             en cualquier ventana ya sale con este aspecto sin tocar cada sitio donde se usa.
             Mismo tratamiento que ActionsPopup (fondo Ground, esquinas redondeadas, sombra caída),
             para que se sienta parte de la misma familia visual que el resto de paneles flotantes. -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <!-- Dos capas en vez de un solo Border con Effect: un Effect (DropShadowEffect,
                             Blur, etc.) obliga a WPF a rasterizar todo el subárbol a un bitmap a
                             resolución fija y luego estirarlo, así que con el Effect y el texto en el
                             mismo Border, el texto sale borroso en monitores con escala >100%. La capa
                             de sombra (sin contenido, solo el relleno) sí puede rasterizarse sin que se
                             note; la de contenido va encima, sin Effect, y sale nítida siempre. -->
                        <Grid>
                            <Border Background="{DynamicResource AlduneGroundBrush}" CornerRadius="{DynamicResource AlduneRadius6}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270"
                                                      Color="#000000" Opacity="0.4" />
                                </Border.Effect>
                            </Border>
                            <Border Background="{DynamicResource AlduneGroundBrush}" CornerRadius="{DynamicResource AlduneRadius6}" Padding="9,6">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- El Calendar del selector de recordatorio (NoteWindow) usa la plantilla por defecto de
             WPF, pensada para tema claro — sobre el panel oscuro del "⋯" (#2A261F) se veía como un
             recuadro blanco ajeno al resto de la app. Implícitos (sin x:Key) para que CalendarButton/
             CalendarDayButton salgan así en cualquier Calendar futuro sin repetir esto — mismo criterio
             que ToolTip/ScrollBar más arriba. Solo se toca Foreground (el estado "normal" del día):
             los estados especiales (hoy, seleccionado, deshabilitado) siguen usando los colores por
             defecto de la plantilla, que ya funcionan razonablemente sobre fondo oscuro. -->
        <Style TargetType="CalendarDayButton">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextBrush}" />
        </Style>
        <Style TargetType="CalendarButton">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextBrush}" />
        </Style>
        <Style x:Key="DarkCalendarStyle" TargetType="Calendar">
            <Setter Property="Background" Value="{DynamicResource AlduneGroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AlduneRaisedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextBrush}" />
        </Style>

        <!-- El menú nativo de un TextBox (cortar/copiar/pegar) sale con el tema claro de Windows:
             sobre una nota pastel pasa, pero dentro de Ajustes, el gestor o el propio panel oscuro del
             "⋯" (ReminderHourBox/ReminderMinuteBox, NewTagTextBox...) es el único flotante claro de la
             app. Implícito, como ToolTip y Calendar: lo coge cualquier TextBox futuro sin tocarlo. Los
             comandos siguen siendo los nativos (con su traducción del Windows del usuario), solo se
             replantilla la superficie y las filas a la familia NoteMenuItemStyle. -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource AlduneGroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AldunePressedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <!-- Margin="10": sin aire alrededor la sombra cae fuera del HWND del menú y sale
                             recortada; es el mismo margen que llevan los demás paneles flotantes.
                             Dos capas en vez de un solo Border con Effect: el Effect fuerza a WPF a
                             rasterizar todo el subárbol (incluido el texto de ItemsPresenter) a un
                             bitmap de resolución fija que luego se estira, y en monitores con escala
                             >100% eso sale borroso. La capa de sombra no lleva contenido (rasterizarla
                             no se nota), la de contenido va encima sin Effect y sale siempre nítida. -->
                        <Grid Margin="10">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource AlduneRadius10}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270"
                                                      Color="#000000" Opacity="0.4" />
                                </Border.Effect>
                            </Border>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource AlduneRadius10}" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource AlduneRadius6}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneRaisedHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource AlduneHintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Origen del autoscroll (el punto donde se hizo el clic central). Se fija por código en
             VisualOffset o en el color de la nota; aquí solo vive la forma. -->
        <Canvas x:Key="AutoScrollOriginGlyph" x:Shared="False" Width="24" Height="24">
            <Ellipse Width="7" Height="7" Canvas.Left="8.5" Canvas.Top="8.5"
                     Fill="{DynamicResource AlduneTextBrush}" />
            <Path Data="M12 1 L14.4 4.2 H9.6 Z" Fill="{DynamicResource AlduneHintBrush}" />
            <Path Data="M12 23 L9.6 19.8 H14.4 Z" Fill="{DynamicResource AlduneHintBrush}" />
            <Path Data="M1 12 L4.2 9.6 V14.4 Z" Fill="{DynamicResource AlduneHintBrush}" />
            <Path Data="M23 12 L19.8 14.4 V9.6 Z" Fill="{DynamicResource AlduneHintBrush}" />
        </Canvas>


        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Background" Value="#26000000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimThumb}" />
                                </Track.Thumb>
                                <!-- Sin flechas: la pista sigue paginando al hacer clic, que es el
                                     comportamiento estándar que importa conservar. -->
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  Focusable="False"
                                                  BorderThickness="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  Focusable="False"
                                                  BorderThickness="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones y caja de texto de los diálogos pequeños (color personalizado, editor de
             temas). Vivían dentro de CustomColorWindow; aquí para compartirlos. -->
        <Style x:Key="ColorDialogButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource AlduneRaisedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBackground" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AlduneRadius6}">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- Relieve de la piel Bevel; con las demás no dibuja nada. -->
                            <local:BevelEdge OnlyWhenSquare="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource AlduneHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource AlduneSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AlduneTextDisabledBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryColorDialogButtonStyle" TargetType="Button"
               BasedOn="{StaticResource ColorDialogButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AlduneAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AlduneOnAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBackground" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AlduneRadius6}">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- Relieve de la piel Bevel; con las demás no dibuja nada. -->
                            <local:BevelEdge OnlyWhenSquare="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource AlduneAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource AlduneTrackBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AlduneTextDisabledBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Plantilla propia de las cajas de texto: la de Windows pinta el borde azul de sistema al
             pasar el ratón y al escribir, lo único azul de toda la app. El foco usa el mismo tono
             cálido que la caja de contraseña (PasswordFieldBorderStyle). Las cajas sin borde
             (BorderThickness=0, como las de Ajustes) siguen igual que antes. -->
        <ControlTemplate x:Key="AlduneTextBoxTemplate" TargetType="TextBox">
            <Border x:Name="Field" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource AlduneRadius6}" SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource AlduneFieldHoverBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource AlduneFieldFocusBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Field" Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Implícito: cubre también las cajas sin estilo propio (las horas del recordatorio salían
             blancas con borde azul en mitad del panel oscuro). -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextStrongBrush}" />
            <Setter Property="Background" Value="{DynamicResource AlduneRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AlduneBorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource AlduneTextStrongBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AlduneSelectionBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource AlduneTextBoxTemplate}" />
        </Style>

        <Style x:Key="ColorTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextStrongBrush}" />
            <Setter Property="Background" Value="{DynamicResource AlduneRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AlduneBorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource AlduneTextStrongBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AlduneSelectionBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Field" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource AlduneRadius6}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource AlduneFieldHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource AlduneFieldFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Field" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
