<Application x:Class="Aldune.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- OnExplicitShutdown y no OnLastWindowClose: desde que hay icono de bandeja, cerrar la
         ultima nota no debe cerrar la app. Se sale por "Salir" del menu de la bandeja, o por los
         Shutdown(1) explicitos de los fallos de arranque. -->
    <Application.Resources>
        <!-- Base visual compartida. Los colores de cada nota siguen siendo independientes, pero el
             chrome de Aldune parte de estos mismos valores en todas las ventanas. -->
        <SolidColorBrush x:Key="AlduneGroundBrush" Color="#2A261F" />
        <SolidColorBrush x:Key="AlduneSurfaceBrush" Color="#332F28" />
        <SolidColorBrush x:Key="AlduneRaisedBrush" Color="#3C3730" />
        <SolidColorBrush x:Key="AlduneHoverBrush" Color="#4E4840" />
        <SolidColorBrush x:Key="AldunePressedBrush" Color="#5F584E" />
        <SolidColorBrush x:Key="AlduneTextBrush" Color="#EDE7DC" />
        <SolidColorBrush x:Key="AlduneMutedTextBrush" Color="#A79E90" />
        <SolidColorBrush x:Key="AlduneHintBrush" Color="#8A8175" />
        <SolidColorBrush x:Key="AlduneDividerBrush" Color="#3C3730" />

        <!-- FontFamily is an inherited property, so setting it here on the implicit Window
             style cascades to every control in EdgeDockWindow and NoteWindow that doesn't set
             its own — Segoe UI Variable Text is Windows 11's own default UI font anyway, so
             this brings the app's chrome in line with the system look instead of away from it. -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EDE7DC" />
            <Setter Property="Background" Value="#2A261F" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBackground" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="#403B33" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="#4E4840" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EDE7DC" />
            <Setter Property="Background" Value="#332F28" />
            <Setter Property="BorderBrush" Value="#62594D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownButton" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Border x:Name="Field" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                                          VerticalAlignment="Center" />
                                        <TextBlock Text="&#x2304;" FontSize="12"
                                                   Foreground="#A79E90" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" Margin="8,0,1,3" />
                                    </Grid>
                                </Border>
                            </ToggleButton>
                            <Popup x:Name="DropDown" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade" PlacementTarget="{Binding ElementName=DropDownButton}">
                                <Border Background="#2A261F" BorderBrush="#62594D" BorderThickness="1"
                                        CornerRadius="6" Padding="3" Width="{Binding ActualWidth, ElementName=DropDownButton}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  CanContentScroll="True" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="#8A8175" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="#B39A7E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Field" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="17" Height="17" CornerRadius="4"
                                    BorderBrush="{TemplateBinding Foreground}"
                                    BorderThickness="1.5" Background="Transparent"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock x:Name="Tick" Text="&#x2713;" FontSize="12"
                                               FontWeight="Bold" Foreground="{TemplateBinding Background}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                    <Border x:Name="Dash" Width="9" Height="2" CornerRadius="1"
                                            Background="{TemplateBinding Background}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Box" Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra de scroll fina y oscura, aquí y no en cada ventana: la barra por defecto de WPF es
             gris claro con flechas, y canta sobre cualquier superficie de esta app. Estaba definida
             solo dentro de NotesManagerWindow; subirla a la aplicación evita duplicarla en cada
             ventana nueva que necesite scroll (Ajustes ya es la segunda). -->
        <Style x:Key="SlimThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar"
                                Background="#806A55"
                                BorderBrush="#B39A7E"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="1,2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="#A18465" />
                                <Setter TargetName="Bar" Property="BorderBrush" Value="#D0B28E" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="#B79570" />
                                <Setter TargetName="Bar" Property="BorderBrush" Value="#E0C6A4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filas de los paneles de acciones (el "⋯" de la nota y el clic derecho en una pestaña del
             dock). Van sobre el fondo oscuro del panel, alineadas a la izquierda y a todo el ancho,
             como las filas de un menú. Aquí y no en cada ventana: son los dos sitios que abren el
             mismo panel. -->
        <Style x:Key="NoteMenuItemStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#EDE7DC" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#403B33" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NoteMenuDangerStyle" TargetType="Button" BasedOn="{StaticResource NoteMenuItemStyle}">
            <Setter Property="Foreground" Value="#E8A0A0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#5A2E2E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- El tooltip de sistema es claro (blanco/gris), y desentona tanto sobre el chrome oscuro
             del dock/Ajustes/gestor como sobre el pastel de una nota — es el único texto flotante
             de toda la app que no sigue su propio estilo. Aquí y no en cada ventana, como el resto
             de estilos de esta sección: son implícitos (sin x:Key), así que un ToolTip="..." normal
             en cualquier ventana ya sale con este aspecto sin tocar cada sitio donde se usa.
             Mismo tratamiento que ActionsPopup (fondo Ground, esquinas redondeadas, sombra caída),
             para que se sienta parte de la misma familia visual que el resto de paneles flotantes. -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#EDE7DC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#2A261F" CornerRadius="6" Padding="9,6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270"
                                                  Color="#000000" Opacity="0.4" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- El Calendar del selector de recordatorio (NoteWindow) usa la plantilla por defecto de
             WPF, pensada para tema claro — sobre el panel oscuro del "⋯" (#2A261F) se veía como un
             recuadro blanco ajeno al resto de la app. Implícitos (sin x:Key) para que CalendarButton/
             CalendarDayButton salgan así en cualquier Calendar futuro sin repetir esto — mismo criterio
             que ToolTip/ScrollBar más arriba. Solo se toca Foreground (el estado "normal" del día):
             los estados especiales (hoy, seleccionado, deshabilitado) siguen usando los colores por
             defecto de la plantilla, que ya funcionan razonablemente sobre fondo oscuro. -->
        <Style TargetType="CalendarDayButton">
            <Setter Property="Foreground" Value="#EDE7DC" />
        </Style>
        <Style TargetType="CalendarButton">
            <Setter Property="Foreground" Value="#EDE7DC" />
        </Style>
        <Style x:Key="DarkCalendarStyle" TargetType="Calendar">
            <Setter Property="Background" Value="#2A261F" />
            <Setter Property="BorderBrush" Value="#3C3730" />
            <Setter Property="Foreground" Value="#EDE7DC" />
        </Style>

        <!-- Origen del autoscroll (el punto donde se hizo el clic central). Se fija por código en
             VisualOffset o en el color de la nota; aquí solo vive la forma. -->
        <Canvas x:Key="AutoScrollOriginGlyph" x:Shared="False" Width="24" Height="24">
            <Ellipse Width="7" Height="7" Canvas.Left="8.5" Canvas.Top="8.5"
                     Fill="{DynamicResource AlduneTextBrush}" />
            <Path Data="M12 1 L14.4 4.2 H9.6 Z" Fill="{DynamicResource AlduneHintBrush}" />
            <Path Data="M12 23 L9.6 19.8 H14.4 Z" Fill="{DynamicResource AlduneHintBrush}" />
            <Path Data="M1 12 L4.2 9.6 V14.4 Z" Fill="{DynamicResource AlduneHintBrush}" />
            <Path Data="M23 12 L19.8 14.4 V9.6 Z" Fill="{DynamicResource AlduneHintBrush}" />
        </Canvas>


        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Background" Value="#26000000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimThumb}" />
                                </Track.Thumb>
                                <!-- Sin flechas: la pista sigue paginando al hacer clic, que es el
                                     comportamiento estándar que importa conservar. -->
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  Focusable="False"
                                                  BorderThickness="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  Focusable="False"
                                                  BorderThickness="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
