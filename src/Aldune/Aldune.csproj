<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Aldune.Core\Aldune.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms mete System.Windows.Forms y System.Drawing en los global usings de TODO el
         proyecto, y ahi chocan con WPF: Application, Button, Point y Color existen en los dos
         mundos, asi que cada fichero empezaba a dar CS0104. Se sacan del ambito global y solo
         TrayIcon.cs los pide explicitamente, que es el unico sitio que necesita WinForms. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>aldune</AssemblyName>
    <!-- Metadatos de marca: son los que Windows muestra en las propiedades del .exe, en el
         Administrador de tareas y en el dialogo de Inno Setup. Sin esto, apareceria el nombre
         tecnico del ensamblado ("aldune", en minusculas) en vez del nombre del producto. -->
    <Version>0.10.4</Version>
    <AssemblyVersion>0.10.4.0</AssemblyVersion>
    <FileVersion>0.10.4.0</FileVersion>
    <Product>Aldune</Product>
    <AssemblyTitle>Aldune</AssemblyTitle>
    <Company>Aldune</Company>
    <Description>Aldune: notas adhesivas ancladas al borde de la pantalla, con tareas, recordatorios y sincronizacion opcional.</Description>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Solo por NotifyIcon: WPF no trae icono de bandeja, y el envoltorio de WinForms es bastante
         menos codigo que hablar con Shell_NotifyIcon por P/Invoke. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\aldune.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Sin simbolos de depuracion al compilar en Release: el instalador solo reparte aldune.exe, y un
       .pdb suelto a su lado no le sirve a nadie. Esto vivia en scripts/build-installer.ps1 como
       -p:DebugSymbols=false -p:DebugType=None, pero una propiedad global de MSBuild alcanza tambien a
       los proyectos referenciados: Aldune.Core se compilaba en Release sin .pdb, su copia de
       bin\Release quedaba sin regenerar (la compilacion de Core estaba "al dia") y el siguiente
       "dotnet test -c Release" fallaba con MSB3030 al intentar copiarla. Aqui solo afecta a este
       proyecto, que es el unico que se publica. Ver docs/STATUS.md, sesion 2026-09-16. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
