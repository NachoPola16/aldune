<Window x:Class="Aldune.Windowing.EdgeDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aldune.Windowing"
        xmlns:res="clr-namespace:Aldune.Resources"
        WindowStyle="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnDockPreviewKeyDown">
    <!-- AllowsTransparency, a diferencia del resto de la app. Antes la forma del dock la recortaba
         SetWindowRgn, y una región es una máscara de 1 BIT: un píxel está dentro o fuera, sin
         medios tonos, así que toda curva salía escalonada — las esquinas de las pestañas y sobre
         todo los botones circulares, que son curva pura. No había ningún parámetro que suavizar.

         El precio es que esta ventana pierde el suavizado subpixel (ClearType) en su texto, que es
         lo que la spec v1 quería evitar. Se asume solo aquí: el texto del dock son etiquetas cortas
         de una línea, mientras que NoteWindow — la superficie donde de verdad se lee y se escribe —
         sigue siendo opaca y conserva ClearType.

         A cambio desaparece toda la maquinaria de región: SetWindowRgn por frame, el bucle de
         CompositionTarget.Rendering, el recorte al viewport y el clip por pestaña. La forma la
         dibuja WPF, con antialiasing, y encima el dock puede tener sombra de verdad. -->
    <Window.Resources>
        <local:NoteTabLabelConverter x:Key="NoteTabLabelConverter" />
        <local:NoteRimConverter x:Key="NoteRimConverter" />
        <local:NoteLabelColorConverter x:Key="NoteLabelColorConverter" />
        <local:NoteSnippetConverter x:Key="NoteSnippetConverter" />

        <ItemsPanelTemplate x:Key="HorizontalItemsPanelTemplate">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="HorizontalRestDashTemplate">
            <Border Background="{Binding Color}"
                    Width="26" Height="12"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Center"
                    CornerRadius="6" />
        </DataTemplate>

        <!-- Hacia ARRIBA (Direction 95), no hacia abajo. Las pestañas se apilan hacia abajo y cada
             una tapa a la anterior, así que una sombra descendente cae justo donde la siguiente la
             oculta y no separa nada: con solape leve el abanico se leía como un bloque macizo.
             Proyectada hacia arriba, cada pestaña deja un canto oscuro sobre la de encima, que es
             exactamente como se ve un mazo escalonado. Comprobado contra las tres variantes
             renderizadas en aislamiento. -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="9" ShadowDepth="3" Direction="95"
                          Color="#000000" Opacity="0.38" />

        <DropShadowEffect x:Key="CardShadowTop" BlurRadius="9" ShadowDepth="3" Direction="270"
                          Color="#000000" Opacity="0.38" />

        <DropShadowEffect x:Key="CardShadowBottom" BlurRadius="9" ShadowDepth="3" Direction="90"
                          Color="#000000" Opacity="0.38" />

        <!-- Los botones no se apilan, así que su sombra sí cae hacia abajo como es natural. -->
        <DropShadowEffect x:Key="ButtonShadow" BlurRadius="12" ShadowDepth="2" Direction="270"
                          Color="#000000" Opacity="0.45" />

        <!-- Reflejo en los cantos, cara plana en medio. Con una rampa larga el degradado se leía
             como tal y las pestañas parecían plástico brillante iluminado de lado, no papel. -->
        <LinearGradientBrush x:Key="TabSheen" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#1AFFFFFF" />
            <GradientStop Offset="0.08" Color="#00FFFFFF" />
            <GradientStop Offset="0.92" Color="#00000000" />
            <GradientStop Offset="1" Color="#14000000" />
        </LinearGradientBrush>

        <!-- Mismos GradientStop que TabSheen, con el sentido de la línea invertido (StartPoint/
             EndPoint al revés): el claro cae ahora en el canto derecho y el oscuro en el izquierdo,
             para el dock a la izquierda — ver ApplyEdgeMirroring en el code-behind, que elige entre
             las dos según _edge en vez de calcular un degradado nuevo cada vez. -->
        <LinearGradientBrush x:Key="TabSheenLeftEdge" StartPoint="1,0" EndPoint="0,0">
            <GradientStop Offset="0" Color="#1AFFFFFF" />
            <GradientStop Offset="0.08" Color="#00FFFFFF" />
            <GradientStop Offset="0.92" Color="#00000000" />
            <GradientStop Offset="1" Color="#14000000" />
        </LinearGradientBrush>

        <Style x:Key="NoteTabButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Redondeada solo por la izquierda: el lado derecho va a ras del canto de
                             la pantalla y redondearlo dejaría ver el escritorio por una muesca. Es
                             el valor correcto para EdgePosition.Right — con el dock a la izquierda,
                             OnTabLoaded espeja CornerRadius/BorderThickness de CardBorder y
                             SheenBorder (y cambia su Background a TabSheenLeftEdge), porque entonces
                             es el lado IZQUIERDO el que va a ras del canto real de la pantalla. -->
                        <Grid x:Name="CardRoot" Effect="{StaticResource CardShadow}">
                            <Border x:Name="CardBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{Binding Color, Converter={StaticResource NoteRimConverter}}"
                                    BorderThickness="1,1,0,1"
                                    CornerRadius="10,0,0,10" />
                            <Border x:Name="SheenBorder" Background="{StaticResource TabSheen}" CornerRadius="10,0,0,10" />

                            <!-- Dos líneas, ancladas arriba. Al solaparse las pestañas solo queda
                                 visible la franja superior de cada una, así que ahí tiene que
                                 vivir el título; la vista previa es lo primero que se sacrifica, y
                                 está bien porque el título es lo que no puede faltar.

                                 Ambas en tonos del propio color de la nota: el negro sería el
                                 único valor de la pestaña sin relación de hue con ella. -->
                            <StackPanel x:Name="LabelStack" VerticalAlignment="Top" Margin="16,9,20,0">
                                <TextBlock Text="{Binding Converter={StaticResource NoteTabLabelConverter}}"
                                           Foreground="{Binding Color, Converter={StaticResource NoteLabelColorConverter}}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                                <TextBlock x:Name="SnippetText"
                                           Text="{Binding Converter={StaticResource NoteSnippetConverter}}"
                                           Foreground="{Binding Color, Converter={StaticResource NoteLabelColorConverter}}"
                                           Opacity="0.62"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Solo el glifo importa aquí, no si hay hueco para más: cuando las
                                 pestañas se apilan solo se ve la franja superior de cada una (ver
                                 el comentario de LabelStack), así que el badge va en esa misma
                                 franja, arriba a la derecha. Glifo elegido sin verificación visual
                                 todavía — mismo aviso que el resto de iconos de esta sesión, ver
                                 docs/STATUS.md. -->
                            <TextBlock x:Name="ReminderBadge"
                                       Text="&#xE917;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{Binding Color, Converter={StaticResource NoteLabelColorConverter}}"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Margin="0,8,10,0"
                                       Visibility="Collapsed" />

                            <Border x:Name="HoverOverlay" Background="#1E1A14" Opacity="0" CornerRadius="10,0,0,10" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Converter={StaticResource NoteSnippetConverter}}" Value="">
                                <Setter TargetName="SnippetText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="LabelStack" Property="VerticalAlignment" Value="Center" />
                                <Setter TargetName="LabelStack" Property="Margin" Value="16,0,20,0" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.07" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.15" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircularIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#C9C0B2" />
            <Setter Property="Background" Value="#3C3730" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Círculo de verdad, ya sin escalonado: con la región era una máscara de
                             1 bit, y una circunferencia es curva pura, o sea el peor caso.

                             Relleno oscuro + aro claro + sombra: el dock flota sobre el fondo de
                             escritorio que sea, y un botón de un solo tono desaparece contra la
                             mitad de ellos. Sobre fondo claro lo delatan el relleno y la sombra;
                             sobre fondo oscuro, el aro. Cualquiera de los dos basta. -->
                        <Grid>
                            <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}"
                                     Stroke="#8FA79E90" StrokeThickness="1"
                                     Effect="{StaticResource ButtonShadow}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#4E4840" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#5F584E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollArrowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="#E8D8C5" />
            <Setter Property="Background" Value="#B52A241E" />
            <Setter Property="BorderBrush" Value="#D08F7965" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ArrowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArrowBorder" Property="Background" Value="#D14A3D31" />
                                <Setter TargetName="ArrowBorder" Property="BorderBrush" Value="#F0C7A5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ArrowBorder" Property="Background" Value="#E05B4939" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- El ContextMenu nativo trae un marco y una sombra del tema de Windows que no pertenecen
             al dock. El panel interior ya dibuja su propia superficie, radio y sombra, así que el
             contenedor del menú solo debe presentar los elementos sin añadir otra caja. -->
        <Style x:Key="DockContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="Transparent" Padding="0">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Salir es una acción secundaria: está disponible, pero no debe competir visualmente con
             crear nota, gestionar u organizar. El icono de encendido comunica salir de Aldune sin
             confundirse con la X de cerrar una nota. -->
    </Window.Resources>

    <!-- Margen asimétrico: sin derecha. WindowThickness reserva UN ShadowMargin, no dos, porque
         el lado derecho va a ras del canto de la pantalla y ahí no hay sombra que alojar. Con
         Margin="18" a los cuatro lados quedaban 190px para una pestaña de 208, así que se
         recortaba 18px por la izquierda — justo donde vive el margen de la etiqueta, y por eso el
         título salía cortado.

         Correcto solo para EdgePosition.Right. Con el dock a la izquierda es el lado IZQUIERDO el
         que va a ras del canto real, así que este margen se espeja por código en
         EdgeDockWindow.ApplyEdgeAlignment — era la causa real del hueco que seguía viéndose incluso
         después de corregir la tira/pestañas/pie por separado: todo eso vive DENTRO de este Grid,
         así que un Grid ya encogido 18px por el lado equivocado deja hueco pase lo que pase con la
         alineación de sus hijos. -->
    <Grid x:Name="ContentGrid" Margin="18,18,0,18">
        <!-- Dos capas superpuestas con fundido cruzado. Volver a este patrón (que una ronda
             anterior había eliminado) es correcto ahora: lo que lo hacía frágil era tener que
             mantener la región sincronizada con él, y ya no hay región. El cuidado que sí sigue
             valiendo es que Opacity NO desactiva el hit-testing en WPF — IsHitTestVisible se fija
             explícitamente en ApplyState, o la capa invisible se come los clics de la visible. -->

        <!-- Reposo: la tira de guiones dentro de su contenedor.

             El relleno va solo ARRIBA: cada guion ya lleva su propio margen inferior, asi que un
             relleno simetrico sumaba dos veces por abajo y la tira quedaba descentrada dentro del
             contenedor — 5px, muy visibles con una sola nota. -->
        <!-- Los numeros de aqui son los de EdgeGeometry: Width = RestContainerWidth (20),
             Margin derecho = RestContainerInset (5), Padding = RestContainerPad (5), y el guion
             de abajo RestDashWidth x RestDashLength con RestGap de separacion. Tienen que ir
             juntos: RestingVisibleRect calcula la zona sensible al raton con esas constantes, asi
             que si el XAML se separa de ellas el raton deja de coincidir con lo que se ve. -->
        <!-- HorizontalAlignment/Margin espejados por código para el dock a la izquierda — ver el
             comentario junto a FooterBorder más abajo, mismo bug y mismo arreglo. -->
        <Border x:Name="RestStrip"
                Background="#2A261F"
                CornerRadius="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="20"
                Margin="0,0,5,0"
                Padding="0,5,0,0"
                Effect="{StaticResource ButtonShadow}">
            <!-- ItemsSource se fija desde SetNotes, no se ata a TabsList: en reposo solo se dibujan
                 los guiones que caben en la ventana (ver EdgeGeometry.VisibleRestDashes), porque esta
                 tira no hace scroll y los sobrantes se recortarían. -->
            <ItemsControl x:Name="RestList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Color}"
                                Width="12" Height="26"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                CornerRadius="6" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Desplegado: el abanico y los botones. -->
        <Grid x:Name="FanPanel" Opacity="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Auto y no Hidden: desde que la ventana tiene tope (ver EdgeGeometry.FanBudget), con
                 muchas notas queda abanico fuera de la vista, y sin barra no habría ninguna pista de
                 que se puede seguir bajando.

                 Panel.ZIndex="1": FooterBorder es la fila 1 de este mismo Grid y, al declararse
                 después en el XAML, pintaría por encima por defecto. El ZIndex que
                 OnTabDragMove pone en la pestaña que se arrastra (Panel.SetZIndex(_dragButton,
                 1000)) solo compite con sus hermanas DENTRO del StackPanel de TabsList — no
                 alcanza a FooterBorder, que vive un nivel más arriba, en otra fila de este Grid.
                 Sin esto, arrastrar una pestaña hacia abajo lo bastante para solapar con la fila
                 del pie la dejaba por detrás de los botones (reportado por el usuario,
                 2026-09-11). -->
            <Grid x:Name="NotesColumn"
                  Width="208"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Stretch"
                  Panel.ZIndex="1">
                <ScrollViewer x:Name="TabsScroll"
                              VerticalAlignment="Stretch"
                              Focusable="True"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="0"
                              FocusVisualStyle="{x:Null}"
                              PreviewMouseWheel="OnTabsPreviewMouseWheel"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                <!-- El desplazamiento sigue disponible con la rueda, pero la barra del sistema no
                     debe reservar una columna invisible: esa columna estrechaba el viewport y
                     recortaba el borde derecho de las tarjetas. -->
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="0" />
                        <Setter Property="Visibility" Value="Hidden" />
                    </Style>
                </ScrollViewer.Resources>
                <!-- Margen = EdgeGeometry.TabShadowHeadroom (14). Va aquí, dentro del contenido
                     desplazable, y no como Padding del ScrollViewer: el recorte del viewport cae
                     justo en ese borde, así que como relleno la sombra se seguiría perdiendo. Sin
                     esto, la primera pestaña se veía como un rectángulo de canto recto — su sombra
                     va hacia arriba y no tenía dónde dibujarse. -->
                <ItemsControl x:Name="TabsList" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Background="{Binding Color}"
                                    Width="208"
                                    Height="52"
                                    HorizontalAlignment="Right"
                                    Click="OnTabClick"
                                    Loaded="OnTabLoaded"
                                    MouseEnter="OnTabMouseEnter"
                                    MouseLeave="OnTabMouseLeave"
                                    MouseRightButtonUp="OnTabRightClick"
                                    PreviewMouseLeftButtonDown="OnTabDragStart"
                                    PreviewMouseMove="OnTabDragMove"
                                    PreviewMouseLeftButtonUp="OnTabDragEnd"
                                    Tag="{Binding}"
                                    Style="{StaticResource NoteTabButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>

            <!-- Indicador propio del dock: queda superpuesto al borde de las tarjetas y no consume
                 ancho del viewport como el ScrollBar de WPF. El desplazamiento sigue haciéndose
                 con la rueda; aquí solo mostramos la posición y cuánto contenido queda. -->
                <Grid x:Name="ScrollOverlay"
                      Width="12"
                      Height="{Binding ActualHeight, ElementName=TabsScroll}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Panel.ZIndex="2"
                      IsHitTestVisible="True"
                      Cursor="Hand"
                      MouseLeftButtonDown="OnScrollIndicatorMouseLeftButtonDown"
                      MouseMove="OnScrollIndicatorMouseMove"
                      MouseLeftButtonUp="OnScrollIndicatorMouseLeftButtonUp"
                      Visibility="Collapsed">
                <Border x:Name="ScrollRailTrack"
                        Width="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Margin="0,8"
                        Background="#B52A241E"
                        CornerRadius="4"
                        BorderBrush="#C08B7461"
                        BorderThickness="1" />
                <Canvas x:Name="ScrollRailCanvas" Margin="0,8">
                    <Border x:Name="ScrollRailThumb"
                            Width="8"
                            Height="32"
                            Background="#E1C2A88F"
                            BorderBrush="#F2DCC2"
                            BorderThickness="1"
                            CornerRadius="4" />
                </Canvas>
                </Grid>

            <!-- En los docks superior e inferior la barra vertical se sustituye por una indicación
                 de navegación más natural para la columna de tarjetas: dos flechas pequeñas,
                 colocadas en el mismo canto que ocuparía el rail. La rueda sigue desplazando la
                 lista y las flechas del teclado funcionan cuando el dock tiene el foco. -->
                <StackPanel x:Name="ScrollArrowOverlay"
                            Width="26"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Panel.ZIndex="3"
                            Visibility="Collapsed">
                <Button PreviewMouseLeftButtonDown="OnScrollArrowMouseDown"
                        PreviewMouseLeftButtonUp="OnScrollArrowMouseUp"
                        Tag="-1"
                        Style="{StaticResource ScrollArrowButtonStyle}"
                        ToolTip="{x:Static res:Strings.ScrollNotesUpTooltip}">
                    <TextBlock Text="↑" FontSize="13" FontWeight="SemiBold" />
                </Button>
                <Button PreviewMouseLeftButtonDown="OnScrollArrowMouseDown"
                        PreviewMouseLeftButtonUp="OnScrollArrowMouseUp"
                        Tag="1"
                        Style="{StaticResource ScrollArrowButtonStyle}"
                        ToolTip="{x:Static res:Strings.ScrollNotesDownTooltip}">
                    <TextBlock Text="↓" FontSize="13" FontWeight="SemiBold" />
                </Button>
                </StackPanel>
            </Grid>

            <!-- Alineado a la derecha igual que las pestañas, con un respiro de 8px para que el
                 panel no quede pegado al canto de la pantalla y su sombra tenga dónde caer. Antes
                 el Grid raíz llevaba margen también a la derecha, así que este footer se paraba
                 18px antes que las pestañas y se veía desplazado a la izquierda respecto a ellas.

                 El Border oscuro es el mismo tratamiento que ya lleva RestStrip (mismo Background,
                 misma idea de "objeto con borde propio contra cualquier fondo de escritorio") —
                 sin él, con cero notas el footer eran dos círculos sueltos flotando sobre el
                 escritorio, sin nada que los agrupe como "esto es el dock". CornerRadius a pastilla
                 (mitad del alto real: 7 relleno + 40 del botón mayor + 7 relleno = 54, radio 27). -->
            <!-- HorizontalAlignment/Margin de este Border y de RestStrip/las pestañas de arriba se
                 fijan también por código en el constructor de EdgeDockWindow (ApplyEdgeAlignment):
                 lo escrito aquí es el valor para el dock a la derecha, y se espeja a la izquierda en
                 caliente si _edge es EdgePosition.Left. Bug real corregido (usuario, 2026-09-09):
                 con el dock a la izquierda, la ventana ya se posicionaba bien pegada al borde físico
                 de la pantalla, pero este contenido seguía alineado "a la derecha" sin más — es
                 decir, contra el lado INTERIOR del dock en vez del exterior, dejando un hueco entre
                 la tira/pestañas y el borde real de la pantalla. -->
            <Border x:Name="FooterBorder" Grid.Row="1" Background="#2A261F" CornerRadius="27"
                    HorizontalAlignment="Right" Margin="0,14,8,0" Padding="7">
                <StackPanel x:Name="FooterPanel" Orientation="Horizontal">
                    <!-- "Ver todas": interruptor, no solo abrir. Si hay alguna nota abierta ahora
                         mismo las cierra todas; si no hay ninguna, las abre todas de golpe (como
                         una mesa de post-its) — pedido explícito del usuario para no tener que
                         abrirlas ni cerrarlas de una en una. Ver AppCoordinator.ToggleAllNotes. -->
                    <Button x:Name="OpenAllButton" Click="OnOpenAllClick"
                            PreviewMouseRightButtonUp="OnOpenAllRightClick"
                            Style="{StaticResource CircularIconButtonStyle}"
                            ToolTip="{x:Static res:Strings.OpenAllNotesTooltip}">
                        <TextBlock Text="&#xE8A9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                    <Button x:Name="ManageArchiveButton" Click="OnManageArchiveClick"
                            PreviewMouseRightButtonUp="OnManageArchiveRightClick"
                            Style="{StaticResource CircularIconButtonStyle}"
                            ToolTip="{x:Static res:Strings.ManageNotesTooltip}">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                    <Button x:Name="SyncButton" Click="OnSyncClick"
                            PreviewMouseRightButtonUp="OnSyncRightClick"
                            Style="{StaticResource CircularIconButtonStyle}"
                            ToolTip="{x:Static res:Strings.SyncNowButton}">
                        <TextBlock Text="↻" FontSize="17" />
                    </Button>
                    <!-- Crear nota es la acción principal del dock, así que pesa más que el
                         engranaje: más grande y más clara. Ir las dos iguales las dejaba a la par
                         cuando no lo están. -->
                    <Button x:Name="NewNoteButton" Click="OnNewNoteClick"
                            Width="40" Height="40"
                            Background="#575044" Foreground="#F5F0E6"
                            Style="{StaticResource CircularIconButtonStyle}"
                            ToolTip="{x:Static res:Strings.NewNoteTooltip}">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Popup propio en vez de ContextMenu: el ContextMenu de WPF conserva una capa de
                 foco del tema del sistema aunque se reemplace su plantilla, y esa capa aparecía
                 como el rectángulo azul alrededor del menú. -->
            <Popup x:Name="OpenAllMenuPopup"
                   AllowsTransparency="True"
                   Focusable="False"
                   StaysOpen="False"
                   PopupAnimation="Fade"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=OpenAllButton}"
                   Opened="OnOpenAllMenuOpened"
                   Closed="OnOpenAllMenuClosed">
                <Border Background="#2A261F" CornerRadius="10" Padding="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270"
                                          Color="#000000" Opacity="0.5" />
                    </Border.Effect>
                    <StackPanel MinWidth="190">
                        <TextBlock Text="{x:Static res:Strings.OpenAllModeTitle}"
                                   Foreground="#C8B9A8" FontSize="11"
                                   FontWeight="SemiBold" Margin="8,3,8,6" />
                        <Button Content="{x:Static res:Strings.OpenAllNormal}"
                                Click="OnOpenAllNormalClick"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Button Content="{x:Static res:Strings.OpenAllGrid}"
                                Click="OnOpenAllGridClick"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Button Content="{x:Static res:Strings.OpenAllColumns}"
                                Click="OnOpenAllColumnsClick"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <!-- Pantalla de destino: solo se ve cuando hay mas de una pantalla y alguna sin
                             dock (con un dock en cada monitor la elige el propio dock que se pulsa).
                             Los botones los construye PopulateOpenAllMonitors. -->
                        <Border x:Name="OpenAllMonitorSeparator"
                                Background="#4A443B" Height="1" Margin="0,6,0,6"
                                Visibility="Collapsed" />
                        <TextBlock x:Name="OpenAllMonitorTitle"
                                   Text="{x:Static res:Strings.OpenAllMonitorTitle}"
                                   Foreground="#C8B9A8" FontSize="11"
                                   FontWeight="SemiBold" Margin="8,3,8,6"
                                   Visibility="Collapsed" />
                        <StackPanel x:Name="OpenAllMonitorContainer" Visibility="Collapsed" />
                        <Border Background="#4A443B" Height="1" Margin="0,6,0,6" />
                        <Button Content="{x:Static res:Strings.RestoreOriginalPositions}"
                                Click="OnRestoreOriginalPositionsClick"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Button Content="{x:Static res:Strings.CloseAllNotes}"
                                Click="OnCloseAllClick"
                                Style="{StaticResource NoteMenuDangerStyle}" />
                    </StackPanel>
                </Border>
            </Popup>

            <Popup x:Name="DockViewPopup"
                   AllowsTransparency="True" Focusable="False" StaysOpen="False"
                   PopupAnimation="Fade" PlacementTarget="{Binding ElementName=DockViewButton}"
                   Opened="OnDockViewPopupOpened" Closed="OnDockViewPopupClosed">
                <Border Background="#2A261F" CornerRadius="10" Padding="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270"
                                          Color="#000000" Opacity="0.5" />
                    </Border.Effect>
                    <StackPanel MinWidth="190">
                        <TextBlock Text="{x:Static res:Strings.DockViewTitle}"
                                   Foreground="#C8B9A8" FontSize="11" FontWeight="SemiBold"
                                   Margin="8,3,8,6" />
                        <Button Content="{x:Static res:Strings.DockViewActive}" Tag="Active"
                                Click="OnDockViewChoiceClick" Style="{StaticResource NoteMenuItemStyle}" />
                        <Button Content="{x:Static res:Strings.DockViewArchived}" Tag="Archived"
                                Click="OnDockViewChoiceClick" Style="{StaticResource NoteMenuItemStyle}" />
                        <Button Content="{x:Static res:Strings.DockViewTrash}" Tag="Trashed"
                                Click="OnDockViewChoiceClick" Style="{StaticResource NoteMenuDangerStyle}" />
                        <Border Background="#4A443B" Height="1" Margin="0,6,0,6" />
                        <TextBlock Text="{x:Static res:Strings.DockViewTags}"
                                   Foreground="#C8B9A8" FontSize="11" Margin="8,0,8,4" />
                        <StackPanel x:Name="DockTagItems" />
                        <TextBlock x:Name="DockNoTagsText" Text="{x:Static res:Strings.DockViewNoTags}"
                                   Foreground="#81786C" FontSize="11" Margin="8,4,8,2"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Popup>

        </Grid>

        <!-- Clic derecho en una pestaña: cambiar color, archivar o tirar a la papelera sin abrir la
             nota. Antes cambiar el color obligaba a abrirla, leerla y cerrarla. Placement="MousePoint"
             lo saca donde se pulsó; mientras está abierto, PollHoverState no colapsa el abanico (si
             no, mover el ratón hacia el menú lo cerraría bajo los pies). -->
         <Popup x:Name="TabMenuPopup" StaysOpen="False" AllowsTransparency="True"
                PopupAnimation="Fade" Placement="MousePoint" HorizontalOffset="6" VerticalOffset="6">
            <Border x:Name="TabMenuSurface"
                    Background="#2A261F" CornerRadius="10" Padding="8"
                    MouseEnter="OnTabMenuMouseEnter"
                    MouseLeave="OnTabMenuMouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270"
                                      Color="#000000" Opacity="0.5" />
                </Border.Effect>
                <StackPanel MinWidth="186">
                    <StackPanel x:Name="TabMenuSwatches" Orientation="Horizontal" Margin="6,4,6,8" />
                    <Button Content="{x:Static res:Strings.CustomColor}" Click="OnTabMenuCustomColorClick"
                            Style="{StaticResource NoteMenuItemStyle}" />
                    <Border Background="#3C3730" Height="1" Margin="0,0,0,4" />
                    <Button Content="{x:Static res:Strings.OpenNote}" Click="OnTabMenuOpenClick"
                            Style="{StaticResource NoteMenuItemStyle}" />
                    <Button x:Name="TabMenuProtectionButton" Content="{x:Static res:Strings.ProtectNote}"
                            Click="OnTabMenuProtectionClick" Style="{StaticResource NoteMenuItemStyle}" />
                    <Button x:Name="TabMenuArchiveButton" Content="{x:Static res:Strings.Archive}"
                            Click="OnTabMenuArchiveClick"
                            Style="{StaticResource NoteMenuItemStyle}" />
                    <Button Content="{x:Static res:Strings.NoteTags}" Click="OnTabMenuTagsClick"
                            Style="{StaticResource NoteMenuItemStyle}" />
                    <Button x:Name="TabMenuTrashButton" Content="{x:Static res:Strings.MoveToTrash}"
                            Click="OnTabMenuTrashClick"
                            Style="{StaticResource NoteMenuDangerStyle}" />
                </StackPanel>
            </Border>
        </Popup>

         <Popup x:Name="TagEditorPopup" AllowsTransparency="True" Focusable="True"
             StaysOpen="False" PopupAnimation="Fade" Placement="MousePoint">
            <Border Background="#2A261F" CornerRadius="10" Padding="12">
                <StackPanel Width="230">
                    <TextBlock Text="{x:Static res:Strings.NoteTags}" Foreground="#F5F0E6"
                               FontSize="12" FontWeight="SemiBold" Margin="2,0,2,7" />
                    <TextBlock Text="{x:Static res:Strings.NoteTagsHint}" Foreground="#A99D8D"
                               FontSize="11" TextWrapping="Wrap" Margin="2,0,2,7" />
                    <TextBlock x:Name="DockTagAssignmentEmptyText" Text="{x:Static res:Strings.DockViewNoTags}"
                               Foreground="#A99D8D" FontSize="11" Visibility="Collapsed" />
                    <StackPanel x:Name="DockTagAssignmentItems" />
                    <Button Content="{x:Static res:Strings.SaveTags}" Click="OnSaveTagsClick"
                            Style="{StaticResource NoteMenuItemStyle}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
