<Window x:Class="Aldune.Windowing.ConfigImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Aldune.Resources"
        Title="{x:Static res:Strings.ConfigImportTitle}"
        Width="520" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AlduneGroundBrush}"
        PreviewKeyDown="OnWindowKeyDown"
        SourceInitialized="OnSourceInitialized">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource AlduneBorderSubtleBrush}" BorderThickness="1" Padding="20,18,20,16">
        <StackPanel>
            <TextBlock Text="{x:Static res:Strings.ConfigImportTitle}"
                       Foreground="{DynamicResource AlduneTextStrongBrush}" FontSize="{StaticResource AlduneTextTitle}" FontWeight="SemiBold" />
            <TextBlock x:Name="FromVersionText"
                       Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" Margin="0,4,0,0" />
            <TextBlock x:Name="SummaryText"
                       Foreground="{DynamicResource AlduneTextSoftBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap"
                       LineHeight="18" Margin="0,12,0,0" />

            <!-- Una fila por cambio, con tope de alto: un archivo con todos los ajustes cambiados no
                 puede hacer la ventana más alta que la pantalla. -->
            <ScrollViewer x:Name="ChangesScroller" MaxHeight="300" Margin="0,10,0,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ChangesPanel" Margin="0,0,10,0" />
            </ScrollViewer>

            <TextBlock x:Name="RestartText" Text="{x:Static res:Strings.ConfigImportRestartForLanguage}"
                       Foreground="{DynamicResource AlduneAttentionBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap"
                       Margin="0,12,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="BackupText" Text="{x:Static res:Strings.ConfigImportBackupNote}"
                       Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap"
                       Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="{x:Static res:Strings.DialogCancel}"
                        Style="{StaticResource ColorDialogButtonStyle}" MinWidth="84" Click="OnCancelClick" />
                <Button x:Name="ApplyButton" Content="{x:Static res:Strings.ConfigImportApply}"
                        Margin="8,0,0,0" MinWidth="84" Style="{StaticResource PrimaryColorDialogButtonStyle}"
                        Click="OnApplyClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
