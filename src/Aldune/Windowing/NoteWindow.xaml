<Window x:Class="Aldune.Windowing.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Aldune.Resources"
        xmlns:local="clr-namespace:Aldune.Windowing"
        Title="{x:Static res:Strings.AppName}"
        Width="300" Height="320"
        MinWidth="220" MinHeight="180"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        StateChanged="OnWindowStateChanged"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="False" SnapsToDevicePixels="False"
        Topmost="True">
    <WindowChrome.WindowChrome>
        <!-- No visible title bar: the top CaptionHeight strip is just the note's own tinted
             background, draggable like a real sticky note, with only the close button opted
             back into being clickable (see CloseButton below). GlassFrameThickness="-1" is the
             standard WindowChrome shorthand for the native drop shadow on a borderless window;
             rounded corners come separately from NativeMethods.ApplyRoundedCorners. -->
        <!-- CaptionHeight = el alto entero de la cabecera (40), no 22: desde que la cabecera lleva el
             cuadro del título, ese cuadro se come los clics de la mitad de la franja de arrastre. Con
             la franja completa se arrastra por el hueco que queda alrededor del título, y el título y
             los botones quedan fuera vía IsHitTestVisibleInChrome — igual que la barra de pestañas de
             un navegador: arrastras por el hueco, no por la pestaña. -->
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="NoteInkBrush" Color="#1E1A14" />
        <!-- Tinta de la cabecera: la de la nota con la barra plana; ApplyColor la cambia con barra en
             degradado o título con tinte de canal. -->
        <SolidColorBrush x:Key="NoteHeaderInkBrush" Color="#1E1A14" />
        <SolidColorBrush x:Key="NotePlaceholderBrush" Color="#1E1A14" />
        <SolidColorBrush x:Key="NoteHoverBrush" Color="#40000000" />
        <SolidColorBrush x:Key="NoteTaskHoverBrush" Color="#26000000" />
        <Style x:Key="NoteActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#26000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AlduneRadius4}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NoteHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Same shape/behavior as NoteActionButtonStyle, but tinted red — Papelera is
             destructive, so it gets a visually distinct "danger" cue at a glance. A separate
             template (rather than BasedOn) because the hover color needs to shift red too, not
             just the resting color that TemplateBinding would pick up. -->
        <Style x:Key="NoteDangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#66B02F2F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AlduneRadius4}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#8CB02F2F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource NoteActionButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource NoteHeaderInkBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="NoteTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <!-- NoteMenuItemStyle y NoteMenuDangerStyle (las filas del panel de acciones) viven en
             App.xaml: el mismo panel se usa aquí y en el menú contextual de la pestaña del dock. -->
        <Style x:Key="PlaceholderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NotePlaceholderBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=TextBody}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Suelto, NO con BasedOn sobre PlaceholderStyle: heredar un estilo hereda también sus
             disparadores, así que este marcador se hacía visible cuando el CUERPO estaba vacío —
             y entonces "Título" se quedaba pintado por detrás del título que acabas de escribir,
             que es exactamente lo que se veía. -->
        <Style x:Key="TitlePlaceholderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NoteHeaderInkBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=TitleBox}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=TitleBox}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <!-- Mismo borde de 1px del hue de la nota que llevan las pestañas del dock (ver
         NoteColorPalette.RimFor). Es lo único que puede separar la nota del escritorio: la spec v1
         descarta AllowsTransparency para no romper ClearType, así que no hay sombra posible dentro
         de la ventana. BorderBrush se fija por código en ApplyColor, que ya sabe el color. -->
    <Border x:Name="WindowRim" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <!-- La cabecera es la pestaña que estaba en el mazo, que ha viajado con la nota al
                 abrirla — por eso el dock oculta la suya mientras esta ventana existe (ver
                 AppCoordinator.IsNoteOpen). Su alto es el de la pestaña. -->
            <RowDefinition Height="40" />
            <!-- La línea de prompt de la piel bash: Auto, así que sin ella (Collapsed) no ocupa nada. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- La cabecera **es** la primera línea de la nota, editable aquí en vez de repetida abajo.
             No es un campo aparte: al guardar se vuelve a unir con el cuerpo en un único texto (ver
             Aldune.Core.NoteText), que es lo que se cifra de una pieza. Un título guardado por
             separado tendría que cifrarse por su cuenta o quedarse en claro, filtrando justo lo más
             descriptivo de cada nota.

             IsHitTestVisibleInChrome en el cuadro de texto es imprescindible: WindowChrome trata los
             primeros 22px como zona de arrastre, así que sin eso no se podría ni hacer clic para
             escribir el título. -->
        <Grid x:Name="Header" Grid.Row="0" Background="{DynamicResource AlduneTitleBarFill}">
            <!-- WindowChrome.IsHitTestVisibleInChrome="True" a propósito, aunque el resto de la
                 cabecera se arrastra sin él (como zona de "caption" implícita): una zona de
                 "caption" nunca recibe los eventos normales de ratón de WPF (MouseEnter, Cursor…),
                 así que sin esto no había forma de que el cursor cambiara aquí para indicar que se
                 puede arrastrar. Al ser un elemento normal, el arrastre se dispara a mano con
                 DragMove() en OnGripMouseDown en vez de depender de WindowChrome. -->
            <TextBlock x:Name="DragHandle"
                       Text="&#xE76F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="13" Foreground="{DynamicResource NoteHeaderInkBrush}"
                       Background="Transparent"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="12,0,0,0" Padding="4"
                       Cursor="SizeAll"
                       WindowChrome.IsHitTestVisibleInChrome="True"
                       PreviewMouseLeftButtonDown="OnGripMouseDown" />

            <DockPanel Margin="32,0,126,0" VerticalAlignment="Center">
                <!-- Prefijo de canal de la piel de osciloscopio (CH1…): solo se pinta, el título no cambia. -->
                <TextBlock x:Name="ChannelPrefix" DockPanel.Dock="Left" Margin="4,0,6,0" VerticalAlignment="Center"
                           FontFamily="{DynamicResource AlduneNoteTitleFont}" FontSize="{DynamicResource AlduneNoteTitleFontSize}"
                           FontWeight="Bold" Visibility="Collapsed" />
                <Grid>
                    <!-- Manuscrita solo aquí, y a propósito. El cuerpo se queda en la fuente de sistema
                         porque una manuscrita ahí cuesta legibilidad, hace caber menos líneas, y sobre
                         todo **no tiene los glifos de las casillas** (☐/☒): Windows los sacaría de otra
                         fuente y volverían a verse desalineados, que es justo lo que se arregló eligiendo
                         ☒ por sus métricas. El título es una línea y no lleva casillas, así que aquí la
                         personalidad sale gratis.

                         Ink Free viene con Windows 10 1809+; el respaldo cubre instalaciones sin ella.
                         Va sin negrita y a 17px porque dibuja más pequeño que una sans al mismo tamaño. -->
                    <!-- La fuente y el tamaño salen de la piel (AppSkin): estos son los de la piel de siempre.
                         Margin izquierdo de 4px: Ink Free dibuja la "T" con un solape hacia la izquierda de
                         su origen nominal (vuelo caligráfico), así que el caret parpadeante de TitleBox —
                         que sí se posiciona justo en ese origen — la atravesaba en vez de quedar limpio a
                         su izquierda. Verificado con un render aislado antes de fijar el número: 4px basta
                         para separarlos sin dejar un hueco que se note. -->
                    <TextBlock Text="{x:Static res:Strings.TitlePlaceholder}" FontFamily="{DynamicResource AlduneNoteTitleFont}" FontSize="{DynamicResource AlduneNoteTitleFontSize}"
                               Style="{StaticResource TitlePlaceholderStyle}"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="TitleBox"
                             Style="{StaticResource NoteTextBoxStyle}"
                             FontFamily="{DynamicResource AlduneNoteTitleFont}"
                             FontSize="{DynamicResource AlduneNoteTitleFontSize}"
                             Foreground="#1E1A14"
                             CaretBrush="#1E1A14"
                             Background="Transparent"
                             SelectionBrush="#40000000"
                             SelectionOpacity="1"
                             BorderThickness="0"
                             Padding="0"
                             AcceptsReturn="False"
                             MaxLines="1"
                             VerticalAlignment="Center"
                             WindowChrome.IsHitTestVisibleInChrome="True" />
                </Grid>
            </DockPanel>

            <!-- En la cabecera, no en el cuerpo. Estaba dentro de la fila de abajo, así que
                 flotaba bajo la línea de troquelado en vez de alinearse con el título.

                 El "⋯" abre el panel de acciones (color, fijar, archivar, papelera). Antes esas
                 acciones vivían siempre visibles al pie de la nota y se comían ~90px de una ventana
                 de 320: casi un tercio del alto ocupado de forma permanente por cosas que se usan
                 una vez cada mucho, restándoselo al texto, que es lo único que importa aquí. -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0">
                <!-- La raya se dibuja, no se escribe: como texto (un guion largo) su altura dependía de la fuente
                     del aspecto y en las monoespaciadas quedaba arriba. Asentada por debajo del centro, como la
                     de una ventana de Windows. -->
                <Button x:Name="MinimizeButton"
                        Width="26" Height="26"
                        ToolTip="{x:Static res:Strings.MinimizeWindowTooltip}"
                        AutomationProperties.Name="{x:Static res:Strings.MinimizeWindowTooltip}"
                        Click="OnMinimizeClick"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource CloseButtonStyle}">
                    <Border Width="10" Height="1" VerticalAlignment="Center" Margin="0,8,0,0"
                                UseLayoutRounding="True" SnapsToDevicePixels="True"
                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button x:Name="MaximizeButton"
                        Width="26" Height="26"
                        ToolTip="{x:Static res:Strings.MaximizeWindowTooltip}"
                        AutomationProperties.Name="{x:Static res:Strings.MaximizeWindowTooltip}"
                        Click="OnMaximizeClick"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource CloseButtonStyle}">
                    <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" />
                </Button>
                <Button x:Name="MenuButton"
                        Content="&#x22EF;"
                        Width="26" Height="26"
                        FontSize="14"
                        Click="OnMenuClick"
                        ToolTip="{x:Static res:Strings.MoreActionsTooltip}"
                        AutomationProperties.Name="{x:Static res:Strings.MoreActionsTooltip}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource CloseButtonStyle}" />
                <Button x:Name="CloseButton"
                        Content="&#x2715;"
                        Width="26" Height="26"
                        Click="OnCloseClick"
                        ToolTip="{x:Static res:Strings.CloseTooltip}"
                        AutomationProperties.Name="{x:Static res:Strings.CloseTooltip}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource CloseButtonStyle}" />
            </StackPanel>

            <Popup x:Name="ActionsPopup"
                   PlacementTarget="{Binding ElementName=MenuButton}"
                   Placement="Bottom"
                   HorizontalOffset="-160"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <!-- Dos capas en vez de un Border con Effect: el Effect rasteriza el subárbol entero
                     (texto incluido) a un bitmap de resolución fija, borroso en monitores con escala
                     >100%. La capa de sombra no lleva contenido; la de contenido va sin Effect. -->
                <Grid Margin="10">
                    <Border Background="{DynamicResource AlduneGroundBrush}" CornerRadius="{DynamicResource AlduneRadius10}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270"
                                              Color="#000000" Opacity="0.5" />
                        </Border.Effect>
                    </Border>
                    <Border Background="{DynamicResource AlduneGroundBrush}" CornerRadius="{DynamicResource AlduneRadius10}" Padding="8">
                    <StackPanel MinWidth="230" Grid.IsSharedSizeScope="True">
                        <!-- Agrupado por intención, no por orden de implementación: arriba lo que se usa
                             escribiendo (tarea y viñeta, con su atajo a la vista — es la única forma de
                             descubrir que Ctrl+L existe sin ir a Ajustes), luego el recordatorio, luego
                             la nota (color, fijar, proteger, etiquetas) y al final, separado, lo que
                             guarda fuera o destruye. Cuatro bloques, no once opciones seguidas. -->
                        <Button x:Name="TaskButton" Click="OnTaskClick"
                                Style="{StaticResource NoteMenuItemStyle}">
                            <!-- Dos columnas que se miden con el texto (y compartidas entre las dos filas para que
                                 los atajos queden alineados): con un ancho fijo, la fuente monoespaciada de la
                                 piel bash hacía que etiqueta y atajo se pisaran. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuLabel" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuHint" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static res:Strings.ConvertToTask}" />
                                <TextBlock Grid.Column="1" Margin="24,0,0,0" Text="Ctrl+L" Foreground="{DynamicResource AlduneHintBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>

                        <Button x:Name="BulletButton" Click="OnBulletClick"
                                Style="{StaticResource NoteMenuItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuLabel" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuHint" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static res:Strings.ConvertToBullet}" />
                                <TextBlock Grid.Column="1" Margin="24,0,0,0" Text="Ctrl+Shift+L" Foreground="{DynamicResource AlduneHintBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>
                        <!-- Solo con alguna tarea hecha (se decide al abrir el menú). Pensadas para una
                             lista que se reutiliza, como la de la compra. -->
                        <Button x:Name="UncheckAllButton" Click="OnUncheckAllClick"
                                Content="{x:Static res:Strings.UncheckAllTasks}"
                                Visibility="Collapsed"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Button x:Name="RemoveCheckedButton" Click="OnRemoveCheckedClick"
                                Content="{x:Static res:Strings.RemoveCheckedTasks}"
                                Visibility="Collapsed"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Border Background="{DynamicResource AlduneRaisedBrush}" Height="1" Margin="0,0,0,4" />

                        <Button x:Name="ReminderButton" Click="OnReminderMenuClick"
                                Style="{StaticResource NoteMenuItemStyle}" />

                        <!-- Colapsado hasta que se pulsa ReminderButton. Mismo panel sirve para
                             poner un recordatorio nuevo y para "posponer": al abrir la nota desde
                             el aviso, el recordatorio que sonó ya se limpió solo, así que este
                             mismo flujo sin más UI aparte pone uno nuevo. -->
                        <StackPanel x:Name="ReminderPanel" Visibility="Collapsed" Margin="9,0,9,8">
                            <Button x:Name="ReminderInOneHourButton" Click="OnReminderPresetClick"
                                    Content="{x:Static res:Strings.ReminderInOneHour}"
                                    Style="{StaticResource NoteMenuItemStyle}" />
                            <Button x:Name="ReminderTonightButton" Click="OnReminderPresetClick"
                                    Content="{x:Static res:Strings.ReminderTonight}"
                                    Style="{StaticResource NoteMenuItemStyle}" />
                            <Button x:Name="ReminderTomorrowButton" Click="OnReminderPresetClick"
                                    Content="{x:Static res:Strings.ReminderTomorrowMorning}"
                                    Style="{StaticResource NoteMenuItemStyle}" />

                            <Calendar x:Name="ReminderCalendar" Margin="0,6,0,4" HorizontalAlignment="Center"
                                      Style="{StaticResource DarkCalendarStyle}" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <TextBox x:Name="ReminderHourBox" Width="34" Text="09" TextAlignment="Center" />
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource AlduneTextBrush}" />
                                <TextBox x:Name="ReminderMinuteBox" Width="34" Text="00" TextAlignment="Center" />
                            </StackPanel>

                            <Button x:Name="ReminderSaveButton" Click="OnReminderSaveClick"
                                    Content="{x:Static res:Strings.ReminderSave}"
                                    Style="{StaticResource NoteMenuItemStyle}" />
                            <Button x:Name="ReminderClearButton" Click="OnReminderClearClick"
                                    Content="{x:Static res:Strings.ReminderClear}"
                                    Visibility="Collapsed"
                                    Style="{StaticResource NoteMenuDangerStyle}" />
                        </StackPanel>
                        <Border Background="{DynamicResource AlduneRaisedBrush}" Height="1" Margin="0,0,0,4" />

                        <!-- Color y estado de la nota: el bloque entero vive en este tercer grupo.
                             PinHint explica en una línea qué es "fijar" — "siempre encima" a secas
                             no dice nada a quien no conoce el concepto. -->
                        <StackPanel x:Name="ColorSwatches" Margin="6,4,6,8" />
                        <!-- Aviso cuando la piel activa no va a enseñar el color elegido tal cual (franja gris, sin
                             colores, color del canal). Se decide al abrir el menú. -->
                        <TextBlock x:Name="ColorNotice" Visibility="Collapsed"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="11" TextWrapping="Wrap"
                                   MaxWidth="230" Margin="9,0,9,8" />
                        <Button x:Name="CustomColorButton" Click="OnCustomColorClick"
                                Content="{x:Static res:Strings.CustomColor}"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Button x:Name="PinButton" Click="OnPinClick"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <TextBlock x:Name="PinHint"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="11" TextWrapping="Wrap"
                                   Margin="9,0,9,6" />
                        <Button x:Name="ProtectionButton" Click="OnProtectionClick" ToolTipService.ShowOnDisabled="True"
                                Content="{x:Static res:Strings.ProtectNote}"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Button x:Name="TagsButton" Click="OnTagsClick"
                                Content="{x:Static res:Strings.NoteTags}"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Border Background="{DynamicResource AlduneRaisedBrush}" Height="1" Margin="0,4,0,4" />

                        <!-- Solo en una nota vinculada a un archivo (las cuatro primeras) o en una normal sin
                             proteger (la última); NoteWindow.OnMenuClick decide cuáles se ven. -->
                        <Button x:Name="LinkedSyncButton" Click="OnLinkedSyncClick" Visibility="Collapsed"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Button x:Name="OpenInEditorButton" Click="OnOpenInEditorClick" Visibility="Collapsed"
                                Content="{x:Static res:Strings.LinkedOpenInEditor}"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Button x:Name="ShowInExplorerButton" Click="OnShowInExplorerClick" Visibility="Collapsed"
                                Content="{x:Static res:Strings.LinkedShowInExplorer}"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Button x:Name="ConvertToNormalButton" Click="OnConvertToNormalClick" Visibility="Collapsed"
                                Content="{x:Static res:Strings.LinkedConvert}"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Button x:Name="SaveAsLinkedButton" Click="OnSaveAsLinkedClick" Visibility="Collapsed"
                                Content="{x:Static res:Strings.LinkedSaveAs}"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Border x:Name="LinkedSeparator" Background="{DynamicResource AlduneRaisedBrush}" Height="1"
                                Margin="0,4,0,4" Visibility="Collapsed" />

                        <Button x:Name="ExportButton" Click="OnExportClick"
                                Content="{x:Static res:Strings.ExportToMarkdown}"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Button x:Name="ReturnToDockButton" Click="OnReturnToDockClick"
                                Content="{x:Static res:Strings.ReturnToDock}"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Button x:Name="RestoreSizeButton" Click="OnRestoreSizeClick"
                                Content="{x:Static res:Strings.RestoreSize}"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Border Background="{DynamicResource AlduneRaisedBrush}" Height="1" Margin="0,4,0,4" />

                        <Button x:Name="ArchiveButton" Click="OnArchiveClick"
                                Content="{x:Static res:Strings.Archive}"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Button x:Name="RestoreButton" Click="OnRestoreClick"
                                Content="{x:Static res:Strings.Restore}"
                                Visibility="Collapsed"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Button x:Name="TrashButton" Click="OnTrashClick"
                                Content="{x:Static res:Strings.MoveToTrash}"
                                Style="{StaticResource NoteMenuDangerStyle}" />
                    </StackPanel>
                    </Border>
                </Grid>
            </Popup>

                 <Popup x:Name="TagsPopup" PlacementTarget="{Binding ElementName=MenuButton}" Closed="OnTagsPopupClosed"
                     Placement="Bottom" HorizontalOffset="-160" Focusable="True" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource AlduneGroundBrush}" CornerRadius="{DynamicResource AlduneRadius10}" Padding="16,14">
                    <local:TagAssignmentPanel x:Name="NoteTagPanel" />
                </Border>
            </Popup>

            <!-- El troquelado, en el mismo sitio que en la pestaña del dock: el pliegue por donde
                 la cabecera se une al cuerpo. Stroke se fija en ApplyColor. -->
            <Path x:Name="Perforation"
                  StrokeThickness="1"
                  StrokeDashArray="3 3"
                  Stretch="Fill"
                  Height="1"
                  Opacity="0.6"
                  VerticalAlignment="Bottom"
                  Margin="14,0,14,0"
                  SnapsToDevicePixels="True">
                <Path.Data>
                    <LineGeometry StartPoint="0,0" EndPoint="1,0" />
                </Path.Data>
            </Path>
        </Grid>

        <!-- Prompt de la piel bash, en dos lineas: usuario@aldune:~/notas$ siempre entero, y debajo
             "cat <titulo>" que se parte hasta en 3 lineas (un titulo largo en una sola se perdia con la
             elipsis). Fila propia y no dentro del cuadro de texto: no es texto de la nota y no se puede
             editar ni seleccionar con el. LineHeight fijo para que MaxHeight sean exactamente 3 lineas. -->
        <StackPanel Grid.Row="1">
            <!-- Archivo vinculado no disponible (Z: desconectado, borrado…): la nota pasa a solo lectura y
                 ofrece reintentar, buscar el archivo o quedarse como nota normal (spec, decisión 5). -->
            <Border x:Name="UnavailableBar" Visibility="Collapsed" Padding="10,6" Margin="14,10,20,0"
                    Background="{DynamicResource AlduneDangerBgBrush}" CornerRadius="{DynamicResource AlduneRadius4}">
                <StackPanel>
                    <TextBlock x:Name="UnavailableText" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource AlduneOnDangerBrush}" />
                    <WrapPanel Margin="0,6,0,0">
                        <Button x:Name="UnavailableRetryButton" Click="OnUnavailableRetryClick" Margin="0,0,6,0"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Button x:Name="UnavailableLocateButton" Click="OnUnavailableLocateClick" Margin="0,0,6,0"
                                Style="{StaticResource NoteMenuItemStyle}" />
                        <Button x:Name="UnavailableConvertButton" Click="OnUnavailableConvertClick"
                                Style="{StaticResource NoteMenuItemStyle}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        <StackPanel x:Name="PromptPanel" Margin="20,10,20,0" Visibility="Collapsed">
            <TextBlock x:Name="PromptLine" FontSize="14" LineHeight="20"
                       FontFamily="{DynamicResource AlduneNoteFont}" TextTrimming="CharacterEllipsis">
                <Run x:Name="PromptUser" FontWeight="Bold" /><Run Text=":" /><Run x:Name="PromptPath" FontWeight="Bold" /><Run Text="$" />
            </TextBlock>
            <TextBlock x:Name="PromptCommandLine" FontSize="14" LineHeight="20" MaxHeight="60"
                       FontFamily="{DynamicResource AlduneNoteFont}" TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
        </StackPanel>
        </StackPanel>

        <!-- Solo texto. Todo lo demás (color, fijar, archivar, papelera) vive en el panel del "⋯"
             de la cabecera: una nota de 300x320 no puede permitirse un tercio de su alto en botones
             permanentes. -->

        <!-- El margen izquierdo es Padding del TextBox y no Margin de este Grid: así el hueco a la
             izquierda de una casilla de tarea es parte del cuadro de texto, y un clic ahí pone el
             cursor delante de la casilla. Como Margin quedaba fuera del TextBox y no hacía nada. -->
        <Grid x:Name="BodyHost" Grid.Row="2" Margin="0,14,20,20">
            <TextBlock Text="{x:Static res:Strings.BodyPlaceholder}" FontFamily="{DynamicResource AlduneNoteFont}" FontSize="14" Margin="20,0,0,0"
                       Style="{StaticResource PlaceholderStyle}" TextWrapping="Wrap" />
            <!-- Tinta tintada hacia el cálido, nunca #000 puro: sobre un pastel, el negro
                 absoluto es el único color de la ventana que no comparte hue con nada. -->
            <TextBox x:Name="TextBody"
                     Style="{StaticResource NoteTextBoxStyle}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     FontFamily="{DynamicResource AlduneNoteFont}"
                     FontSize="14"
                     TextBlock.LineHeight="{DynamicResource AlduneNoteLineHeight}"
                     TextBlock.LineStackingStrategy="BlockLineHeight"
                     Foreground="#1E1A14"
                     CaretBrush="#1E1A14"
                     SelectionBrush="#40000000"
                     SelectionOpacity="1"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Padding="20,0,0,0"
                     BorderThickness="0">
                <!-- Aire entre el texto y la barra de scroll. El Padding del TextBox no sirve para
                     esto: la barra vive DENTRO del ScrollViewer interno (PART_ContentHost), así que
                     el padding desplaza texto y barra juntos y no separa nada. Un estilo implícito
                     de ScrollBar en los recursos del propio TextBox sí alcanza a esa barra interna
                     (mismo patrón que se usa para los ComboBoxItem de un ComboBox), y el margen
                     izquierdo ensancha su columna del Grid del ScrollViewer: el texto acaba 8px
                     antes de donde empieza la barra. -->
                <TextBox.Resources>
                    <!-- La barra toma la tinta de la propia nota (NoteInkBrush cambia con el color, sea
                         pastel o oscuro), así que siempre contrasta con SU fondo en vez de ser un marrón
                         fijo. Pista transparente y pulgar fino que se ensancha al acercar el ratón: en
                         reposo casi no compite con el texto. -->
                    <Style TargetType="ScrollBar">
                        <Setter Property="Margin" Value="8,0,0,0" />
                        <Setter Property="Width" Value="10" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="Bar"
                                                                    Background="{DynamicResource NoteInkBrush}"
                                                                    Opacity="0.28"
                                                                    CornerRadius="{DynamicResource AlduneRadius3}"
                                                                    Margin="2,2" />
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bar" Property="Opacity" Value="0.5" />
                                                                    <Setter TargetName="Bar" Property="Margin" Value="1,2" />
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="Bar" Property="Opacity" Value="0.7" />
                                                                    <Setter TargetName="Bar" Property="Margin" Value="1,2" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                                              Focusable="False" BorderThickness="0" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                                              Focusable="False" BorderThickness="0" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <!-- Resalta la casilla de tarea al pasar el ratón por encima, para que se note que es
                 clicable (antes solo cambiaba el cursor de texto normal, indistinguible de pasar
                 por cualquier otro sitio). IsHitTestVisible="False" para que el ratón siga llegando
                 al TextBox de debajo tal cual: este Canvas solo pinta, nunca intercepta clics.
                 Mismo tono que NoteActionButtonStyle (#26000000) para el mismo lenguaje de hover
                 que ya usan los botones de la cabecera. -->
            <Canvas x:Name="FindLayer" IsHitTestVisible="False">
                <Border x:Name="TaskHoverHighlight" Background="{DynamicResource NoteTaskHoverBrush}" CornerRadius="{DynamicResource AlduneRadius3}"
                        Visibility="Collapsed" />
                <!-- Coincidencia actual de Ctrl+F: se pinta aparte porque la selección de un cuadro sin el
                     foco (la barra lo tiene) sale en el gris de sistema y casi no se ve sobre la nota. -->
                <Border x:Name="FindHighlight" BorderThickness="1.5" CornerRadius="{DynamicResource AlduneRadius3}"
                        Visibility="Collapsed" />
            </Canvas>
        </Grid>

        <!-- Aparece cuando todas las tareas de la nota están hechas: lo siguiente es o volver a
             empezar la lista (la de la compra de la semana que viene) o guardarla. Fila propia y no
             encima del texto, para no tapar la última tarea. -->
        <StackPanel x:Name="AllDoneBar" Grid.Row="3" Orientation="Horizontal"
                    Margin="20,-8,20,12" Visibility="Collapsed">
            <TextBlock Text="{x:Static res:Strings.AllTasksDone}" FontSize="12"
                       Foreground="{DynamicResource NoteInkBrush}" Opacity="0.75"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button Click="OnUncheckAllClick" Style="{StaticResource NoteActionButtonStyle}"
                    Padding="8,3" Margin="0,0,6,0">
                <TextBlock Text="{x:Static res:Strings.UncheckAllTasks}" FontSize="12"
                           Foreground="{DynamicResource NoteInkBrush}" />
            </Button>
            <Button x:Name="AllDoneArchiveButton" Click="OnArchiveClick" Style="{StaticResource NoteActionButtonStyle}"
                    Padding="8,3">
                <TextBlock Text="{x:Static res:Strings.Archive}" FontSize="12"
                           Foreground="{DynamicResource NoteInkBrush}" />
            </Button>
        </StackPanel>

        <!-- Señal de sincronización (opción de Ajustes → Aspecto). En la fila de abajo, a la derecha,
             para no tapar texto; monoespaciada para que las barras ▂▄▆█ queden alineadas. -->
        <TextBlock x:Name="SyncSignalText" Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,-8,14,10" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                   Foreground="{DynamicResource NoteInkBrush}" Opacity="0.7" Visibility="Collapsed" />

        <!-- Franja de la piel Stripe: el color de la nota va solo aquí (ver NoteFace). -->
        <!-- Ctrl+F: superpuesta al cuerpo, sin empujarlo (no es una fila: el texto no se mueve). Arriba a la
             derecha; baja al pie si la coincidencia queda justo debajo (ver PositionFindBar). -->
        <Border x:Name="FindBar" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="5"
                Margin="0,6,26,8" Padding="8,3,3,3"
                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}"
                BorderBrush="{DynamicResource NoteHoverBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource AlduneRadius4}">
            <StackPanel Orientation="Horizontal">
                <Grid>
                    <TextBlock Text="{x:Static res:Strings.FindInNotePlaceholder}" FontSize="12" IsHitTestVisible="False"
                               VerticalAlignment="Center" Opacity="0.55" Foreground="{DynamicResource NoteInkBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=FindBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="FindBox" Width="120" FontSize="12" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource NoteInkBrush}" CaretBrush="{DynamicResource NoteInkBrush}"
                             VerticalContentAlignment="Center" TextChanged="OnFindTextChanged" PreviewKeyDown="OnFindKeyDown" />
                </Grid>
                <TextBlock x:Name="FindCount" FontSize="11" Margin="6,0,6,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource NoteInkBrush}" Opacity="0.7" />
                <Button Content="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Width="22" Height="22"
                        Style="{StaticResource NoteActionButtonStyle}" Foreground="{DynamicResource NoteInkBrush}"
                        ToolTip="{x:Static res:Strings.FindPreviousTooltip}" Click="OnFindPreviousClick" Focusable="False" />
                <Button Content="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Width="22" Height="22" Margin="2,0,0,0"
                        Style="{StaticResource NoteActionButtonStyle}" Foreground="{DynamicResource NoteInkBrush}"
                        ToolTip="{x:Static res:Strings.FindNextTooltip}" Click="OnFindNextClick" Focusable="False" />
                <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Width="22" Height="22" Margin="2,0,0,0"
                        Style="{StaticResource NoteActionButtonStyle}" Foreground="{DynamicResource NoteInkBrush}"
                        ToolTip="{x:Static res:Strings.FindCloseTooltip}" Click="OnFindCloseClick" Focusable="False" />
            </StackPanel>
        </Border>
        <Border x:Name="FaceStripe" Grid.Row="1" Grid.RowSpan="3" Width="3" HorizontalAlignment="Left"
                Visibility="Collapsed" IsHitTestVisible="False" />
        <local:BevelEdge Grid.RowSpan="4" />
    </Grid>
    </Border>
</Window>
