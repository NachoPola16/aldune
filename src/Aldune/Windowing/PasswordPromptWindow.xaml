<Window x:Class="Aldune.Windowing.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Aldune.Resources"
        x:ClassModifier="internal"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#2A261F"
        SourceInitialized="OnSourceInitialized">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Caja de contraseña con el aspecto de ColorTextBoxStyle. El borde se pone rojo suave cuando
             la contraseña no vale (Tag="Error"): el error se ve donde está el foco, no solo abajo. -->
        <Style x:Key="PasswordFieldBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#3C3730" />
            <Setter Property="BorderBrush" Value="#5A5146" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#A18465" />
                </Trigger>
                <Trigger Property="Tag" Value="Error">
                    <Setter Property="BorderBrush" Value="#D98C84" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BarePasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="#F5F0E6" />
            <Setter Property="CaretBrush" Value="#F5F0E6" />
            <Setter Property="SelectionBrush" Value="#806A55" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="BareTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#F5F0E6" />
            <Setter Property="CaretBrush" Value="#F5F0E6" />
            <Setter Property="SelectionBrush" Value="#806A55" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="RevealButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#A79E90" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0,5,5,0">
                            <TextBlock x:Name="Glyph" Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F5F0E6" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Text" Value="&#xED1A;" />
                                <Setter Property="Foreground" Value="#E0CBA8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#2A261F" BorderBrush="#5A5146" BorderThickness="1" Padding="20,17,20,16">
        <StackPanel>
            <Grid>
                <StackPanel Margin="0,0,36,0">
                    <TextBlock x:Name="TitleText" Foreground="#F5F0E6" FontSize="17" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="HintText" Foreground="#A79E90" FontSize="12" Margin="0,5,0,0"
                               TextWrapping="Wrap" LineHeight="17" />
                </StackPanel>
                <Button Content="&#x2715;" Width="27" Height="27" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource ColorDialogButtonStyle}" Padding="0"
                        WindowChrome.IsHitTestVisibleInChrome="True" Focusable="False"
                        Click="OnCancelClick" ToolTip="{x:Static res:Strings.CloseTooltip}"
                        AutomationProperties.Name="{x:Static res:Strings.CloseTooltip}" />
            </Grid>

            <TextBlock x:Name="PasswordLabel" Text="{x:Static res:Strings.PasswordLabel}"
                       Foreground="#EDE7DC" FontSize="12" Margin="0,18,0,6" />
            <Border x:Name="PasswordField" Style="{StaticResource PasswordFieldBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="PasswordInput" Style="{StaticResource BarePasswordBoxStyle}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}"
                                 PasswordChanged="OnPasswordChanged" />
                    <TextBox x:Name="PasswordPlain" Style="{StaticResource BareTextBoxStyle}" Visibility="Collapsed"
                             AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}"
                             TextChanged="OnPlainChanged" />
                    <ToggleButton x:Name="RevealToggle" Grid.Column="1" Style="{StaticResource RevealButtonStyle}"
                                  Checked="OnRevealChanged" Unchecked="OnRevealChanged"
                                  ToolTip="{x:Static res:Strings.ShowPassword}"
                                  AutomationProperties.Name="{x:Static res:Strings.ShowPassword}" />
                </Grid>
            </Border>

            <StackPanel x:Name="ConfirmationPanel" Visibility="Collapsed">
                <TextBlock x:Name="ConfirmationLabel" Text="{x:Static res:Strings.ConfirmPasswordLabel}"
                           Foreground="#EDE7DC" FontSize="12" Margin="0,12,0,6" />
                <Border x:Name="ConfirmationField" Style="{StaticResource PasswordFieldBorderStyle}">
                    <Grid>
                        <PasswordBox x:Name="ConfirmationInput" Style="{StaticResource BarePasswordBoxStyle}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=ConfirmationLabel}"
                                     PasswordChanged="OnPasswordChanged" />
                        <TextBox x:Name="ConfirmationPlain" Style="{StaticResource BareTextBoxStyle}" Visibility="Collapsed"
                                 AutomationProperties.LabeledBy="{Binding ElementName=ConfirmationLabel}"
                                 TextChanged="OnPlainChanged" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Una sola línea de estado bajo los campos: el error si lo hay y, si no, el aviso de Bloq
                 Mayús. Con alto mínimo para que la ventana no salte al aparecer el texto. -->
            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" MinHeight="17" Margin="0,9,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="{x:Static res:Strings.CustomColorCancel}" IsCancel="True"
                        Style="{StaticResource ColorDialogButtonStyle}" Click="OnCancelClick" />
                <Button x:Name="AcceptButton" IsDefault="True" Margin="8,0,0,0"
                        Style="{StaticResource PrimaryColorDialogButtonStyle}" Click="OnAcceptClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
