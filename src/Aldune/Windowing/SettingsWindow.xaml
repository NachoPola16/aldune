<Window x:Class="Aldune.Windowing.SettingsWindow"
        KeyboardNavigation.TabNavigation="Cycle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aldune.Windowing"
        xmlns:app="clr-namespace:Aldune"
        xmlns:res="clr-namespace:Aldune.Resources"
        Title="{x:Static res:Strings.SettingsWindowTitle}"
        Width="900" Height="700" MinWidth="720" MinHeight="460"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        Background="{DynamicResource AlduneGroundBrush}"
        Topmost="True"
        StateChanged="OnWindowStateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- The bar stops as far from the bottom of the window as its thumb is from the right edge (23 px), and starts under the title bar. -->
        <Thickness x:Key="ScrollBarMargin">0,6,0,21</Thickness>
        <!-- Interruptor al estilo de Configuración de Windows 11: la etiqueta a la izquierda y el
             interruptor a la derecha, para los sí/no. Las tarjetas se quedan para elegir una opción
             entre varias (monitor, borde, aspecto, idioma). Sigue siendo un CheckBox: el código de
             detrás lee IsChecked y Click igual que antes. Foreground pinta el interruptor encendido y
             Background el pomo, como hacía la casilla. -->
        <Style x:Key="SettingsSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AlduneFocusVisual}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- A label longer than the row (a long language, a wide font, a big text size) wraps instead of being cut under the switch. -->
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Border x:Name="Track" Grid.Column="1" Width="38" Height="20" CornerRadius="10"
                                    BorderBrush="{TemplateBinding Foreground}" BorderThickness="1.5"
                                    Background="Transparent" VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Width="10" Height="10" Margin="4,0"
                                         Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <!-- On = filled with the accent (as on Android); off keeps the text-colour outline. -->
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AlduneAccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AlduneAccentBrush}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AlduneOnAccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A search result: like a record button but with its text on the left, one row per setting. -->
        <Style x:Key="SearchResultButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource AlduneRaisedBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource AlduneTextCaption}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AlduneRadius6}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecordButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource AlduneRaisedBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource AlduneTextCaption}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AlduneRadius6}" BorderBrush="{DynamicResource AlduneControlEdgeBrush}" BorderThickness="{DynamicResource AlduneControlEdgeThickness}">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- Relieve de la piel Bevel; con las demás no dibuja nada. -->
                            <local:BevelEdge OnlyWhenSquare="True" ShadowOutside="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AlduneTextFaintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerRecordButtonStyle" TargetType="Button" BasedOn="{StaticResource RecordButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AlduneDangerBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AlduneOnDangerBgBrush}" />
        </Style>

        <Style x:Key="SyncProfileComboStyle" TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}" />
        <Style x:Key="SyncProfileItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItemStyle}" />

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource AlduneTextBody}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource AlduneRadius6}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Sobre la barra en degradado (XP) los botones llevan el texto de la barra. -->
                <DataTrigger Binding="{Binding GradientTitleBar, Source={x:Static local:SkinState.Current}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AlduneOnTitleBarBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Chip compacto para el plazo (minutos/horas/dias/semanas): las tarjetas de
             MonitorRadioStyle son demasiado altas para cuatro opciones de una sola palabra en fila.
             Mismo patron que FilterToggleStyle del gestor de notas. -->
        <Style x:Key="DelayUnitToggleStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource AlduneMutedTextBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="{DynamicResource AlduneTextCaption}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource AlduneRadius5}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AlduneTextStrongBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A look as a card: a miniature of the app in that look's own colours with its name under it. The selected one gets a strong frame. -->
        <Style x:Key="AppearanceCardStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource AlduneTextSmall}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AlduneFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Width="176" Background="{DynamicResource AlduneSurfaceBrush}" CornerRadius="{DynamicResource AlduneRadius8}"
                                BorderBrush="Transparent" BorderThickness="2" Padding="6">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AlduneRaisedHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AlduneSelectedBrush}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AlduneTextStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MonitorRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource AlduneTextBody}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{DynamicResource AlduneSurfaceBrush}" CornerRadius="{DynamicResource AlduneRadius6}" Padding="12,9" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Radio literal: con esquinas rectas un botón de opción cuadrado se leería como casilla. -->
                                <Border x:Name="DotOuter" Width="16" Height="16" CornerRadius="8"
                                        BorderBrush="{DynamicResource AlduneTextFaintBrush}" BorderThickness="1.5"
                                        VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Ellipse x:Name="DotInner" Width="8" Height="8" Fill="{DynamicResource AlduneTextBrush}"
                                             Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <!-- Con el texto en varias líneas si no cabe: a 720 px, el ancho mínimo, «On the screen with the mouse» se cortaba. -->
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneRaisedHoverBrush}" />
                                <Setter TargetName="DotOuter" Property="BorderBrush" Value="{DynamicResource AlduneTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneSelectedBrush}" />
                                <Setter TargetName="DotOuter" Property="BorderBrush" Value="{DynamicResource AlduneTextBrush}" />
                                <Setter TargetName="DotInner" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Entradas del menú lateral: la seleccionada con el fondo de las tarjetas elegidas. -->
        <Style x:Key="SettingsNavStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextSoftBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource AlduneTextBody}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource AlduneRadius6}" Padding="12,8" Margin="0,0,0,2">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneSelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AlduneTextStrongBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Menú lateral con páginas en vez de dos columnas con scroll: con todo junto la ventana
         medía 920x2150 y en una pantalla de 1440 de alto había que desplazarse para casi todo, con la
         columna izquierda el doble de alta que la derecha. Con páginas el tamaño es fijo (y con tope
         contra la pantalla, ver AppCoordinator.OpenSettings) y cada una cabe o casi. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- CaptionHeight cubre esta franja, asi que la ventana se arrastra desde aqui. Fondo de la
             barra de la piel: transparente en la de siempre. -->
        <Border x:Name="TitleBarStrip" Background="{DynamicResource AlduneTitleBarFill}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Padding" Value="20,18,14,0" />
                    <Style.Triggers>
                        <!-- Con barra en degradado (XP) la cabecera es una barra de título de verdad:
                             compacta, de borde a borde y con el texto de la barra. -->
                        <DataTrigger Binding="{Binding GradientTitleBar, Source={x:Static local:SkinState.Current}}" Value="True">
                            <Setter Property="Padding" Value="20,17,16,17" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <TextBlock Text="{x:Static res:Strings.SettingsHeader}" Foreground="{DynamicResource AlduneOnTitleBarBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource AlduneTextHeading}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GradientTitleBar, Source={x:Static local:SkinState.Current}}" Value="True">
                                    <Setter Property="FontSize" Value="{DynamicResource AlduneTextBody}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <!-- Centrado en la barra, como los botones de la ventana: alineado arriba quedaba unos píxeles alto. -->
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Width="28" Height="28"
                            ToolTip="{x:Static res:Strings.MinimizeWindowTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.MinimizeWindowTooltip}"
                            Click="OnMinimizeClick"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource CloseButtonStyle}">
                        <Border Width="10" Height="1" VerticalAlignment="Center" Margin="0,6,0,0"
                            UseLayoutRounding="True" SnapsToDevicePixels="True"
                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="MaximizeButton" Width="28" Height="28"
                            ToolTip="{x:Static res:Strings.MaximizeWindowTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.MaximizeWindowTooltip}"
                            Click="OnMaximizeClick"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource CloseButtonStyle}">
                        <local:MaximizeGlyph x:Name="MaximizeGlyph" Ink="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Width="28" Height="28"
                            ToolTip="{x:Static res:Strings.CloseTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.CloseTooltip}"
                            Click="OnCloseClick"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource CloseButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="0,16,0,0" />
                    <Style.Triggers>
                        <!-- Same breathing room under a real title bar (XP) as in the notes manager. -->
                        <DataTrigger Binding="{Binding GradientTitleBar, Source={x:Static local:SkinState.Current}}" Value="True">
                            <Setter Property="Margin" Value="0,24,0,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="14,0,12,18" LastChildFill="False">
                <!-- El gestor sigue siendo su propia ventana (se usa a diario; Ajustes, poco), pero a
                     un clic desde aquí, igual que el gestor tiene su botón a Ajustes. -->
                <Button DockPanel.Dock="Bottom" Content="{x:Static res:Strings.TrayManageNotes}"
                        Click="OnManageNotesClick" Padding="10,7" HorizontalAlignment="Stretch"
                        Style="{StaticResource RecordButtonStyle}" />
                <StackPanel DockPanel.Dock="Top">
                    <!-- Search: fuzzy (accents, typos, half-typed words); Ctrl+F focuses it. While it has text the page list gives way to the results. -->
                    <Grid Margin="0,0,0,10">
                        <TextBox x:Name="SettingsSearchBox" Padding="10,6" FontSize="{DynamicResource AlduneTextBody}" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="{x:Static res:Strings.SettingsSearchHint}"
                                 TextChanged="OnSettingsSearchChanged" PreviewKeyDown="OnSettingsSearchKeyDown" />
                        <TextBlock Text="{x:Static res:Strings.SettingsSearchHint}" IsHitTestVisible="False" Margin="15,0,8,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{DynamicResource AlduneTextBody}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SettingsSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel x:Name="SettingsSearchResults" Visibility="Collapsed" Width="172" />
                    <StackPanel x:Name="SettingsNavList" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                    <RadioButton x:Name="NavGeneral" Tag="General" GroupName="SettingsNav"
                                 Content="{x:Static res:Strings.SettingsPageGeneral}"
                                 Style="{StaticResource SettingsNavStyle}" Checked="OnPageChecked" />
                    <RadioButton x:Name="NavAppearance" Tag="Appearance" GroupName="SettingsNav"
                                 Content="{x:Static res:Strings.SettingsPageAppearance}"
                                 Style="{StaticResource SettingsNavStyle}" Checked="OnPageChecked" />
                    <RadioButton x:Name="NavNotes" Tag="Notes" GroupName="SettingsNav"
                                 Content="{x:Static res:Strings.SettingsPageNotes}"
                                 Style="{StaticResource SettingsNavStyle}" Checked="OnPageChecked" />
                    <RadioButton x:Name="NavSounds" Tag="Sounds" GroupName="SettingsNav"
                                 Content="{x:Static res:Strings.SettingsPageSounds}"
                                 Style="{StaticResource SettingsNavStyle}" Checked="OnPageChecked" />
                    <RadioButton x:Name="NavColors" Tag="Colors" GroupName="SettingsNav"
                                 Content="{x:Static res:Strings.SettingsPageColors}"
                                 Style="{StaticResource SettingsNavStyle}" Checked="OnPageChecked" />
                    <RadioButton x:Name="NavDock" Tag="Dock" GroupName="SettingsNav"
                                 Content="{x:Static res:Strings.SettingsPageDock}"
                                 Style="{StaticResource SettingsNavStyle}" Checked="OnPageChecked" />
                    <RadioButton x:Name="NavSync" Tag="Sync" GroupName="SettingsNav"
                                 Content="{x:Static res:Strings.SettingsPageSync}"
                                 Style="{StaticResource SettingsNavStyle}" Checked="OnPageChecked" />
                    <RadioButton x:Name="NavHelp" Tag="Help" GroupName="SettingsNav"
                                 Content="{x:Static res:Strings.SettingsPageHelp}"
                                 Style="{StaticResource SettingsNavStyle}" Checked="OnPageChecked" />
                    <RadioButton x:Name="NavAbout" Tag="About" GroupName="SettingsNav"
                                 Content="{x:Static res:Strings.SettingsPageAbout}"
                                 Style="{StaticResource SettingsNavStyle}" Checked="OnPageChecked" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <Border Grid.Column="1" Background="{DynamicResource AlduneRaisedBrush}" Width="1" HorizontalAlignment="Left" Margin="0,0,0,18" />

            <ScrollViewer x:Name="PageScroller" Grid.Column="1" Margin="1,0,20,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- Ancho máximo: en pantalla completa los interruptores no se van al borde derecho, siempre quedan a la misma distancia del texto. -->
                <Grid Margin="28,0,8,56" MaxWidth="780" HorizontalAlignment="Left">
                <StackPanel x:Name="GeneralPage" Visibility="Collapsed">
                    <TextBlock Text="{x:Static res:Strings.SettingsPageGeneral}" Foreground="{DynamicResource AlduneTextStrongBrush}" FontSize="{DynamicResource AlduneTextPageTitle}" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <Border x:Name="InterfaceModePanel" Margin="0,0,0,0"
                            Background="{DynamicResource AlduneSurfaceBrush}" CornerRadius="{DynamicResource AlduneRadius8}" Padding="12">
                        <!-- Columnas, no un margen fijo: el botón mide distinto en cada idioma
                             ("Vereinfachten Modus verwenden" tapaba el texto en alemán). -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{x:Static res:Strings.InterfaceModeSectionTitle}"
                                           Foreground="{DynamicResource AlduneTextBrush}" FontSize="{DynamicResource AlduneTextBody}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Static res:Strings.InterfaceModeHint}"
                                           Foreground="{DynamicResource AlduneMutedTextBrush}" FontSize="{DynamicResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button x:Name="InterfaceModeButton" Grid.Column="1"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Padding="12,7" Click="OnInterfaceModeClick"
                                    Style="{StaticResource RecordButtonStyle}" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="0,20,0,0">
                        <CheckBox x:Name="StartupCheck"
                                  Content="{x:Static res:Strings.StartupCheckbox}"
                                  Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{DynamicResource AlduneTextBody}"
                                  Style="{StaticResource SettingsSwitchStyle}"
                                  Click="OnStartupToggled" />
                        <TextBlock Text="{x:Static res:Strings.StartupHint}"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{DynamicResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,6,56,0" />
                    </StackPanel>
                    <Border Background="{DynamicResource AlduneRaisedBrush}" Height="1" Margin="0,20,0,0" />
                    <StackPanel Margin="0,20,0,0">
                        <CheckBox x:Name="HotkeyCheck"
                                  Content="{x:Static res:Strings.HotkeyCheckbox}"
                                  Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{DynamicResource AlduneTextBody}"
                                  Style="{StaticResource SettingsSwitchStyle}"
                                  Click="OnHotkeyToggled" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <!-- Un boton que captura la siguiente combinacion, no una lista de teclas:
                                 escoger modificador y tecla en dos desplegables obliga a traducir
                                 mentalmente lo que uno ya sabe pulsar. -->
                            <Button x:Name="HotkeyButton" Click="OnRecordHotkeyClick"
                                    MinWidth="150" Padding="12,7"
                                    Style="{StaticResource RecordButtonStyle}" />
                            <Button x:Name="HotkeyResetButton" Content="{x:Static res:Strings.HotkeyResetButton}" Click="OnResetHotkeyClick"
                                    Margin="8,0,0,0" Padding="12,7"
