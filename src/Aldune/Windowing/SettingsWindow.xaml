                        <CheckBox x:Name="AutoExportCheck"
                                  Content="{x:Static res:Strings.AutoExportCheckbox}"
                                  Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{DynamicResource AlduneTextBody}"
                                  Style="{StaticResource SettingsSwitchStyle}"
                                  Click="OnAutoExportToggled" />
                        <TextBlock Text="{x:Static res:Strings.AutoExportHint}"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{DynamicResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,6,56,0" />
                        <StackPanel x:Name="AutoExportDetails" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{x:Static res:Strings.AutoExportChooseFolder}" Padding="10,5" Style="{StaticResource RecordButtonStyle}"
                                        Click="OnAutoExportChooseFolderClick" />
                                <TextBlock x:Name="AutoExportFolderText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource AlduneTextBody}" TextTrimming="CharacterEllipsis" MaxWidth="360"
                                           Foreground="{DynamicResource AlduneTextBrush}" />
                            </StackPanel>
                            <CheckBox x:Name="AutoExportArchivedCheck" Margin="0,12,0,0"
                                      Content="{x:Static res:Strings.AutoExportArchivedCheckbox}"
                                      Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{DynamicResource AlduneTextBody}"
                                      Style="{StaticResource SettingsSwitchStyle}"
                                      Click="OnAutoExportArchivedToggled" />
                            <TextBlock x:Name="AutoExportErrorText" Margin="0,8,56,0" TextWrapping="Wrap" Visibility="Collapsed" FontSize="{DynamicResource AlduneTextSmall}"
                                       Foreground="{DynamicResource AlduneHintBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="HelpPage" Visibility="Collapsed">
                    <TextBlock Text="{x:Static res:Strings.SettingsPageHelp}" Foreground="{DynamicResource AlduneTextStrongBrush}" FontSize="{DynamicResource AlduneTextPageTitle}" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <TextBlock x:Name="QuickHelpText"
                               Foreground="{DynamicResource AlduneHintBrush}" FontSize="{DynamicResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18" />
                </StackPanel>
                <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                    <TextBlock Text="{x:Static res:Strings.SettingsPageAbout}" Foreground="{DynamicResource AlduneTextStrongBrush}" FontSize="{DynamicResource AlduneTextPageTitle}" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <!-- The app's own mark and name, here and nowhere else inside the windows (the logo is never redrawn by hand: see BRANDING.md). -->
                            <Image x:Name="AboutLogo" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{x:Static res:Strings.AppName}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Static res:Strings.AppName}"
                                           Foreground="{DynamicResource AlduneTextStrongBrush}" FontSize="{DynamicResource AlduneTextTitle}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Static app:AppInfo.DisplayVersion}"
                                           Foreground="{DynamicResource AlduneHintBrush}" FontSize="{DynamicResource AlduneTextSmall}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="{x:Static res:Strings.TrayCheckForUpdates}"
                                Padding="12,7" Click="OnCheckForUpdatesClick"
                                Style="{StaticResource RecordButtonStyle}" />
                            <Button Content="{x:Static res:Strings.WhatsNewButton}"
                                Margin="8,0,0,0" Padding="12,7" Click="OnWhatsNewClick"
                                    Style="{StaticResource RecordButtonStyle}" />
                            <Button Content="{x:Static res:Strings.RestartApplicationButton}"
                                Margin="8,0,0,0" Padding="12,7" Click="OnRestartClick"
                                    ToolTip="{x:Static res:Strings.RestartAppTooltip}"
                                    AutomationProperties.Name="{x:Static res:Strings.RestartAppTooltip}"
                                    Style="{StaticResource RecordButtonStyle}" />
                            <Button Content="{x:Static res:Strings.ExitApplicationButton}"
                                    Margin="8,0,0,0" Padding="12,7" Click="OnExitClick"
                                    ToolTip="{x:Static res:Strings.ExitAppTooltip}"
                                    AutomationProperties.Name="{x:Static res:Strings.ExitAppTooltip}"
                                    Style="{StaticResource RecordButtonStyle}" />
                        </StackPanel>
                    </Grid>
                    <Border Background="{DynamicResource AlduneRaisedBrush}" Height="1" Margin="0,20,0,0" />
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="{x:Static res:Strings.ConfigSectionTitle}"
                                   Foreground="{DynamicResource AlduneTextBrush}" FontSize="{DynamicResource AlduneTextBody}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static res:Strings.ConfigAboutHint}"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{DynamicResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="ExportConfigButton" Content="{x:Static res:Strings.ConfigExportButton}"
                                    Padding="12,7" Click="OnExportConfigClick"
                                    Style="{StaticResource RecordButtonStyle}" />
                            <Button x:Name="ImportConfigButton" Content="{x:Static res:Strings.ConfigImportButton}"
                                    Margin="8,0,0,0" Padding="12,7" Click="OnImportConfigClick"
                                    Style="{StaticResource RecordButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Background="{DynamicResource AlduneRaisedBrush}" Height="1" Margin="0,20,0,0" />
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="{x:Static res:Strings.BackupSectionTitle}"
                                   Foreground="{DynamicResource AlduneTextBrush}" FontSize="{DynamicResource AlduneTextBody}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static res:Strings.BackupAboutHint}"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{DynamicResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,6,56,0" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="BackupNowButton" Content="{x:Static res:Strings.BackupNowButton}"
                                    Margin="0,0,8,6" Padding="12,7" Click="OnBackupNowClick"
                                    Style="{StaticResource RecordButtonStyle}" />
                            <Button x:Name="BackupRestoreFileButton" Content="{x:Static res:Strings.BackupRestoreFileButton}"
                                    Margin="0,0,8,6" Padding="12,7" Click="OnBackupRestoreFileClick"
                                    Style="{StaticResource RecordButtonStyle}" />
                            <Button x:Name="BackupRestoreDailyButton" Content="{x:Static res:Strings.BackupRestoreDailyButton}"
                                    Margin="0,0,8,6" Padding="12,7" Click="OnBackupRestoreDailyClick"
                                    Style="{StaticResource RecordButtonStyle}" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
                </Grid>
            </ScrollViewer>
            <!-- Where the page continues past the edge of the viewport the content fades out instead of being cut off: a soft edge
                 (the window background, opaque at the edge and clear inwards) that only shows while there is more to scroll that way. -->
            <Border x:Name="PageFadeTop" Grid.Column="1" Height="26" VerticalAlignment="Top" Margin="1,0,20,0" IsHitTestVisible="False" Opacity="0"
                    Background="{DynamicResource AlduneGroundBrush}">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>
            <Border x:Name="PageFadeBottom" Grid.Column="1" Height="26" VerticalAlignment="Bottom" Margin="1,0,20,0" IsHitTestVisible="False" Opacity="0"
                    Background="{DynamicResource AlduneGroundBrush}">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>
        </Grid>
    </Grid>
</Window>
