<Window x:Class="Aldune.Windowing.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aldune.Windowing"
        xmlns:app="clr-namespace:Aldune"
        xmlns:res="clr-namespace:Aldune.Resources"
        Title="{x:Static res:Strings.SettingsWindowTitle}"
        Width="920" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        Background="{StaticResource AlduneGroundBrush}"
        Topmost="False"
        StateChanged="OnWindowStateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Misma casilla que el gestor: hereda Foreground, asi que una sola plantilla vale para
             fondo oscuro y para filas de color. -->
        <Style x:Key="AppCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="17" Height="17" CornerRadius="4"
                                    BorderBrush="{TemplateBinding Foreground}"
                                    BorderThickness="1.5"
                                    Background="Transparent"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="Tick" Text="&#x2713;" FontSize="12" FontWeight="Bold"
                                           Foreground="{TemplateBinding Background}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecordButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#EDE7DC" />
            <Setter Property="Background" Value="#3C3730" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4E4840" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#332F28" />
                                <Setter Property="Foreground" Value="#6B6459" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerRecordButtonStyle" TargetType="Button" BasedOn="{StaticResource RecordButtonStyle}">
            <Setter Property="Background" Value="#5A2A28" />
            <Setter Property="Foreground" Value="#F0C1BA" />
        </Style>

        <Style x:Key="SyncProfileComboStyle" TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}" />
        <Style x:Key="SyncProfileItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItemStyle}" />

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#EDE7DC" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4E4840" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Chip compacto para el plazo (minutos/horas/dias/semanas): las tarjetas de
             MonitorRadioStyle son demasiado altas para cuatro opciones de una sola palabra en fila.
             Mismo patron que FilterToggleStyle del gestor de notas. -->
        <Style x:Key="DelayUnitToggleStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#A79E90" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3C3730" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4E4840" />
                                <Setter Property="Foreground" Value="#F5F0E6" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonitorRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EDE7DC" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="#332F28" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="DotOuter" Width="16" Height="16" CornerRadius="8"
                                        BorderBrush="#6B6459" BorderThickness="1.5"
                                        VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Ellipse x:Name="DotInner" Width="8" Height="8" Fill="#EDE7DC"
                                             Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#403B33" />
                                <Setter TargetName="DotOuter" Property="BorderBrush" Value="#EDE7DC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#443F36" />
                                <Setter TargetName="DotOuter" Property="BorderBrush" Value="#EDE7DC" />
                                <Setter TargetName="DotInner" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Con scroll y con tope de alto (MaxHeight se fija por código contra el área de trabajo real):
         red de seguridad para pantallas pequeñas o muy escaladas, aunque las dos columnas de abajo
         ya dejan la ventana bastante más baja que la versión de una sola columna que llegó a
         salirse de pantalla (ver docs/STATUS.md). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,0,20">
        <!-- CaptionHeight cubre esta franja, asi que la ventana se arrastra desde aqui. -->
        <Grid Margin="24,18,14,0">
            <TextBlock Text="{x:Static res:Strings.SettingsHeader}" Foreground="#F5F0E6" FontSize="17" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="&#x2014;" Width="28" Height="28"
                        ToolTip="{x:Static res:Strings.MinimizeWindowTooltip}"
                        Click="OnMinimizeClick"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource CloseButtonStyle}" />
                <Button x:Name="MaximizeButton" Width="28" Height="28"
                        ToolTip="{x:Static res:Strings.MaximizeWindowTooltip}"
                        Click="OnMaximizeClick"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource CloseButtonStyle}">
                    <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" />
                </Button>
                <Button Content="&#x2715;" Width="28" Height="28"
                        Click="OnCloseClick"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource CloseButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Dos columnas en vez de una sola tira larga: con siete secciones más la ayuda, la
             versión de una columna se salía de una pantalla de portátil normal (reportado por el
             usuario, con captura). Izquierda: cómo se usa la app en general. Derecha: dónde y cómo
             vive el dock en el escritorio. Cada ajuste sigue con su explicación debajo, como
             siempre: son cosas que no se deducen mirándolas. -->
        <Border x:Name="InterfaceModePanel" Margin="24,18,24,0"
                Background="#332F28" CornerRadius="8" Padding="12">
            <Grid>
                <StackPanel Margin="0,0,170,0">
                    <TextBlock Text="{x:Static res:Strings.InterfaceModeSectionTitle}"
                               Foreground="#EDE7DC" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static res:Strings.InterfaceModeHint}"
                               Foreground="#A79E90" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <Button x:Name="InterfaceModeButton"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="12,7" Click="OnInterfaceModeClick"
                        Style="{StaticResource RecordButtonStyle}" />
            </Grid>
        </Border>

        <Grid x:Name="AdvancedSettingsPanel" Margin="24,22,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel>
                    <CheckBox x:Name="StartupCheck"
                              Content="{x:Static res:Strings.StartupCheckbox}"
                              Foreground="#EDE7DC" Background="#2A261F" FontSize="13"
                              Style="{StaticResource AppCheckBoxStyle}"
                              Click="OnStartupToggled" />
                    <TextBlock Text="{x:Static res:Strings.StartupHint}"
                               Foreground="#8A8175" FontSize="11" TextWrapping="Wrap" Margin="27,6,0,0" />
                </StackPanel>

                <Border Background="#3C3730" Height="1" Margin="0,20,0,0" />

                <StackPanel Margin="0,20,0,0">
                    <CheckBox x:Name="HotkeyCheck"
                              Content="{x:Static res:Strings.HotkeyCheckbox}"
                              Foreground="#EDE7DC" Background="#2A261F" FontSize="13"
                              Style="{StaticResource AppCheckBoxStyle}"
                              Click="OnHotkeyToggled" />

                    <StackPanel Orientation="Horizontal" Margin="27,10,0,0">
                        <!-- Un boton que captura la siguiente combinacion, no una lista de teclas:
                             escoger modificador y tecla en dos desplegables obliga a traducir
                             mentalmente lo que uno ya sabe pulsar. -->
                        <Button x:Name="HotkeyButton" Click="OnRecordHotkeyClick"
                                MinWidth="150" Padding="12,7"
                                Style="{StaticResource RecordButtonStyle}" />
                        <Button x:Name="HotkeyResetButton" Content="{x:Static res:Strings.HotkeyResetButton}" Click="OnResetHotkeyClick"
                                Margin="8,0,0,0" Padding="12,7"
                                Style="{StaticResource RecordButtonStyle}" />
                    </StackPanel>

                    <TextBlock x:Name="HotkeyHint"
                               Foreground="#8A8175" FontSize="11" TextWrapping="Wrap" Margin="27,10,0,0" />
                </StackPanel>

                <Border Background="#3C3730" Height="1" Margin="0,20,0,0" />

                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="{x:Static res:Strings.LanguageSectionTitle}"
                               Foreground="#EDE7DC" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static res:Strings.LanguageSectionHint}"
                               Foreground="#8A8175" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" />

                    <StackPanel x:Name="LanguageListContainer" />
                </StackPanel>

                <Border Background="#3C3730" Height="1" Margin="0,20,0,0" />

                <StackPanel Margin="0,20,0,0">
                    <CheckBox x:Name="AutoHideTasksCheck"
                              Content="{x:Static res:Strings.AutoHideCompletedTasksCheckbox}"
                              Foreground="#EDE7DC" Background="#2A261F" FontSize="13"
                              Style="{StaticResource AppCheckBoxStyle}"
                              Click="OnAutoHideTasksToggled" />
                    <TextBlock Text="{x:Static res:Strings.AutoHideCompletedTasksHint}"
                               Foreground="#8A8175" FontSize="11" TextWrapping="Wrap" Margin="27,6,0,0" />

                    <StackPanel x:Name="AutoHideTasksDelayPanel" Orientation="Horizontal" Margin="27,10,0,0">
                        <TextBlock Text="{x:Static res:Strings.AutoHideCompletedTasksDelayLabel}"
                                   Foreground="#EDE7DC" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <!-- Numero + unidad, no un desplegable fijo de "1 dia/1 semana": el usuario
                             pidio poder elegir cualquier plazo, no solo unos pocos preajustados. -->
                        <Border Background="#332F28" CornerRadius="6" VerticalAlignment="Center">
                            <TextBox x:Name="AutoHideTasksDelayValueBox"
                                     Background="Transparent" Foreground="#EDE7DC" CaretBrush="#EDE7DC"
                                     BorderThickness="0" FontSize="13" Width="30" MaxLength="3"
                                     TextAlignment="Center" Padding="6,6"
                                     PreviewTextInput="OnDelayValuePreviewTextInput"
                                     TextChanged="OnDelayValueChanged" />
                        </Border>
                        <Border Background="#332F28" CornerRadius="7" Padding="3" Margin="8,0,0,0" VerticalAlignment="Center">
                            <WrapPanel x:Name="DelayUnitContainer" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Border Background="#3C3730" Height="1" Margin="0,20,0,0" />

                <!-- Antes una constante fija en el código (NotesRepository.DefaultTrashRetentionDays);
                     no hay ningún motivo para que 30 sea mejor que otro número para todo el mundo,
                     así que pasa a ser elegible aquí, igual que el plazo de arriba. -->
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="{x:Static res:Strings.TrashRetentionTitle}"
                               Foreground="#EDE7DC" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static res:Strings.TrashRetentionHint}"
                               Foreground="#8A8175" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" />

                    <StackPanel Orientation="Horizontal">
                        <Border Background="#332F28" CornerRadius="6" VerticalAlignment="Center">
                            <TextBox x:Name="TrashRetentionValueBox"
                                     Background="Transparent" Foreground="#EDE7DC" CaretBrush="#EDE7DC"
                                     BorderThickness="0" FontSize="13" Width="30" MaxLength="3"
                                     TextAlignment="Center" Padding="6,6"
                                     PreviewTextInput="OnTrashRetentionPreviewTextInput"
                                     TextChanged="OnTrashRetentionChanged" />
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.TrashRetentionDaysUnit}"
                                   Foreground="#EDE7DC" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Background="#3C3730" Height="1" Margin="0,20,0,0" />

                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="{x:Static res:Strings.SyncSectionTitle}"
                               Foreground="#EDE7DC" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static res:Strings.SyncSectionHint}"
                               Foreground="#8A8175" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.SyncProfileLabel}" Foreground="#EDE7DC"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border x:Name="SyncProfileNameDisplay" Grid.Column="1" Background="#332F28"
                                CornerRadius="6" Padding="7,5">
                            <TextBlock x:Name="SyncProfileNameDisplayText" Foreground="#EDE7DC"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ComboBox x:Name="SyncProfileBox" Grid.Column="1"
                                  Style="{StaticResource SyncProfileComboStyle}"
                                  ItemContainerStyle="{StaticResource SyncProfileItemStyle}"
                                  SelectionChanged="OnSyncProfileChanged" />
                        <Button x:Name="SyncNewProfileButton" Grid.Column="2"
                                Content="{x:Static res:Strings.SyncNewProfile}" Click="OnSyncNewProfileClick"
                                Margin="6,0,0,0" Padding="8,5" Style="{StaticResource RecordButtonStyle}" />
                        <Button x:Name="SyncDeleteProfileButton" Grid.Column="3"
                                Content="{x:Static res:Strings.SyncDeleteProfile}" Click="OnSyncDeleteProfileClick"
                                Margin="6,0,0,0" Padding="8,5" Style="{StaticResource RecordButtonStyle}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.SyncProfileNameLabel}" Foreground="#8A8175"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="SyncProfileNameBox" Grid.Column="1"
                                 Background="#332F28" Foreground="#EDE7DC" BorderThickness="0"
                                 Padding="7,5" LostFocus="OnSyncProfileNameLostFocus" />
                    </Grid>
                    <CheckBox x:Name="SyncEnabledCheck"
                              Content="{x:Static res:Strings.SyncEnabledCheckbox}"
                              Foreground="#EDE7DC" Background="#2A261F" FontSize="13"
                              Style="{StaticResource AppCheckBoxStyle}"
                              Click="OnSyncEnabledToggled" />
                    <TextBlock Text="{x:Static res:Strings.SyncScopeHint}" Foreground="#8A8175"
                               FontSize="11" TextWrapping="Wrap" Margin="27,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="27,7,0,0">
                        <RadioButton x:Name="SyncAllNotesRadio" Content="{x:Static res:Strings.SyncScopeAll}"
                                     GroupName="SyncScope" Tag="AllNotes"
                                     Style="{StaticResource DelayUnitToggleStyle}"
                                     Checked="OnSyncScopeChanged" />
                        <RadioButton x:Name="SyncSelectedNotesRadio" Content="{x:Static res:Strings.SyncScopeSelected}"
                                     GroupName="SyncScope" Tag="SelectedNotes" Margin="4,0,0,0"
                                     Style="{StaticResource DelayUnitToggleStyle}"
                                     Checked="OnSyncScopeChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="27,7,0,0">
                        <Button x:Name="SyncChooseNotesButton" Content="{x:Static res:Strings.SyncChooseNotes}"
                                Click="OnSyncChooseNotesClick" Padding="10,6"
                                Style="{StaticResource RecordButtonStyle}" />
                        <TextBlock x:Name="SyncSelectionSummary" Foreground="#8A8175"
                                   FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="27,8,0,0">
                        <RadioButton x:Name="SyncFolderRadio" Content="{x:Static res:Strings.SyncFolderOption}"
                                     GroupName="SyncProvider" Tag="Folder"
                                     Style="{StaticResource DelayUnitToggleStyle}"
                                     Checked="OnSyncProviderChanged" />
                        <RadioButton x:Name="SyncServerRadio" Content="{x:Static res:Strings.SyncServerOption}"
                                     GroupName="SyncProvider" Tag="Server" Margin="4,0,0,0"
                                     Style="{StaticResource DelayUnitToggleStyle}"
                                     Checked="OnSyncProviderChanged" />
                        <RadioButton x:Name="SyncWebDavRadio" Content="{x:Static res:Strings.SyncWebDavOption}"
                                     GroupName="SyncProvider" Tag="WebDav" Margin="4,0,0,0"
                                     Style="{StaticResource DelayUnitToggleStyle}"
                                     Checked="OnSyncProviderChanged" />
                    </StackPanel>

                    <Grid Margin="27,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.SyncFolderLabel}" Foreground="#EDE7DC"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="SyncFolderPathBox" Grid.Column="1" MinWidth="130"
                                 Background="#332F28" Foreground="#EDE7DC" BorderThickness="0"
                                 Padding="7,6" TextChanged="OnSyncValueChanged" />
                        <Button x:Name="SyncBrowseButton" Grid.Column="2"
                                Content="{x:Static res:Strings.SyncBrowseButton}" Click="OnSyncBrowseClick"
                                Margin="8,0,0,0" Padding="10,6" Style="{StaticResource RecordButtonStyle}" />
                    </Grid>

                    <Grid Margin="27,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.SyncServerUrlLabel}" Foreground="#EDE7DC"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="SyncServerUrlBox" Grid.Column="1" MinWidth="130"
                                 Background="#332F28" Foreground="#EDE7DC" BorderThickness="0"
                                 Padding="7,6" TextChanged="OnSyncValueChanged" />
                    </Grid>
                    <Grid x:Name="SyncServerTokenGrid" Margin="27,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.SyncServerTokenLabel}" Foreground="#EDE7DC"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="SyncServerTokenBox" Grid.Column="1" MinWidth="130"
                                 Background="#332F28" Foreground="#EDE7DC" BorderThickness="0"
                                 Padding="7,6" LostFocus="OnSyncTokenLostFocus" />
                    </Grid>

                    <Grid x:Name="SyncWebDavUsernameGrid" Margin="27,8,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.SyncWebDavUsernameLabel}" Foreground="#EDE7DC"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="SyncWebDavUsernameBox" Grid.Column="1" MinWidth="130"
                                 Background="#332F28" Foreground="#EDE7DC" BorderThickness="0"
                                 Padding="7,6" LostFocus="OnSyncWebDavUsernameLostFocus" />
                    </Grid>
                    <Grid x:Name="SyncWebDavPasswordGrid" Margin="27,8,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.SyncWebDavPasswordLabel}" Foreground="#EDE7DC"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <PasswordBox x:Name="SyncWebDavPasswordBox" Grid.Column="1" MinWidth="130"
                                     Background="#332F28" Foreground="#EDE7DC" BorderThickness="0"
                                     Padding="7,6" LostFocus="OnSyncWebDavPasswordLostFocus" />
                    </Grid>
                    <TextBlock x:Name="SyncWebDavHintText" Text="{x:Static res:Strings.SyncWebDavHint}" Foreground="#8A8175"
                               FontSize="11" TextWrapping="Wrap" Margin="27,4,0,0" />

                    <TextBlock Text="{x:Static res:Strings.SyncCodeLabel}" Foreground="#EDE7DC"
                               Margin="27,12,0,0" />
                    <TextBox x:Name="SyncCodeBox" Margin="27,6,0,0"
                             Background="#332F28" Foreground="#EDE7DC" BorderThickness="0"
                             Padding="7,6" />
                    <TextBlock Text="{x:Static res:Strings.SyncCodeHint}" Foreground="#8A8175"
                               FontSize="11" TextWrapping="Wrap" Margin="27,5,0,0" />
                    <TextBlock Text="{x:Static res:Strings.SyncShareCodeHint}" Foreground="#8A8175"
                               FontSize="11" TextWrapping="Wrap" Margin="27,3,0,0" />
                    <WrapPanel Margin="27,8,0,0">
                        <Button x:Name="SyncGenerateCodeButton" Content="{x:Static res:Strings.SyncGenerateCodeButton}"
                                Click="OnSyncGenerateCodeClick" Margin="0,0,7,6" Padding="10,6"
                                Style="{StaticResource RecordButtonStyle}" />
                        <Button x:Name="SyncShareProfileButton" Content="{x:Static res:Strings.SyncShareProfileButton}"
                                Click="OnSyncShareProfileClick" Margin="0,0,7,6" Padding="10,6"
                                Style="{StaticResource RecordButtonStyle}" />
                        <Button x:Name="SyncRevokeAccessButton" Content="{x:Static res:Strings.SyncRevokeAccessButton}"
                                Click="OnSyncRevokeAccessClick" Margin="0,0,7,6" Padding="10,6"
                                Style="{StaticResource DangerRecordButtonStyle}" />
                        <Button x:Name="SyncImportCodeButton" Content="{x:Static res:Strings.SyncImportCodeButton}"
                                Click="OnSyncImportCodeClick" Margin="0,0,7,6" Padding="10,6"
                                Style="{StaticResource RecordButtonStyle}" />
                        <Button x:Name="SyncNowButton" Content="{x:Static res:Strings.SyncNowButton}"
                                Click="OnSyncNowClick" Margin="0,0,7,6" Padding="10,6"
                                Style="{StaticResource RecordButtonStyle}" />
                    </WrapPanel>
                    <TextBlock Text="{x:Static res:Strings.SyncRevokeAccessHint}" Foreground="#8A8175"
                               FontSize="11" TextWrapping="Wrap" Margin="27,5,0,0" />
                    <TextBlock x:Name="SyncStatusText" Foreground="#8A8175" FontSize="11"
                               TextWrapping="Wrap" Margin="27,8,0,0" />
                    <CheckBox x:Name="SyncAutomaticCheck"
                              Content="{x:Static res:Strings.SyncAutomaticCheckbox}"
                              Foreground="#EDE7DC" Background="#2A261F" FontSize="13"
                              Style="{StaticResource AppCheckBoxStyle}"
                              Margin="0,12,0,0" Click="OnSyncAutomaticToggled" />
                    <TextBlock Text="{x:Static res:Strings.SyncAutomaticHint}" Foreground="#8A8175"
                               FontSize="11" TextWrapping="Wrap" Margin="27,5,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="27,8,0,0">
                        <TextBlock Text="{x:Static res:Strings.SyncIntervalLabel}" Foreground="#EDE7DC"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border Background="#332F28" CornerRadius="6">
                            <TextBox x:Name="SyncIntervalValueBox" Width="38" MaxLength="4"
                                     Background="Transparent" Foreground="#EDE7DC" CaretBrush="#EDE7DC"
                                     BorderThickness="0" Padding="6,5" TextAlignment="Center"
                                     PreviewTextInput="OnSyncIntervalPreviewTextInput"
                                     LostFocus="OnSyncIntervalLostFocus" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SyncLastSyncText" Foreground="#8A8175" FontSize="11"
                               Margin="27,7,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="27,8,0,0">
                        <TextBlock x:Name="SyncConflictsText" Foreground="#C9A46C" FontSize="11"
                                   VerticalAlignment="Center" />
                        <Button x:Name="SyncConflictsButton"
                                Content="{x:Static res:Strings.SyncConflictsButton}"
                                Click="OnSyncConflictsClick" Margin="10,0,0,0" Padding="9,5"
                                Style="{StaticResource RecordButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1" Background="#3C3730" Width="1" HorizontalAlignment="Center" />

            <StackPanel Grid.Column="2">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.MonitorSectionTitle}"
                               Foreground="#EDE7DC" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static res:Strings.MonitorSectionHint}"
                               Foreground="#8A8175" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" />

                    <StackPanel x:Name="MonitorListContainer" />
                </StackPanel>

                <Border Background="#3C3730" Height="1" Margin="0,20,0,0" />

                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="{x:Static res:Strings.EdgeSectionTitle}"
                               Foreground="#EDE7DC" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static res:Strings.EdgeSectionHint}"
                               Foreground="#8A8175" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" />

                    <StackPanel x:Name="EdgeListContainer" />
                </StackPanel>

                <Border Background="#3C3730" Height="1" Margin="0,20,0,0" />

                <StackPanel Margin="0,20,0,0">
                    <CheckBox x:Name="HideOnFullscreenCheck"
                              Content="{x:Static res:Strings.HideOnFullscreenCheckbox}"
                              Foreground="#EDE7DC" Background="#2A261F" FontSize="13"
                              Style="{StaticResource AppCheckBoxStyle}"
                              Click="OnHideOnFullscreenToggled" />
                    <TextBlock Text="{x:Static res:Strings.HideOnFullscreenHint}"
                               Foreground="#8A8175" FontSize="11" TextWrapping="Wrap" Margin="27,6,0,0" />
                </StackPanel>

                <Border Background="#3C3730" Height="1" Margin="0,20,0,0" />

                <StackPanel Margin="0,20,0,0">
                    <CheckBox x:Name="KeepDockOpenCheck"
                              Content="{x:Static res:Strings.KeepDockOpenCheckbox}"
                              Foreground="#EDE7DC" Background="#2A261F" FontSize="13"
                              Style="{StaticResource AppCheckBoxStyle}"
                              Click="OnKeepDockOpenToggled" />
                    <TextBlock Text="{x:Static res:Strings.KeepDockOpenHint}"
                               Foreground="#8A8175" FontSize="11" TextWrapping="Wrap" Margin="27,6,0,0" />
                </StackPanel>

                <StackPanel Margin="0,20,0,0">
                    <CheckBox x:Name="RememberPositionsCheck"
                              Content="{x:Static res:Strings.RememberPositionsCheckbox}"
                              Foreground="#EDE7DC" Background="#2A261F" FontSize="13"
                              Style="{StaticResource AppCheckBoxStyle}"
                              Click="OnRememberPositionsToggled" />
                    <TextBlock Text="{x:Static res:Strings.RememberPositionsHint}"
                               Foreground="#8A8175" FontSize="11" TextWrapping="Wrap" Margin="27,6,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Background="#3C3730" Height="1" Margin="24,20,24,0" />

        <StackPanel Margin="24,20,24,0">
            <TextBlock Text="{x:Static res:Strings.QuickHelpTitle}"
                       Foreground="#EDE7DC" FontSize="13" FontWeight="SemiBold" />
            <TextBlock x:Name="QuickHelpText"
                       Foreground="#8A8175" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18" />
        </StackPanel>

        <Border Background="#3C3730" Height="1" Margin="24,20,24,0" />

        <Grid Margin="24,16,24,0">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.ApplicationSectionTitle}"
                           Foreground="#EDE7DC" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static app:AppInfo.DisplayVersion}"
                           Foreground="#8A8175" FontSize="11" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="{x:Static res:Strings.RestartApplicationButton}"
                        Padding="12,7" Click="OnRestartClick"
                        ToolTip="{x:Static res:Strings.RestartAppTooltip}"
                        Style="{StaticResource RecordButtonStyle}" />
                <Button Content="{x:Static res:Strings.ExitApplicationButton}"
                        Margin="8,0,0,0" Padding="12,7" Click="OnExitClick"
                        ToolTip="{x:Static res:Strings.ExitAppTooltip}"
                        Style="{StaticResource RecordButtonStyle}" />
            </StackPanel>
        </Grid>
    </StackPanel>
    </ScrollViewer>
</Window>
