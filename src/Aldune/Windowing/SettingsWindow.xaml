<Window x:Class="Aldune.Windowing.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aldune.Windowing"
        xmlns:app="clr-namespace:Aldune"
        xmlns:res="clr-namespace:Aldune.Resources"
        Title="{x:Static res:Strings.SettingsWindowTitle}"
        Width="900" Height="700" MinWidth="720" MinHeight="460"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        Background="{DynamicResource AlduneGroundBrush}"
        Topmost="True"
        StateChanged="OnWindowStateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Interruptor al estilo de Configuración de Windows 11: la etiqueta a la izquierda y el
             interruptor a la derecha, para los sí/no. Las tarjetas se quedan para elegir una opción
             entre varias (monitor, borde, aspecto, idioma). Sigue siendo un CheckBox: el código de
             detrás lee IsChecked y Click igual que antes. Foreground pinta el interruptor encendido y
             Background el pomo, como hacía la casilla. -->
        <Style x:Key="SettingsSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Border x:Name="Track" Grid.Column="1" Width="38" Height="20" CornerRadius="10"
                                    BorderBrush="{TemplateBinding Foreground}" BorderThickness="1.5"
                                    Background="Transparent" VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Width="10" Height="10" Margin="4,0"
                                         Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecordButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource AlduneRaisedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AlduneRadius6}">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- Relieve de la piel Bevel; con las demás no dibuja nada. -->
                            <local:BevelEdge OnlyWhenSquare="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AlduneTextFaintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerRecordButtonStyle" TargetType="Button" BasedOn="{StaticResource RecordButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AlduneDangerBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AlduneOnDangerBgBrush}" />
        </Style>

        <Style x:Key="SyncProfileComboStyle" TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}" />
        <Style x:Key="SyncProfileItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItemStyle}" />

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource AlduneRadius6}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Sobre la barra en degradado (XP) los botones llevan el texto de la barra. -->
                <DataTrigger Binding="{Binding GradientTitleBar, Source={x:Static local:SkinState.Current}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AlduneOnTitleBarBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Chip compacto para el plazo (minutos/horas/dias/semanas): las tarjetas de
             MonitorRadioStyle son demasiado altas para cuatro opciones de una sola palabra en fila.
             Mismo patron que FilterToggleStyle del gestor de notas. -->
        <Style x:Key="DelayUnitToggleStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource AlduneMutedTextBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource AlduneRadius5}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AlduneTextStrongBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonitorRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{DynamicResource AlduneSurfaceBrush}" CornerRadius="{DynamicResource AlduneRadius6}" Padding="12,9" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Radio literal: con esquinas rectas un botón de opción cuadrado se leería como casilla. -->
                                <Border x:Name="DotOuter" Width="16" Height="16" CornerRadius="8"
                                        BorderBrush="{DynamicResource AlduneTextFaintBrush}" BorderThickness="1.5"
                                        VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Ellipse x:Name="DotInner" Width="8" Height="8" Fill="{DynamicResource AlduneTextBrush}"
                                             Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneRaisedHoverBrush}" />
                                <Setter TargetName="DotOuter" Property="BorderBrush" Value="{DynamicResource AlduneTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneSelectedBrush}" />
                                <Setter TargetName="DotOuter" Property="BorderBrush" Value="{DynamicResource AlduneTextBrush}" />
                                <Setter TargetName="DotInner" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Entradas del menú lateral: la seleccionada con el fondo de las tarjetas elegidas. -->
        <Style x:Key="SettingsNavStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextSoftBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource AlduneRadius6}" Padding="12,8" Margin="0,0,0,2">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneSelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AlduneTextStrongBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Menú lateral con páginas en vez de dos columnas con scroll: con todo junto la ventana
         medía 920x2150 y en una pantalla de 1440 de alto había que desplazarse para casi todo, con la
         columna izquierda el doble de alta que la derecha. Con páginas el tamaño es fijo (y con tope
         contra la pantalla, ver AppCoordinator.OpenSettings) y cada una cabe o casi. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- CaptionHeight cubre esta franja, asi que la ventana se arrastra desde aqui. Fondo de la
             barra de la piel: transparente en la de siempre. -->
        <Border x:Name="TitleBarStrip" Background="{DynamicResource AlduneTitleBarFill}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Padding" Value="24,18,14,0" />
                    <Style.Triggers>
                        <!-- Con barra en degradado (XP) la cabecera es una barra de título de verdad:
                             compacta, de borde a borde y con el texto de la barra. -->
                        <DataTrigger Binding="{Binding GradientTitleBar, Source={x:Static local:SkinState.Current}}" Value="True">
                            <Setter Property="Padding" Value="12,6,8,6" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <TextBlock Text="{x:Static res:Strings.SettingsHeader}" Foreground="{DynamicResource AlduneOnTitleBarBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="17" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GradientTitleBar, Source={x:Static local:SkinState.Current}}" Value="True">
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="&#x2014;" Width="28" Height="28"
                            ToolTip="{x:Static res:Strings.MinimizeWindowTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.MinimizeWindowTooltip}"
                            Click="OnMinimizeClick"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource CloseButtonStyle}" />
                    <Button x:Name="MaximizeButton" Width="28" Height="28"
                            ToolTip="{x:Static res:Strings.MaximizeWindowTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.MaximizeWindowTooltip}"
                            Click="OnMaximizeClick"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource CloseButtonStyle}">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{StaticResource AlduneTextSmall}" />
                    </Button>
                    <Button Content="&#x2715;" Width="28" Height="28"
                            ToolTip="{x:Static res:Strings.CloseTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.CloseTooltip}"
                            Click="OnCloseClick"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource CloseButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="14,0,12,18" LastChildFill="False">
                <!-- El gestor sigue siendo su propia ventana (se usa a diario; Ajustes, poco), pero a
                     un clic desde aquí, igual que el gestor tiene su botón a Ajustes. -->
                <Button DockPanel.Dock="Bottom" Content="{x:Static res:Strings.TrayManageNotes}"
                        Click="OnManageNotesClick" Padding="10,7" HorizontalAlignment="Stretch"
                        Style="{StaticResource RecordButtonStyle}" />
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavGeneral" Tag="General" GroupName="SettingsNav"
                                 Content="{x:Static res:Strings.SettingsPageGeneral}"
                                 Style="{StaticResource SettingsNavStyle}" Checked="OnPageChecked" />
                    <RadioButton x:Name="NavNotes" Tag="Notes" GroupName="SettingsNav"
                                 Content="{x:Static res:Strings.SettingsPageNotes}"
                                 Style="{StaticResource SettingsNavStyle}" Checked="OnPageChecked" />
                    <RadioButton x:Name="NavDock" Tag="Dock" GroupName="SettingsNav"
                                 Content="{x:Static res:Strings.SettingsPageDock}"
                                 Style="{StaticResource SettingsNavStyle}" Checked="OnPageChecked" />
                    <RadioButton x:Name="NavColors" Tag="Colors" GroupName="SettingsNav"
                                 Content="{x:Static res:Strings.SettingsPageColors}"
                                 Style="{StaticResource SettingsNavStyle}" Checked="OnPageChecked" />
                    <RadioButton x:Name="NavSync" Tag="Sync" GroupName="SettingsNav"
                                 Content="{x:Static res:Strings.SettingsPageSync}"
                                 Style="{StaticResource SettingsNavStyle}" Checked="OnPageChecked" />
                    <RadioButton x:Name="NavHelp" Tag="Help" GroupName="SettingsNav"
                                 Content="{x:Static res:Strings.SettingsPageHelp}"
                                 Style="{StaticResource SettingsNavStyle}" Checked="OnPageChecked" />
                    <RadioButton x:Name="NavAbout" Tag="About" GroupName="SettingsNav"
                                 Content="{x:Static res:Strings.SettingsPageAbout}"
                                 Style="{StaticResource SettingsNavStyle}" Checked="OnPageChecked" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Column="1" Background="{DynamicResource AlduneRaisedBrush}" Width="1" HorizontalAlignment="Left" Margin="0,0,0,18" />

            <ScrollViewer x:Name="PageScroller" Grid.Column="1" Margin="1,0,0,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="28,0,28,24">
                <StackPanel x:Name="GeneralPage" Visibility="Collapsed">
                    <TextBlock Text="{x:Static res:Strings.SettingsPageGeneral}" Foreground="{DynamicResource AlduneTextStrongBrush}" FontSize="{StaticResource AlduneTextTitle}" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <Border x:Name="InterfaceModePanel" Margin="0,0,0,0"
                            Background="{DynamicResource AlduneSurfaceBrush}" CornerRadius="{DynamicResource AlduneRadius8}" Padding="12">
                        <!-- Columnas, no un margen fijo: el botón mide distinto en cada idioma
                             ("Vereinfachten Modus verwenden" tapaba el texto en alemán). -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{x:Static res:Strings.InterfaceModeSectionTitle}"
                                           Foreground="{DynamicResource AlduneTextBrush}" FontSize="{StaticResource AlduneTextBody}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Static res:Strings.InterfaceModeHint}"
                                           Foreground="{DynamicResource AlduneMutedTextBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button x:Name="InterfaceModeButton" Grid.Column="1"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Padding="12,7" Click="OnInterfaceModeClick"
                                    Style="{StaticResource RecordButtonStyle}" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="0,20,0,0">
                        <CheckBox x:Name="StartupCheck"
                                  Content="{x:Static res:Strings.StartupCheckbox}"
                                  Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{StaticResource AlduneTextBody}"
                                  Style="{StaticResource SettingsSwitchStyle}"
                                  Click="OnStartupToggled" />
                        <TextBlock Text="{x:Static res:Strings.StartupHint}"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,6,56,0" />
                    </StackPanel>
                    <Border Background="{DynamicResource AlduneRaisedBrush}" Height="1" Margin="0,20,0,0" />
                    <StackPanel Margin="0,20,0,0">
                        <CheckBox x:Name="HotkeyCheck"
                                  Content="{x:Static res:Strings.HotkeyCheckbox}"
                                  Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{StaticResource AlduneTextBody}"
                                  Style="{StaticResource SettingsSwitchStyle}"
                                  Click="OnHotkeyToggled" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <!-- Un boton que captura la siguiente combinacion, no una lista de teclas:
                                 escoger modificador y tecla en dos desplegables obliga a traducir
                                 mentalmente lo que uno ya sabe pulsar. -->
                            <Button x:Name="HotkeyButton" Click="OnRecordHotkeyClick"
                                    MinWidth="150" Padding="12,7"
                                    Style="{StaticResource RecordButtonStyle}" />
                            <Button x:Name="HotkeyResetButton" Content="{x:Static res:Strings.HotkeyResetButton}" Click="OnResetHotkeyClick"
                                    Margin="8,0,0,0" Padding="12,7"
                                    Style="{StaticResource RecordButtonStyle}" />
                        </StackPanel>

                        <TextBlock x:Name="HotkeyHint"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,10,56,0" />
                    </StackPanel>
                    <StackPanel Margin="0,20,0,0">
                        <CheckBox x:Name="RecentHotkeyCheck"
                                  Content="{x:Static res:Strings.RecentNoteHotkeyCheckbox}"
                                  Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{StaticResource AlduneTextBody}"
                                  Style="{StaticResource SettingsSwitchStyle}"
                                  Click="OnRecentHotkeyToggled" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="RecentHotkeyButton" Click="OnRecordRecentHotkeyClick"
                                    MinWidth="150" Padding="12,7"
                                    Style="{StaticResource RecordButtonStyle}" />
                            <Button x:Name="RecentHotkeyResetButton" Content="{x:Static res:Strings.HotkeyResetButton}" Click="OnResetRecentHotkeyClick"
                                    Margin="8,0,0,0" Padding="12,7"
                                    Style="{StaticResource RecordButtonStyle}" />
                        </StackPanel>

                        <TextBlock x:Name="RecentHotkeyHint"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,10,56,0" />
                    </StackPanel>
                    <Border Background="{DynamicResource AlduneRaisedBrush}" Height="1" Margin="0,20,0,0" />
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="{x:Static res:Strings.AppearanceSectionTitle}"
                                   Foreground="{DynamicResource AlduneTextBrush}" FontSize="{StaticResource AlduneTextBody}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static res:Strings.AppearanceSectionHint}"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <StackPanel x:Name="AppearanceListContainer" />
                        <!-- Colores del aspecto elegido (solo los retro tienen): cada hueco con su muestra,
                             su valor, muestras de un clic y "Elegir color…"; paletas de bash; restablecer. -->
                        <StackPanel x:Name="AspectColorsContainer" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,14,0,0">
                        <CheckBox x:Name="SquareCornersCheck"
                                  Content="{x:Static res:Strings.AppearanceSquareCorners}"
                                  Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{StaticResource AlduneTextBody}"
                                  Style="{StaticResource SettingsSwitchStyle}" Margin="0,0,0,10"
                                  Click="OnSquareCornersToggled" />
                        <CheckBox x:Name="SyncSignalCheck"
                                  Content="{x:Static res:Strings.AppearanceSyncSignal}"
                                  Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{StaticResource AlduneTextBody}"
                                  Style="{StaticResource SettingsSwitchStyle}" Margin="0,0,0,10"
                                  Click="OnSyncSignalToggled" />
                        <CheckBox x:Name="UniformColorCheck"
                                  Content="{x:Static res:Strings.AppearanceUniformColor}"
                                  Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{StaticResource AlduneTextBody}"
                                  Style="{StaticResource SettingsSwitchStyle}"
                                  Click="OnUniformColorToggled" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border x:Name="UniformColorSwatch" Width="22" Height="16" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource AlduneBorderBrush}" BorderThickness="1" />
                            <Button x:Name="UniformColorButton" Content="{x:Static res:Strings.AppearanceUniformColorPick}"
                                    Click="OnPickUniformColorClick" Margin="8,0,0,0" Padding="12,7"
                                    Style="{StaticResource RecordButtonStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="UniformSwatches" Margin="0,8,0,0" />
                        <TextBlock Text="{x:Static res:Strings.AppearanceUniformColorHint}"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,6,56,0" />
                    </StackPanel>
                    <Border Background="{DynamicResource AlduneRaisedBrush}" Height="1" Margin="0,20,0,0" />
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="{x:Static res:Strings.LanguageSectionTitle}"
                                   Foreground="{DynamicResource AlduneTextBrush}" FontSize="{StaticResource AlduneTextBody}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static res:Strings.LanguageSectionHint}"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,4,0,10" />

                        <StackPanel x:Name="LanguageListContainer" />
                    </StackPanel>
                    <Border Background="{DynamicResource AlduneRaisedBrush}" Height="1" Margin="0,20,0,0" />
                    <StackPanel Margin="0,20,0,0">
                        <CheckBox x:Name="SoundsEnabledCheck"
                                  Content="{x:Static res:Strings.SoundsEnabledCheckbox}"
                                  Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{StaticResource AlduneTextBody}"
                                  Style="{StaticResource SettingsSwitchStyle}"
                                  Click="OnSoundsEnabledToggled" />
                        <TextBlock Text="{x:Static res:Strings.SoundsHint}"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,6,56,0" />
                        <!-- Una fila por evento (la rellena BuildSoundRows): sonido propio o ninguno, con "Probar". -->
                        <StackPanel x:Name="SoundRowsPanel" Margin="0,12,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="NotesPage" Visibility="Collapsed">
                    <TextBlock Text="{x:Static res:Strings.SettingsPageNotes}" Foreground="{DynamicResource AlduneTextStrongBrush}" FontSize="{StaticResource AlduneTextTitle}" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <StackPanel>
                        <CheckBox x:Name="RememberPositionsCheck"
                                  Content="{x:Static res:Strings.RememberPositionsCheckbox}"
                                  Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{StaticResource AlduneTextBody}"
                                  Style="{StaticResource SettingsSwitchStyle}"
                                  Click="OnRememberPositionsToggled" />
                        <TextBlock Text="{x:Static res:Strings.RememberPositionsHint}"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,6,56,0" />
                    </StackPanel>
                    <Border Background="{DynamicResource AlduneRaisedBrush}" Height="1" Margin="0,20,0,0" />
                    <StackPanel Margin="0,20,0,0">
                        <CheckBox x:Name="MoveCompletedTasksCheck"
                                  Content="{x:Static res:Strings.MoveCompletedTasksCheckbox}"
                                  Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{StaticResource AlduneTextBody}"
                                  Style="{StaticResource SettingsSwitchStyle}"
                                  Click="OnMoveCompletedTasksToggled" />
                        <TextBlock Text="{x:Static res:Strings.MoveCompletedTasksHint}"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,6,56,16" />

                        <CheckBox x:Name="AutoHideTasksCheck"
                                  Content="{x:Static res:Strings.AutoHideCompletedTasksCheckbox}"
                                  Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{StaticResource AlduneTextBody}"
                                  Style="{StaticResource SettingsSwitchStyle}"
                                  Click="OnAutoHideTasksToggled" />
                        <TextBlock Text="{x:Static res:Strings.AutoHideCompletedTasksHint}"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,6,56,0" />

                        <StackPanel x:Name="AutoHideTasksDelayPanel" Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{x:Static res:Strings.AutoHideCompletedTasksDelayLabel}"
                                       Foreground="{DynamicResource AlduneTextBrush}" FontSize="{StaticResource AlduneTextBody}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <!-- Numero + unidad, no un desplegable fijo de "1 dia/1 semana": el usuario
                                 pidio poder elegir cualquier plazo, no solo unos pocos preajustados. -->
                            <Border Background="{DynamicResource AlduneSurfaceBrush}" CornerRadius="{DynamicResource AlduneRadius6}" VerticalAlignment="Center">
                                <TextBox x:Name="AutoHideTasksDelayValueBox"
                                         Background="Transparent" Foreground="{DynamicResource AlduneTextBrush}" CaretBrush="{DynamicResource AlduneTextBrush}"
                                         BorderThickness="0" FontSize="{StaticResource AlduneTextBody}" Width="30" MaxLength="3"
                                         TextAlignment="Center" Padding="6,6"
                                         PreviewTextInput="OnDelayValuePreviewTextInput"
                                         TextChanged="OnDelayValueChanged" />
                            </Border>
                            <Border Background="{DynamicResource AlduneSurfaceBrush}" CornerRadius="{DynamicResource AlduneRadius7}" Padding="3" Margin="8,0,0,0" VerticalAlignment="Center">
                                <WrapPanel x:Name="DelayUnitContainer" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="{DynamicResource AlduneRaisedBrush}" Height="1" Margin="0,20,0,0" />
                    <!-- Antes una constante fija en el código (NotesRepository.DefaultTrashRetentionDays);
                         no hay ningún motivo para que 30 sea mejor que otro número para todo el mundo,
                         así que pasa a ser elegible aquí, igual que el plazo de arriba. -->
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="{x:Static res:Strings.TrashRetentionTitle}"
                                   Foreground="{DynamicResource AlduneTextBrush}" FontSize="{StaticResource AlduneTextBody}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static res:Strings.TrashRetentionHint}"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,4,0,10" />

                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource AlduneSurfaceBrush}" CornerRadius="{DynamicResource AlduneRadius6}" VerticalAlignment="Center">
                                <TextBox x:Name="TrashRetentionValueBox"
                                         Background="Transparent" Foreground="{DynamicResource AlduneTextBrush}" CaretBrush="{DynamicResource AlduneTextBrush}"
                                         BorderThickness="0" FontSize="{StaticResource AlduneTextBody}" Width="30" MaxLength="3"
                                         TextAlignment="Center" Padding="6,6"
                                         PreviewTextInput="OnTrashRetentionPreviewTextInput"
                                         TextChanged="OnTrashRetentionChanged" />
                            </Border>
                            <TextBlock Text="{x:Static res:Strings.TrashRetentionDaysUnit}"
                                       Foreground="{DynamicResource AlduneTextBrush}" FontSize="{StaticResource AlduneTextBody}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="DockPage" Visibility="Collapsed">
                    <TextBlock Text="{x:Static res:Strings.SettingsPageDock}" Foreground="{DynamicResource AlduneTextStrongBrush}" FontSize="{StaticResource AlduneTextTitle}" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <!-- Pantalla y borde lado a lado: son dos listas cortas de tarjetas y una encima de
                         otra obligaban a desplazarse para llegar al resto de la página. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.MonitorSectionTitle}"
                                       Foreground="{DynamicResource AlduneTextBrush}" FontSize="{StaticResource AlduneTextBody}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Static res:Strings.MonitorSectionHint}"
                                       Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,4,0,10" />

                            <StackPanel x:Name="MonitorListContainer" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Static res:Strings.EdgeSectionTitle}"
                                       Foreground="{DynamicResource AlduneTextBrush}" FontSize="{StaticResource AlduneTextBody}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Static res:Strings.EdgeSectionHint}"
                                       Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,4,0,10" />

                            <StackPanel x:Name="EdgeListContainer" />
                        </StackPanel>
                    </Grid>
                    <Border Background="{DynamicResource AlduneRaisedBrush}" Height="1" Margin="0,20,0,0" />
                    <StackPanel Margin="0,20,0,0">
                        <CheckBox x:Name="ShowNotePreviewCheck"
                                  Content="{x:Static res:Strings.ShowNotePreviewCheckbox}"
                                  Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{StaticResource AlduneTextBody}"
                                  Style="{StaticResource SettingsSwitchStyle}"
                                  Click="OnShowNotePreviewToggled" />
                        <TextBlock Text="{x:Static res:Strings.ShowNotePreviewHint}"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,6,56,0" />
                    </StackPanel>
                    <StackPanel Margin="0,20,0,0">
                        <CheckBox x:Name="ReminderIncludesTasksCheck"
                                  Content="{x:Static res:Strings.ReminderIncludeTasksCheckbox}"
                                  Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{StaticResource AlduneTextBody}"
                                  Style="{StaticResource SettingsSwitchStyle}"
                                  Click="OnReminderIncludesTasksToggled" />
                        <TextBlock Text="{x:Static res:Strings.ReminderIncludeTasksHint}"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,6,56,0" />
                    </StackPanel>
                    <!-- Lo que el modo simplificado esconde de esta página. -->
                    <StackPanel x:Name="DockAdvancedPanel">
                        <Border Background="{DynamicResource AlduneRaisedBrush}" Height="1" Margin="0,20,0,0" />
                        <StackPanel Margin="0,20,0,0">
                            <CheckBox x:Name="HideOnFullscreenCheck"
                                      Content="{x:Static res:Strings.HideOnFullscreenCheckbox}"
                                      Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{StaticResource AlduneTextBody}"
                                      Style="{StaticResource SettingsSwitchStyle}"
                                      Click="OnHideOnFullscreenToggled" />
                            <TextBlock Text="{x:Static res:Strings.HideOnFullscreenHint}"
                                       Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,6,56,0" />
                        </StackPanel>
                        <Border Background="{DynamicResource AlduneRaisedBrush}" Height="1" Margin="0,20,0,0" />
                        <StackPanel Margin="0,20,0,0">
                            <CheckBox x:Name="KeepDockOpenCheck"
                                      Content="{x:Static res:Strings.KeepDockOpenCheckbox}"
                                      Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{StaticResource AlduneTextBody}"
                                      Style="{StaticResource SettingsSwitchStyle}"
                                      Click="OnKeepDockOpenToggled" />
                            <TextBlock Text="{x:Static res:Strings.KeepDockOpenHint}"
                                       Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,6,56,0" />
                        </StackPanel>
                        <Border Background="{DynamicResource AlduneRaisedBrush}" Height="1" Margin="0,20,0,0" />
                        <StackPanel Margin="0,20,0,0">
                            <CheckBox x:Name="TrackpadGesturesCheck"
                                      Content="{x:Static res:Strings.TrackpadGesturesCheckbox}"
                                      Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{StaticResource AlduneTextBody}"
                                      Style="{StaticResource SettingsSwitchStyle}"
                                      Click="OnTrackpadGesturesToggled" />
                            <TextBlock x:Name="TrackpadGesturesHint"
                                       Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,6,56,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="ColorsPage" Visibility="Collapsed">
                    <TextBlock Text="{x:Static res:Strings.SettingsPageColors}" Foreground="{DynamicResource AlduneTextStrongBrush}" FontSize="{StaticResource AlduneTextTitle}" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.ThemesSectionTitle}"
                                   Foreground="{DynamicResource AlduneTextBrush}" FontSize="{StaticResource AlduneTextBody}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static res:Strings.ThemesSectionHint}"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,4,0,10" />

                        <ComboBox x:Name="ThemeCombo" Style="{StaticResource SyncProfileComboStyle}"
                                  SelectionChanged="OnThemeSelectionChanged" />
                        <StackPanel x:Name="ThemePreview" Margin="0,8,0,0" IsHitTestVisible="False" />

                        <StackPanel x:Name="ThemeAdvancedPanel">
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="{x:Static res:Strings.ThemeNew}" Click="OnThemeNewClick"
                                    Padding="10,6" Margin="0,0,6,6" Style="{StaticResource RecordButtonStyle}" />
                            <Button Content="{x:Static res:Strings.ThemeDuplicate}" Click="OnThemeDuplicateClick"
                                    Padding="10,6" Margin="0,0,6,6" Style="{StaticResource RecordButtonStyle}" />
                            <Button x:Name="ThemeEditButton" Content="{x:Static res:Strings.ThemeEdit}" Click="OnThemeEditClick"
                                    Padding="10,6" Margin="0,0,6,6" Style="{StaticResource RecordButtonStyle}" />
                            <Button x:Name="ThemeDeleteButton" Content="{x:Static res:Strings.ThemeDeleteButton}" Click="OnThemeDeleteClick"
                                    Padding="10,6" Margin="0,0,6,6" Style="{StaticResource RecordButtonStyle}" />
                        </WrapPanel>

                        <TextBlock Text="{x:Static res:Strings.NewNoteToneLabel}"
                                   Foreground="{DynamicResource AlduneTextBrush}" FontSize="{StaticResource AlduneTextBody}" Margin="0,12,0,6" />
                        <StackPanel x:Name="ToneListContainer" />

                        <TextBlock Text="{x:Static res:Strings.ColorAssignmentLabel}"
                                   Foreground="{DynamicResource AlduneTextBrush}" FontSize="{StaticResource AlduneTextBody}" Margin="0,12,0,6" />
                        <StackPanel x:Name="AssignmentListContainer" />
                        <StackPanel x:Name="FixedColorSwatches" Margin="22,4,0,0" />

                        <Button x:Name="ApplyThemeButton" Content="{x:Static res:Strings.ApplyThemeButton}" Click="OnApplyThemeClick"
                                HorizontalAlignment="Left" Padding="12,7" Margin="0,14,0,0"
                                Style="{StaticResource RecordButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="SyncPage" Visibility="Collapsed">
                    <TextBlock Text="{x:Static res:Strings.SettingsPageSync}" Foreground="{DynamicResource AlduneTextStrongBrush}" FontSize="{StaticResource AlduneTextTitle}" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.SyncSectionHint}"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.SyncProfileLabel}" Foreground="{DynamicResource AlduneTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border x:Name="SyncProfileNameDisplay" Grid.Column="1" Background="{DynamicResource AlduneSurfaceBrush}"
                                    CornerRadius="{DynamicResource AlduneRadius6}" Padding="7,5">
                                <TextBlock x:Name="SyncProfileNameDisplayText" Foreground="{DynamicResource AlduneTextBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                            <ComboBox x:Name="SyncProfileBox" Grid.Column="1"
                                      Style="{StaticResource SyncProfileComboStyle}"
                                      ItemContainerStyle="{StaticResource SyncProfileItemStyle}"
                                      SelectionChanged="OnSyncProfileChanged" />
                            <Button x:Name="SyncNewProfileButton" Grid.Column="2"
                                    Content="{x:Static res:Strings.SyncNewProfile}" Click="OnSyncNewProfileClick"
                                    Margin="6,0,0,0" Padding="8,5" Style="{StaticResource RecordButtonStyle}" />
                            <Button x:Name="SyncDeleteProfileButton" Grid.Column="3"
                                    Content="{x:Static res:Strings.SyncDeleteProfile}" Click="OnSyncDeleteProfileClick"
                                    Margin="6,0,0,0" Padding="8,5" Style="{StaticResource RecordButtonStyle}" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.SyncProfileNameLabel}" Foreground="{DynamicResource AlduneHintBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="SyncProfileNameBox" Grid.Column="1"
                                     Background="{DynamicResource AlduneSurfaceBrush}" Foreground="{DynamicResource AlduneTextBrush}" BorderThickness="0"
                                     Padding="7,5" LostFocus="OnSyncProfileNameLostFocus" />
                        </Grid>
                        <CheckBox x:Name="SyncEnabledCheck"
                                  Content="{x:Static res:Strings.SyncEnabledCheckbox}"
                                  Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{StaticResource AlduneTextBody}"
                                  Style="{StaticResource SettingsSwitchStyle}"
                                  Click="OnSyncEnabledToggled" />
                        <TextBlock Text="{x:Static res:Strings.SyncScopeHint}" Foreground="{DynamicResource AlduneHintBrush}"
                                   FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,8,56,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <RadioButton x:Name="SyncAllNotesRadio" Content="{x:Static res:Strings.SyncScopeAll}"
                                         GroupName="SyncScope" Tag="AllNotes"
                                         Style="{StaticResource DelayUnitToggleStyle}"
                                         Checked="OnSyncScopeChanged" />
                            <RadioButton x:Name="SyncSelectedNotesRadio" Content="{x:Static res:Strings.SyncScopeSelected}"
                                         GroupName="SyncScope" Tag="SelectedNotes" Margin="4,0,0,0"
                                         Style="{StaticResource DelayUnitToggleStyle}"
                                         Checked="OnSyncScopeChanged" />
                            <RadioButton x:Name="SyncTagRadio" Content="{x:Static res:Strings.SyncScopeTag}"
                                         GroupName="SyncScope" Tag="Tag" Margin="4,0,0,0"
                                         Style="{StaticResource DelayUnitToggleStyle}"
                                         Checked="OnSyncScopeChanged" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <Button x:Name="SyncChooseNotesButton" Content="{x:Static res:Strings.SyncChooseNotes}"
                                    Click="OnSyncChooseNotesClick" Padding="10,6"
                                    Style="{StaticResource RecordButtonStyle}" />
                            <TextBlock x:Name="SyncSelectionSummary" Foreground="{DynamicResource AlduneHintBrush}"
                                       FontSize="{StaticResource AlduneTextSmall}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <ComboBox x:Name="SyncTagBox" Width="150" Height="30" Margin="10,0,0,0"
                                      Style="{StaticResource SyncProfileComboStyle}"
                                      SelectionChanged="OnSyncTagChanged" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <RadioButton x:Name="SyncFolderRadio" Content="{x:Static res:Strings.SyncFolderOption}"
                                         GroupName="SyncProvider" Tag="Folder"
                                         Style="{StaticResource DelayUnitToggleStyle}"
                                         Checked="OnSyncProviderChanged" />
                            <RadioButton x:Name="SyncServerRadio" Content="{x:Static res:Strings.SyncServerOption}"
                                         GroupName="SyncProvider" Tag="Server" Margin="4,0,0,0"
                                         Style="{StaticResource DelayUnitToggleStyle}"
                                         Checked="OnSyncProviderChanged" />
                            <RadioButton x:Name="SyncWebDavRadio" Content="{x:Static res:Strings.SyncWebDavOption}"
                                         GroupName="SyncProvider" Tag="WebDav" Margin="4,0,0,0"
                                         Style="{StaticResource DelayUnitToggleStyle}"
                                         Checked="OnSyncProviderChanged" />
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.SyncFolderLabel}" Foreground="{DynamicResource AlduneTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="SyncFolderPathBox" Grid.Column="1" MinWidth="130"
                                     Background="{DynamicResource AlduneSurfaceBrush}" Foreground="{DynamicResource AlduneTextBrush}" BorderThickness="0"
                                     Padding="7,6" TextChanged="OnSyncValueChanged" />
                            <Button x:Name="SyncBrowseButton" Grid.Column="2"
                                    Content="{x:Static res:Strings.SyncBrowseButton}" Click="OnSyncBrowseClick"
                                    Margin="8,0,0,0" Padding="10,6" Style="{StaticResource RecordButtonStyle}" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.SyncServerUrlLabel}" Foreground="{DynamicResource AlduneTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="SyncServerUrlBox" Grid.Column="1" MinWidth="130"
                                     Background="{DynamicResource AlduneSurfaceBrush}" Foreground="{DynamicResource AlduneTextBrush}" BorderThickness="0"
                                     Padding="7,6" TextChanged="OnSyncValueChanged" />
                        </Grid>
                        <!-- http:// hacia un servidor fuera de la red local: el token viajaría en claro.
                             Ver SyncEndpointSecurity. -->
                        <TextBlock x:Name="SyncInsecureUrlText" Text="{x:Static res:Strings.SyncInsecureUrlWarning}"
                                   Foreground="{DynamicResource AlduneErrorTextBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,4,56,0"
                                   Visibility="Collapsed" />
                        <Grid x:Name="SyncServerTokenGrid" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.SyncServerTokenLabel}" Foreground="{DynamicResource AlduneTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="SyncServerTokenBox" Grid.Column="1" MinWidth="130"
                                     Background="{DynamicResource AlduneSurfaceBrush}" Foreground="{DynamicResource AlduneTextBrush}" BorderThickness="0"
                                     Padding="7,6" LostFocus="OnSyncTokenLostFocus" />
                        </Grid>

                        <Grid x:Name="SyncWebDavUsernameGrid" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.SyncWebDavUsernameLabel}" Foreground="{DynamicResource AlduneTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="SyncWebDavUsernameBox" Grid.Column="1" MinWidth="130"
                                     Background="{DynamicResource AlduneSurfaceBrush}" Foreground="{DynamicResource AlduneTextBrush}" BorderThickness="0"
                                     Padding="7,6" LostFocus="OnSyncWebDavUsernameLostFocus" />
                        </Grid>
                        <Grid x:Name="SyncWebDavPasswordGrid" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.SyncWebDavPasswordLabel}" Foreground="{DynamicResource AlduneTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <PasswordBox x:Name="SyncWebDavPasswordBox" Grid.Column="1" MinWidth="130"
                                         Background="{DynamicResource AlduneSurfaceBrush}" Foreground="{DynamicResource AlduneTextBrush}" BorderThickness="0"
                                         Padding="7,6" LostFocus="OnSyncWebDavPasswordLostFocus" />
                        </Grid>
                        <TextBlock x:Name="SyncWebDavHintText" Text="{x:Static res:Strings.SyncWebDavHint}" Foreground="{DynamicResource AlduneHintBrush}"
                                   FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,4,56,0" />

                        <TextBlock Text="{x:Static res:Strings.SyncCodeLabel}" Foreground="{DynamicResource AlduneTextBrush}"
                                   Margin="0,12,0,0" />
                        <TextBox x:Name="SyncCodeBox" Margin="0,6,0,0"
                                 Background="{DynamicResource AlduneSurfaceBrush}" Foreground="{DynamicResource AlduneTextBrush}" BorderThickness="0"
                                 Padding="7,6" />
                        <TextBlock Text="{x:Static res:Strings.SyncCodeHint}" Foreground="{DynamicResource AlduneHintBrush}"
                                   FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,5,56,0" />
                        <TextBlock Text="{x:Static res:Strings.SyncShareCodeHint}" Foreground="{DynamicResource AlduneHintBrush}"
                                   FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,3,56,0" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="SyncGenerateCodeButton" Content="{x:Static res:Strings.SyncGenerateCodeButton}"
                                    Click="OnSyncGenerateCodeClick" Margin="0,0,7,6" Padding="10,6"
                                    Style="{StaticResource RecordButtonStyle}" />
                            <Button x:Name="SyncShareProfileButton" Content="{x:Static res:Strings.SyncShareProfileButton}"
                                    Click="OnSyncShareProfileClick" Margin="0,0,7,6" Padding="10,6"
                                    Style="{StaticResource RecordButtonStyle}" />
                            <Button x:Name="SyncRevokeAccessButton" Content="{x:Static res:Strings.SyncRevokeAccessButton}"
                                    Click="OnSyncRevokeAccessClick" Margin="0,0,7,6" Padding="10,6"
                                    Style="{StaticResource DangerRecordButtonStyle}" />
                            <Button x:Name="SyncImportCodeButton" Content="{x:Static res:Strings.SyncImportCodeButton}"
                                    Click="OnSyncImportCodeClick" Margin="0,0,7,6" Padding="10,6"
                                    Style="{StaticResource RecordButtonStyle}" />
                            <Button x:Name="SyncNowButton" Content="{x:Static res:Strings.SyncNowButton}"
                                    Click="OnSyncNowClick" Margin="0,0,7,6" Padding="10,6"
                                    Style="{StaticResource RecordButtonStyle}" />
                        </WrapPanel>
                        <TextBlock Text="{x:Static res:Strings.SyncRevokeAccessHint}" Foreground="{DynamicResource AlduneHintBrush}"
                                   FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,5,56,0" />
                        <TextBlock x:Name="SyncStatusText" Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}"
                                   TextWrapping="Wrap" Margin="0,8,56,0" />
                        <CheckBox x:Name="SyncAutomaticCheck"
                                  Content="{x:Static res:Strings.SyncAutomaticCheckbox}"
                                  Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{StaticResource AlduneTextBody}"
                                  Style="{StaticResource SettingsSwitchStyle}"
                                  Margin="0,12,0,0" Click="OnSyncAutomaticToggled" />
                        <TextBlock Text="{x:Static res:Strings.SyncAutomaticHint}" Foreground="{DynamicResource AlduneHintBrush}"
                                   FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,5,56,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{x:Static res:Strings.SyncIntervalLabel}" Foreground="{DynamicResource AlduneTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Background="{DynamicResource AlduneSurfaceBrush}" CornerRadius="{DynamicResource AlduneRadius6}">
                                <TextBox x:Name="SyncIntervalValueBox" Width="38" MaxLength="4"
                                         Background="Transparent" Foreground="{DynamicResource AlduneTextBrush}" CaretBrush="{DynamicResource AlduneTextBrush}"
                                         BorderThickness="0" Padding="6,5" TextAlignment="Center"
                                         PreviewTextInput="OnSyncIntervalPreviewTextInput"
                                         LostFocus="OnSyncIntervalLostFocus" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="SyncLastSyncText" Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}"
                                   Margin="0,7,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock x:Name="SyncConflictsText" Foreground="{DynamicResource AlduneAttentionBrush}" FontSize="{StaticResource AlduneTextSmall}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="SyncConflictsButton"
                                    Content="{x:Static res:Strings.SyncConflictsButton}"
                                    Click="OnSyncConflictsClick" Margin="10,0,0,0" Padding="9,5"
                                    Style="{StaticResource RecordButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="HelpPage" Visibility="Collapsed">
                    <TextBlock Text="{x:Static res:Strings.SettingsPageHelp}" Foreground="{DynamicResource AlduneTextStrongBrush}" FontSize="{StaticResource AlduneTextTitle}" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <TextBlock x:Name="QuickHelpText"
                               Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18" />
                </StackPanel>
                <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                    <TextBlock Text="{x:Static res:Strings.SettingsPageAbout}" Foreground="{DynamicResource AlduneTextStrongBrush}" FontSize="{StaticResource AlduneTextTitle}" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{x:Static app:AppInfo.DisplayVersion}"
                                       Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="{x:Static res:Strings.TrayCheckForUpdates}"
                                Padding="12,7" Click="OnCheckForUpdatesClick"
                                Style="{StaticResource RecordButtonStyle}" />
                            <Button Content="{x:Static res:Strings.RestartApplicationButton}"
                                Margin="8,0,0,0" Padding="12,7" Click="OnRestartClick"
                                    ToolTip="{x:Static res:Strings.RestartAppTooltip}"
                                    AutomationProperties.Name="{x:Static res:Strings.RestartAppTooltip}"
                                    Style="{StaticResource RecordButtonStyle}" />
                            <Button Content="{x:Static res:Strings.ExitApplicationButton}"
                                    Margin="8,0,0,0" Padding="12,7" Click="OnExitClick"
                                    ToolTip="{x:Static res:Strings.ExitAppTooltip}"
                                    AutomationProperties.Name="{x:Static res:Strings.ExitAppTooltip}"
                                    Style="{StaticResource RecordButtonStyle}" />
                        </StackPanel>
                    </Grid>
                    <Border Background="{DynamicResource AlduneRaisedBrush}" Height="1" Margin="0,20,0,0" />
                    <StackPanel Margin="0,20,0,0">
                        <CheckBox x:Name="CheckForUpdatesAutomaticallyCheck"
                                  Content="{x:Static res:Strings.CheckForUpdatesAutomaticallyCheckbox}"
                                  Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{StaticResource AlduneTextBody}"
                                  Style="{StaticResource SettingsSwitchStyle}"
                                  Click="OnCheckForUpdatesAutomaticallyToggled" />
                        <TextBlock Text="{x:Static res:Strings.CheckForUpdatesAutomaticallyHint}"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,6,56,0" />
                    </StackPanel>
                    <Border Background="{DynamicResource AlduneRaisedBrush}" Height="1" Margin="0,20,0,0" />
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="{x:Static res:Strings.ConfigSectionTitle}"
                                   Foreground="{DynamicResource AlduneTextBrush}" FontSize="{StaticResource AlduneTextBody}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static res:Strings.ConfigAboutHint}"
                                   Foreground="{DynamicResource AlduneHintBrush}" FontSize="{StaticResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="ExportConfigButton" Content="{x:Static res:Strings.ConfigExportButton}"
                                    Padding="12,7" Click="OnExportConfigClick"
                                    Style="{StaticResource RecordButtonStyle}" />
                            <Button x:Name="ImportConfigButton" Content="{x:Static res:Strings.ConfigImportButton}"
                                    Margin="8,0,0,0" Padding="12,7" Click="OnImportConfigClick"
                                    Style="{StaticResource RecordButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
