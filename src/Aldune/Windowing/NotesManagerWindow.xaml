<Window x:Class="Aldune.Windowing.NotesManagerWindow"
        KeyboardNavigation.TabNavigation="Cycle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aldune.Windowing"
        xmlns:res="clr-namespace:Aldune.Resources"
        Title="{x:Static res:Strings.ManageNotesTitle}"
        Width="900" Height="700"
        MinWidth="880" MinHeight="460"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{DynamicResource AlduneGroundBrush}"
        Topmost="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown"
        StateChanged="OnWindowStateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- The drawn thumb spans exactly the cards: it starts at the top of the first one and ends at the bottom of the last one. The thumb
             template keeps 2 px of air above and below its bar, so the track starts 2 px above the list, and it stops 8 px (the gap each row keeps
             under it) plus those 2 px before the bottom. -->
        <Thickness x:Key="ScrollBarMargin">0,-2,0,6</Thickness>
        <local:NoteTitleConverter x:Key="NoteTitleConverter" />
        <local:NoteLinkedConverter x:Key="NoteLinkedConverter" />
        <local:PinToTopTextConverter x:Key="PinToTopTextConverter" />
        <local:NoteRimConverter x:Key="NoteRimConverter" />
        <local:NoteDisplayColorConverter x:Key="NoteDisplayColorConverter" />
        <local:NoteLabelColorConverter x:Key="NoteLabelColorConverter" />
        <local:ManagerRowFaceConverter x:Key="ManagerRowFaceConverter" />
        <local:ManagerRowInkConverter x:Key="ManagerRowInkConverter" />
        <local:ManagerRowMutedInkConverter x:Key="ManagerRowMutedInkConverter" />
        <local:ManagerRowRimConverter x:Key="ManagerRowRimConverter" />
        <local:NoteFaceConverter x:Key="NoteFaceConverter" />
        <local:ManagerRowStripeVisibilityConverter x:Key="ManagerRowStripeVisibilityConverter" />
        <local:LeftCornersConverter x:Key="LeftCornersConverter" />
        <local:StripeWidthConverter x:Key="StripeWidthConverter" />
        <local:NoteSnippetConverter x:Key="NoteSnippetConverter" />
        <local:NoteDateConverter x:Key="NoteDateConverter" />

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <!-- Sin tamaño propio el botón heredaba el de la ventana (fijo) y no seguía a «Tamaño del texto»: los del pie se quedaban pequeños
                 mientras el resto del gestor crecía. -->
            <Setter Property="FontSize" Value="{DynamicResource AlduneTextCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource AlduneTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource AlduneRaisedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AlduneFocusVisual}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AlduneRadius6}">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <!-- Relieve de la piel Bevel; con las demás no dibuja nada. -->
                            <local:BevelEdge OnlyWhenSquare="True" EdgeThickness="2" ShadowOutside="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AldunePressedBrush}" />
                            </Trigger>
                            <!-- Sin nada seleccionado estas acciones no tienen sobre qué actuar.
                                 Antes seguían pulsables y no hacían nada, que es peor que decir
                                 que no se puede: el estado deshabilitado es la respuesta. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AlduneTextFaintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AlduneDangerBgBrush}" />
        </Style>

        <!-- La acción principal («Nueva nota»): acento de la app. Estaba en la cabecera, entre botones de ventana planos, y desentonaba en todos
             los aspectos; abajo a la derecha, con texto, se lee como lo que es. -->
        <Style x:Key="AccentToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AlduneAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AlduneOnAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <!-- Hover y pulsado con el acento más marcado (ToolbarButtonStyle los pone en gris, y el texto de acento sobre gris no se lee: contraste
                 1,5 a 2,5). OnAccent sobre AccentHover cumple 4,5 en todos los aspectos. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AlduneRadius6}">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <local:BevelEdge OnlyWhenSquare="True" EdgeThickness="2" ShadowOutside="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneAccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#1E1A14" />
            <Setter Property="FontSize" Value="{DynamicResource AlduneTextCaption}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AlduneFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AlduneTextDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="{DynamicResource AlduneTextBody}" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Botones de la cabecera: sobre la barra en degradado (XP) llevan el texto de la barra. El
             borrado de la búsqueda comparte CloseButtonStyle pero va sobre un campo claro, así que no. -->
        <!-- Los botones de ventana son planos aquí, en Ajustes y en las notas: sin el relieve de la piel Bevel (que seguía
             heredando de ToolbarButtonStyle y dejaba los de este gestor en cajas con sombra, distintas de las otras dos
             ventanas). El relieve queda para los botones de acción, como el «+». -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource CloseButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AlduneRadius6}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AldunePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding GradientTitleBar, Source={x:Static local:SkinState.Current}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AlduneOnTitleBarBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Barra de scroll fina y a juego con el fondo oscuro. La del sistema es clara y ancha, y
             sobre este fondo canta muchísimo. Esto es <b>teñir</b> una afordancia estándar, no
             reinventarla: conserva arrastre del pulgar, clic en la pista y rueda; solo cambia el
             color y el grosor. -->
        <!-- La barra de scroll fina y oscura vive ahora en App.xaml, para no repetirla en cada
             ventana que necesite scroll. -->

        <!-- Las casillas por defecto de WPF son un cuadrado claro con borde fino de otra epoca:
             sobre las filas de color y sobre el fondo oscuro cantan. Esta hereda Foreground, asi
             que la misma plantilla sirve para las filas (tinta sobre pastel) y para las de chrome
             (gris claro sobre fondo oscuro) sin duplicarla. -->
        <Style x:Key="AppCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AlduneFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="17" Height="17" CornerRadius="{DynamicResource AlduneRadius4}"
                                    BorderBrush="{TemplateBinding Foreground}"
                                    BorderThickness="1.5"
                                    Background="Transparent"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <!-- Marca y guion comparten sitio: uno u otro, nunca los dos. -->
                                    <TextBlock x:Name="Tick" Text="&#x2713;" FontSize="{DynamicResource AlduneTextCaption}"
                                               FontWeight="Bold"
                                               Foreground="{TemplateBinding Background}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                    <Border x:Name="Dash" Width="9" Height="2" CornerRadius="1"
                                            Background="{TemplateBinding Background}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <!-- Indeterminada: guion, no marca. Es lo que dice "algunas, no todas". -->
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Box" Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filtros como control segmentado: cuatro opciones excluyentes de un mismo eje se leen
             mejor juntas en una pastilla que como cuatro botones sueltos. -->
        <Style x:Key="FilterToggleStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource AlduneMutedTextBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="{DynamicResource AlduneTextCaption}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AlduneFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource AlduneRadius5}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AlduneHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AlduneTextStrongBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TagFilterStyle" TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}" />

        <!-- Las etiquetas de la fila son a la vez lo que se lee y el botón para cambiarlas: antes
             había un "Etiquetas…" idéntico en todas las filas y no se veía cuáles tenía cada nota. -->
        <Style x:Key="TagChipsButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AlduneFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource AlduneRadius5}" Padding="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#18000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Popup x:Name="TagEditorPopup" AllowsTransparency="True" Focusable="True" StaysOpen="False" Closed="OnTagEditorClosed"
               Placement="Bottom" PopupAnimation="Fade">
            <Border Background="{DynamicResource AldunePopupBrush}" BorderBrush="{DynamicResource AldunePressedBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource AlduneRadius7}" Padding="16,14">
                <local:TagAssignmentPanel x:Name="ManagerTagPanel" />
            </Border>
        </Popup>

        <!-- La casilla comparte fila con la lista y se ancla arriba; la lista lleva el margen
             superior que la deja pasar. Asi la casilla no roba una fila entera de alto. -->

        <!-- Cabecera. CaptionHeight cubre esta franja, así que la ventana se arrastra desde aquí. Fondo de la
             barra de la piel: transparente en la de siempre. -->
        <Border x:Name="TitleBarStrip" Grid.Row="0" Background="{DynamicResource AlduneTitleBarFill}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Padding" Value="20,18,14,0" />
                    <Style.Triggers>
                        <!-- Con barra en degradado (XP) la cabecera es una barra de título de verdad:
                             compacta, de borde a borde y con el texto de la barra. -->
                        <DataTrigger Binding="{Binding GradientTitleBar, Source={x:Static local:SkinState.Current}}" Value="True">
                            <Setter Property="Padding" Value="20,17,16,17" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <!-- En la barra XP, centrado como los botones de la ventana (alineado arriba quedaba alto). -->
                                <DataTrigger Binding="{Binding GradientTitleBar, Source={x:Static local:SkinState.Current}}" Value="True">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{x:Static res:Strings.ManageNotesTitle}" Foreground="{DynamicResource AlduneOnTitleBarBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="{DynamicResource AlduneTextHeading}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GradientTitleBar, Source={x:Static local:SkinState.Current}}" Value="True">
                                        <Setter Property="FontSize" Value="{DynamicResource AlduneTextBody}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="SubtitleText" FontSize="{DynamicResource AlduneTextSmall}" Margin="0,5,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource AlduneMutedTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GradientTitleBar, Source={x:Static local:SkinState.Current}}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AlduneOnTitleBarBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <!-- Acceso a Ajustes tambien desde aqui. Estaban solo en el clic derecho de la
                     bandeja, y ahi no los encontro el usuario: esta es la ventana que uno abre cuando
                     busca "donde se configura esto". -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="VerticalAlignment" Value="Top" />
                            <Style.Triggers>
                                <!-- En la barra XP la cabecera mide lo que sus dos líneas de texto (más que los botones): centrados, el hueco de arriba
                                     y el de abajo son iguales (antes 6 px arriba y 11 abajo). -->
                                <DataTrigger Binding="{Binding GradientTitleBar, Source={x:Static local:SkinState.Current}}" Value="True">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Width="28" Height="28"
                            ToolTip="{x:Static res:Strings.MinimizeWindowTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.MinimizeWindowTooltip}"
                            Click="OnMinimizeClick"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource TitleBarButtonStyle}">
                        <Border Width="10" Height="1" VerticalAlignment="Center" Margin="0,6,0,0"
                            UseLayoutRounding="True" SnapsToDevicePixels="True"
                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="MaximizeButton" Width="28" Height="28"
                            ToolTip="{x:Static res:Strings.MaximizeWindowTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.MaximizeWindowTooltip}"
                            Click="OnMaximizeClick"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource TitleBarButtonStyle}">
                        <local:MaximizeGlyph x:Name="MaximizeGlyph" Ink="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="SettingsButton"
                            Content="&#xE713;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            Width="28" Height="28"
                            ToolTip="{x:Static res:Strings.SettingsTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.SettingsTooltip}"
                            Click="OnSettingsClick"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource TitleBarButtonStyle}" />
                    <Button x:Name="CloseButton"
                            Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                            Width="28" Height="28"
                            ToolTip="{x:Static res:Strings.CloseTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.CloseTooltip}"
                            Click="OnCloseClick"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource TitleBarButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Cuerpo (búsqueda, filtros y lista): en una ventana maximizada se queda en un ancho legible y centrado, igual que Ajustes
             limita el suyo; barra de título y pie ocupan todo el ancho. -->
        <Grid x:Name="BodyGrid" Grid.Row="1" Grid.RowSpan="3" MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource AlduneSurfaceBrush}" CornerRadius="{DynamicResource AlduneRadius7}" Padding="3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Margin" Value="20,16,20,0" />
                        <Style.Triggers>
                            <!-- Bajo una barra de título de verdad (XP) los filtros necesitan más aire: pegados a la barra se veían apretados. -->
                            <DataTrigger Binding="{Binding GradientTitleBar, Source={x:Static local:SkinState.Current}}" Value="True">
                                <Setter Property="Margin" Value="20,24,20,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,78,0">
                <!-- IsChecked se fija desde el code-behind tras InitializeComponent, no aquí: un
                     IsChecked="True" en XAML dispara Checked mientras el árbol se está
                     construyendo, antes de que RowsList exista — ver el constructor. -->
                <!-- Sin "Todas". Mezclaba tres categorias mentales distintas (lo que tienes, lo
                     que guardaste, lo que tiraste) en una sola lista donde el estado solo se
                     distinguia por un chip pequeno, y ademas obligaba a un caso especial en las
                     animaciones: bajo "Todas" archivar no saca la nota de la vista, asi que no
                     podia animarse como que se va. Tres estados, y "Activas" por defecto, que es
                     lo que uno quiere ver al abrir. -->
                <RadioButton x:Name="FilterActive" GroupName="NotesFilter" Content="{x:Static res:Strings.FilterActive}"
                             Checked="OnFilterChanged" Style="{StaticResource FilterToggleStyle}" />
                <RadioButton x:Name="FilterArchived" GroupName="NotesFilter" Content="{x:Static res:Strings.FilterArchived}"
                             Checked="OnFilterChanged" Style="{StaticResource FilterToggleStyle}" />
                <RadioButton x:Name="FilterTrashed" GroupName="NotesFilter" Content="{x:Static res:Strings.FilterTrashed}"
                             Checked="OnFilterChanged" Style="{StaticResource FilterToggleStyle}" />
                <!-- The three filters beside the tabs wrap together as one row (tag), instead of splitting at any point. -->
                <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="TagFilterBox" MinWidth="110" MinHeight="31" Margin="0"
                          ToolTip="{x:Static res:Strings.TagFilterTooltip}"
                          AutomationProperties.Name="{x:Static res:Strings.TagFilterTooltip}"
                          SelectionChanged="OnTagFilterChanged"
                           Style="{StaticResource TagFilterStyle}"
                           Visibility="Collapsed" />
                </StackPanel>
                </WrapPanel>
                <!-- «Nueva nota» al final de la fila de filtros, con el acento de la app: antes estaba en la cabecera, un botón con caja entre botones
                     de ventana planos, y desentonaba en todos los aspectos. Solo el «+», que se dibuja (dos barras de 2 px en una caja de 12) para que
                     quede centrado al píxel. -->
                <!-- Actions on the right (manage tags, new note), apart from the filters on the left: the filters are what you look at, these are what you do. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <!-- Solo icono y en la misma fila: antes ocupaba una fila entera para un botón que
                     se usa de higos a brevas. El tooltip dice qué es. -->
                <Button x:Name="ManageTagsButton" Click="OnManageTagsClick"
                        Width="31" Height="31" Padding="0" Margin="0,0,8,0"
                        ToolTip="{x:Static res:Strings.ManageTags}"
                        AutomationProperties.Name="{x:Static res:Strings.ManageTags}"
                        Style="{StaticResource ToolbarButtonStyle}">
                    <TextBlock Text="&#xE8EC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource AlduneTextBody}" />
                </Button>
                <Button x:Name="NewNoteButton" Click="OnNewNoteClick"
                        Width="31" Height="31" Padding="0"
                        ToolTip="{x:Static res:Strings.NewNoteTooltip}"
                        AutomationProperties.Name="{x:Static res:Strings.NewNoteTooltip}"
                        Style="{StaticResource AccentToolbarButtonStyle}">
                    <Grid Width="12" Height="12" UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <Border Height="2" VerticalAlignment="Center" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <Border Width="2" HorizontalAlignment="Center" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Grid>
                </Button>
                </StackPanel>
                </Grid>
        </Border>

        <Popup x:Name="TagManagerPopup" AllowsTransparency="True" Focusable="True"
               StaysOpen="False" Placement="Bottom" PopupAnimation="Fade">
            <Border Background="{DynamicResource AldunePopupBrush}" BorderBrush="{DynamicResource AldunePressedBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource AlduneRadius7}" Padding="12">
                <StackPanel Width="290">
                    <TextBlock Text="{x:Static res:Strings.ManageTags}" Foreground="{DynamicResource AlduneTextStrongBrush}"
                               FontWeight="SemiBold" />
                    <Grid Margin="0,10,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewTagTextBox" Grid.Column="0" Height="32" Padding="9,5"
                                 Background="{DynamicResource AlduneSurfaceBrush}" Foreground="{DynamicResource AlduneTextStrongBrush}" BorderBrush="{DynamicResource AlduneTextFaintBrush}"
                                 CaretBrush="{DynamicResource AlduneTextStrongBrush}" />
                        <Button Grid.Column="1" Click="OnCreateTagClick"
                                Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static res:Strings.CreateTag}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{x:Static res:Strings.AllTags}" Foreground="{DynamicResource AlduneMutedTextBrush}"
                               FontSize="{DynamicResource AlduneTextSmall}" Margin="0,0,0,5" />
                    <TextBlock x:Name="TagManagerEmptyText" Text="{x:Static res:Strings.DockViewNoTags}"
                               Foreground="{DynamicResource AlduneMutedTextBrush}" FontSize="{DynamicResource AlduneTextSmall}" Visibility="Collapsed" />
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TagManagerItems" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Busca dentro del filtro activo, no a través de los tres a la vez: mezclar estados en
             los resultados reabriría el mismo problema que "Todas" ya causó (ver más arriba) para
             el borrado permanente, que solo tiene sentido en Papelera. Cambiar de pestaña conserva
             el texto, así que buscar y luego mirar en otra categoría no obliga a escribirlo dos
             veces. -->
        <Border Grid.Row="1" Background="{DynamicResource AlduneSurfaceBrush}" CornerRadius="{DynamicResource AlduneRadius7}" Margin="20,12,20,0">
            <Grid>
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           Foreground="{DynamicResource AlduneTextFaintBrush}" FontSize="13"
                           Margin="10,0,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBlock x:Name="SearchPlaceholder" Text="{x:Static res:Strings.SearchPlaceholder}"
                           Foreground="{DynamicResource AlduneTextFaintBrush}" FontSize="{DynamicResource AlduneTextBody}"
                           Margin="28,0,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           IsHitTestVisible="False" />
                <TextBox x:Name="SearchBox" AutomationProperties.Name="{x:Static res:Strings.SearchPlaceholder}"
                         Background="Transparent" Foreground="{DynamicResource AlduneTextBrush}" CaretBrush="{DynamicResource AlduneTextBrush}"
                         FontSize="{DynamicResource AlduneTextBody}" BorderThickness="0"
                         Padding="0,9" Margin="28,0,28,0"
                         VerticalContentAlignment="Center"
                         TextChanged="OnSearchTextChanged" />
                <Button x:Name="SearchClearButton" Content="&#x2715;" FontSize="9"
                        Width="20" Height="20" Margin="0,0,6,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="Collapsed"
                        ToolTip="{x:Static res:Strings.ClearSearchTooltip}"
                        AutomationProperties.Name="{x:Static res:Strings.ClearSearchTooltip}"
                        Click="OnSearchClearClick"
                        Style="{StaticResource CloseButtonStyle}" />
            </Grid>
        </Border>

        <!-- Casilla de tres estados y no un enlace de texto: es el patrón convencional para una
             lista con casillas, y sobre todo MUESTRA el estado. El enlace ya alternaba, pero no
             había forma de saber si estaba todo marcado o nada. Va alineada con las casillas de las
             filas, que es donde el ojo la busca. -->
        <!-- One row for «Select all» and the list's options, each centred in it: the offsets used to be written by hand (19 and 14) and the
             checkbox sat a pixel above the buttons. -->
        <Grid Grid.Row="2" VerticalAlignment="Top" Margin="0,14,0,0">
        <CheckBox x:Name="SelectAllCheck"
                  Content="{x:Static res:Strings.SelectAll}"
                  Foreground="{DynamicResource AlduneMutedTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="{DynamicResource AlduneTextSmall}"
                  IsThreeState="True"
                  Style="{StaticResource AppCheckBoxStyle}"
                  Click="OnSelectAllClick"
                  Margin="32,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
        <!-- The list's own options, right-aligned: the order, and "restore size and position of all notes", which is not about the
             selection and would not fit in the footer's row at the minimum width. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
            <Button x:Name="RestorePlacementsButton" Click="OnRestorePlacementsClick" MinHeight="26" Margin="0,0,8,0"
                    MaxWidth="170"
                    ToolTip="{x:Static res:Strings.RestoreAllPlacementsButton}"
                    AutomationProperties.Name="{x:Static res:Strings.RestoreAllPlacementsButton}"
                    Style="{StaticResource ToolbarButtonStyle}">
                <!-- Trimmed rather than pushing the order box over "Select all" in a longer language at the minimum width; the tooltip has the full text. -->
                <TextBlock Text="{x:Static res:Strings.RestoreAllPlacementsShort}" TextTrimming="CharacterEllipsis" />
            </Button>
            <ComboBox x:Name="SortBox" MinWidth="140" MinHeight="26"
                      ToolTip="{x:Static res:Strings.SortTooltip}"
                      AutomationProperties.Name="{x:Static res:Strings.SortTooltip}"
                      SelectionChanged="OnSortChanged"
                      Style="{StaticResource DarkComboBoxStyle}" />
        </StackPanel>
        </Grid>

        <!-- The thumb ends on the right limit of everything above (search, order, «+»: 20 px from the edge) and the rows stop 8 px before it. -->
            <Grid x:Name="RowsHost" Grid.Row="2" Margin="20,56,17,0">
            <ScrollViewer x:Name="RowsScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
                <!-- The list is ONE Tab stop (Once): Up/Down move between rows, Space selects, Enter opens, P pins and T edits the tags of the focused row.
                     Without it five notes cost 20 Tab presses (row, tick box, pin and tags button each). -->
                <ItemsControl x:Name="RowsList" AutomationProperties.Name="{x:Static res:Strings.ManageNotesTitle}" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.ControlTabNavigation="Once"
                              KeyboardNavigation.DirectionalNavigation="Contained">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- TextElement.Foreground, no Foreground a secas: Border no es un
                                 Control y no tiene esa propiedad, pero la adjunta sí se hereda por
                                 el árbol, que es lo que hace falta para tenir toda la fila. -->
                            <Border Background="{Binding Note.Color, Converter={StaticResource ManagerRowFaceConverter}}"
                                    TextElement.Foreground="{Binding Note.Color, Converter={StaticResource ManagerRowInkConverter}}"
                                    CornerRadius="{DynamicResource AlduneRadius8}" Margin="0,0,0,8" Padding="12,8"
                                    Cursor="Hand"
                                    Focusable="True"
                                    FocusVisualStyle="{StaticResource AlduneFocusVisual}"
                                    KeyboardNavigation.IsTabStop="True"
                                    MouseLeftButtonUp="OnRowMouseLeftButtonUp"
                                    MouseRightButtonUp="OnRowMouseRightButtonUp"
                                    KeyDown="OnRowKeyDown"
                                    AutomationProperties.Name="{Binding Note, Converter={StaticResource NoteTitleConverter}}"
                                    AutomationProperties.HelpText="{x:Static res:Strings.ManagerRowKeysHint}"
                                    >
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{Binding Note, Converter={StaticResource ManagerRowRimConverter}}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Opacity" Value="0.96" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AlduneTextStrongBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AlduneTextStrongBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- With "note colour only on the edge" the row keeps the app's surface and this is the colour: a stripe on the left, like the dock cards. It covers the 1 px rim so the colour reaches the row's own corner (inside the rim it left a grey hairline). -->
                                    <Border Grid.ColumnSpan="2" HorizontalAlignment="Left" Width="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource StripeWidthConverter}}" Margin="-13,-9,0,-9" CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource LeftCornersConverter}}"
                                            Background="{Binding Note, Converter={StaticResource NoteFaceConverter}, ConverterParameter=Accent}"
                                            Visibility="{Binding Note.Color, Converter={StaticResource ManagerRowStripeVisibilityConverter}}"
                                            IsHitTestVisible="False" />
                                    <!-- The stripe is as wide as the row's corner radius so that its outer edge is the same circle as the row's corner (a 5 px wide
                                         piece cut the corner short); this covers what is beyond 5 px with the row's surface, inside the 1 px rim. -->
                                    <Border Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="-8,-8,0,-8"
                                            Width="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource StripeWidthConverter}, ConverterParameter=cover}"
                                            Background="{Binding Note.Color, Converter={StaticResource ManagerRowFaceConverter}}"
                                            Visibility="{Binding Note.Color, Converter={StaticResource ManagerRowStripeVisibilityConverter}}"
                                            IsHitTestVisible="False" />

                                    <!-- Sin chip de estado ("Archivada", "Papelera"): la lista solo
                                         enseña un estado a la vez (no hay vista "Todas"), así que
                                         repetía la pestaña y descolocaba la fila. -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Foreground="{Binding Note.Color, Converter={StaticResource ManagerRowInkConverter}}"
                                              Background="{Binding Note.Color, Converter={StaticResource ManagerRowFaceConverter}}"
                                              Style="{StaticResource AppCheckBoxStyle}"
                                              IsTabStop="False"
                                              PreviewMouseLeftButtonDown="OnRowCheckBoxPreviewMouseLeftButtonDown"
                                              AutomationProperties.Name="{Binding Note, Converter={StaticResource NoteTitleConverter}}"
                                              VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <!-- Dos líneas: título y fecha; debajo, el principio del texto y
                                         las etiquetas. Con solo el título, dos notas que empiezan
                                         igual no se distinguían sin abrirlas. -->
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <DockPanel Grid.Column="0" LastChildFill="True">
                                            <!-- Nota vinculada a un archivo: misma página que en la pestaña, con la ruta. -->
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE7C3;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource AlduneTextSmall}"
                                                       VerticalAlignment="Center" Margin="0,0,5,0" Opacity="0.75"
                                                       Visibility="{Binding Note, Converter={StaticResource NoteLinkedConverter}}"
                                                       ToolTip="{Binding Note, Converter={StaticResource NoteLinkedConverter}, ConverterParameter=Path}" />
                                            <!-- Fijar arriba en la lista (no el «siempre encima»): la chincheta es un interruptor,
                                                 tenue si la nota no está fijada y plena si lo está. -->
                                            <Button DockPanel.Dock="Left" Tag="{Binding}" Click="OnPinToTopClick" IsTabStop="False"
                                                    AutomationProperties.AutomationId="RowPin" AutomationProperties.AccessKey="P"
                                                    Margin="-4,-2,3,-2" VerticalAlignment="Center"
                                                    Foreground="{Binding Note.Color, Converter={StaticResource ManagerRowInkConverter}}"
                                                    ToolTip="{Binding Note.IsPinnedToTop, Converter={StaticResource PinToTopTextConverter}}"
                                                    AutomationProperties.Name="{Binding Note.IsPinnedToTop, Converter={StaticResource PinToTopTextConverter}}"
                                                    Style="{StaticResource TagChipsButtonStyle}">
                                                <!-- The colour is the row's own ink (what the title uses), so it contrasts on every look; the old
                                                     «label» tone of the note colour read grey and faded on dark looks. Pinned = filled glyph at full
                                                     strength; not pinned = outline at 0.45, enough to find the toggle. -->
                                                <TextBlock Text="&#xE840;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="{DynamicResource AlduneTextSmall}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Opacity" Value="0.45" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Note.IsPinnedToTop}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE718;" />
                                                                    <Setter Property="Opacity" Value="1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <TextBlock Text="{Binding Note, Converter={StaticResource NoteTitleConverter}}"
                                                       FontWeight="SemiBold" FontSize="{DynamicResource AlduneTextBody}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Note.UpdatedAt, Converter={StaticResource NoteDateConverter}}"
                                                   ToolTip="{Binding Note.UpdatedAt, Converter={StaticResource NoteDateConverter}, ConverterParameter=full}"
                                                   FontSize="{DynamicResource AlduneTextSmall}" Margin="10,0,0,0"
                                                   Foreground="{Binding Note.Color, Converter={StaticResource ManagerRowMutedInkConverter}}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="{Binding Note, Converter={StaticResource NoteSnippetConverter}}"
                                                   FontSize="{DynamicResource AlduneTextBody}" Margin="0,2,0,0"
                                                   Foreground="{Binding Note.Color, Converter={StaticResource ManagerRowMutedInkConverter}}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Row="1" Grid.Column="1" Tag="{Binding}"
                                                Click="OnEditTagsClick" Margin="10,1,-2,-2" IsTabStop="False"
                                                AutomationProperties.AutomationId="RowTags" AutomationProperties.AccessKey="T"
                                                HorizontalAlignment="Right"
                                                Foreground="{Binding Note.Color, Converter={StaticResource ManagerRowInkConverter}}"
                                                ToolTip="{x:Static res:Strings.EditTagsTooltip}"
                                                AutomationProperties.Name="{x:Static res:Strings.EditTagsTooltip}"
                                                Style="{StaticResource TagChipsButtonStyle}">
                                            <Grid>
                                                <ItemsControl ItemsSource="{Binding Note.Tags}" MaxWidth="170" ClipToBounds="True">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <!-- Fondo y texto del color de tinta de la nota
                                                             (el fondo, muy transparente): así el chip
                                                             se lee igual en una nota clara que en una
                                                             oscura. Un negro translúcido fijo apenas se
                                                             distinguía sobre los temas oscuros. -->
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,4,0">
                                                                <Border CornerRadius="{DynamicResource AlduneRadius4}" Opacity="0.16"
                                                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                                <TextBlock Text="{Binding}" FontSize="{DynamicResource AlduneTextSmall}" Margin="6,1" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{x:Static res:Strings.AddTags}" FontSize="{DynamicResource AlduneTextSmall}" Opacity="0.6">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Note.Tags.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Button>
                                    </Grid>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Estado vacío: dice qué pasa y por qué, en vez de dejar un hueco en blanco. -->
            <TextBlock x:Name="EmptyState"
                       Foreground="{DynamicResource AlduneTextFaintBrush}" FontSize="{DynamicResource AlduneTextBody}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="260"
                       Visibility="Collapsed" />
        </Grid>

        </Grid>

        <!-- WrapPanel, no StackPanel: estos botones no caben en una línea al ancho mínimo, y un
             StackPanel dejaría el último saliéndose de la ventana sin recortar pero sin poder
             pulsarse (pasó exactamente eso una vez). WrapPanel baja el sobrante a otra línea. -->
        <Border Grid.Row="4" Background="{DynamicResource AlduneGroundDeepBrush}" Padding="20,12">
            <DockPanel>
                <!-- "Eliminar" separado del resto y a la izquierda: es la unica accion sin vuelta
                     atras de toda la app, asi que no comparte vecindario con las reversibles.
                     Solo aparece en la papelera — ofrecerlo en las demas vistas permitiria saltarse
                     la papelera, que es justo la red de seguridad que la hace util. -->
                <Button x:Name="DeleteButton" DockPanel.Dock="Left" MinWidth="130"
                        Click="OnDeleteSelectedClick"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        Style="{StaticResource DangerToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static res:Strings.Delete}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Margin vertical en los elementos: si el WrapPanel llega a partirse a un ancho
                     muy estrecho, las dos líneas se tocaban y los botones parecían solaparse. -->
                <!-- Pegados a la derecha (las acciones sobre la selección van al final) y los cuatro del mismo ancho: antes Export y Trash eran más
                     estrechos que Archive y Restore y la fila parecía desigual. -->
                <!-- The -8 cancels the left margin of the first button, so the row ends exactly at the 20 px margin and needs 8 px less. -->
                <WrapPanel HorizontalAlignment="Right" Margin="-8,0,0,0">
                    <!-- Brings notes in from other apps. Like Export it does not depend on the selection. -->
                    <Button x:Name="ImportButton" AutomationProperties.Name="{x:Static res:Strings.ImportNotesButton}" Click="OnImportNotesClick" MinWidth="130" Margin="8,3,0,3"
                            ToolTip="{x:Static res:Strings.ImportNotesTooltip}"
                            Style="{StaticResource ToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static res:Strings.ImportNotesButton}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- Exporta la selección si hay alguna marcada, o todas las del filtro actual si
                         no — no depende de tener algo seleccionado, a diferencia de los botones de
                         abajo. Glifo elegido sin verificación visual del render real, igual que ya
                         pasó una vez con el de "abrir todas" (ver docs/STATUS.md). -->
                    <Button x:Name="ExportButton" AutomationProperties.Name="{x:Static res:Strings.Export}" Click="OnExportSelectedClick" MinWidth="130" Margin="8,3,0,3"
                            Style="{StaticResource ToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static res:Strings.Export}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ArchiveButton" AutomationProperties.Name="{x:Static res:Strings.Archive}" Click="OnArchiveSelectedClick" MinWidth="130" Margin="8,3,0,3"
                            Style="{StaticResource ToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static res:Strings.Archive}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RestoreButton" AutomationProperties.Name="{x:Static res:Strings.Restore}" Click="OnRestoreSelectedClick" MinWidth="130" Margin="8,3,0,3"
                            Style="{StaticResource ToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static res:Strings.Restore}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TrashButton" AutomationProperties.Name="{x:Static res:Strings.Trash}" Click="OnTrashSelectedClick" MinWidth="130" Margin="8,3,0,3"
                            Style="{StaticResource DangerToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static res:Strings.Trash}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
