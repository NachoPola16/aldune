<Window x:Class="Aldune.Windowing.QuickFindWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Aldune.Resources"
        x:ClassModifier="internal"
        Title="{x:Static res:Strings.QuickFindWindowName}"
        Width="580"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource AlduneGroundBrush}"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- A row: the selection is a fill plus a bar in the focus-ring colour, so it reads without relying on colour contrast alone.
             The text box keeps the keyboard the whole time (Up/Down are routed to the list), so the list never takes a focus ring of its own. -->
        <Style x:Key="QuickFindItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="{DynamicResource AlduneRadius6}" Padding="12,8,12,9" Margin="0,0,0,2">
                            <Grid>
                                <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="-9,2,0,2" CornerRadius="1.5" Visibility="Collapsed"
                                        Background="{DynamicResource AlduneFocusRingBrush}" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AlduneHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AlduneSelectedBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Border BorderBrush="{DynamicResource AlduneBorderBrush}" BorderThickness="1" Background="{DynamicResource AlduneGroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The search field. Its frame lights up in the focus-ring colour while it holds the keyboard (always, on opening). -->
            <Border x:Name="SearchFrame" Grid.Row="0" Margin="12,12,12,8" Background="{DynamicResource AlduneSurfaceBrush}"
                    CornerRadius="{DynamicResource AlduneRadius7}" BorderThickness="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AlduneFocusRingBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource AlduneTextFaintBrush}" Margin="12,0,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock x:Name="Placeholder" Text="{x:Static res:Strings.QuickFindPlaceholder}"
                               Foreground="{DynamicResource AlduneTextFaintBrush}" FontSize="{DynamicResource AlduneTextLarge}"
                               Margin="40,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBox x:Name="SearchBox" AutomationProperties.Name="{x:Static res:Strings.QuickFindPlaceholder}"
                             Background="Transparent" Foreground="{DynamicResource AlduneTextStrongBrush}"
                             CaretBrush="{DynamicResource AlduneTextStrongBrush}" SelectionBrush="{DynamicResource AlduneSelectedBrush}"
                             FontSize="{DynamicResource AlduneTextLarge}" BorderThickness="0" Padding="0,10"
                             Margin="40,0,12,0" VerticalContentAlignment="Center" FocusVisualStyle="{x:Null}"
                             TextChanged="OnSearchTextChanged" />
                </Grid>
            </Border>

            <ListBox x:Name="Results" Grid.Row="1" Margin="12,0,12,4" MaxHeight="430"
                     AutomationProperties.Name="{x:Static res:Strings.QuickFindListName}"
                     Background="Transparent" BorderThickness="0" Focusable="False"
                     ItemContainerStyle="{StaticResource QuickFindItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     KeyboardNavigation.TabNavigation="None"
                     MouseLeftButtonUp="OnResultsMouseUp">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource AlduneMutedTextBrush}" Margin="0,2,7,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource AlduneTextStrongBrush}" FontSize="{DynamicResource AlduneTextBody}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="{Binding TagsText}" TextTrimming="CharacterEllipsis" MaxWidth="170" Margin="12,0,0,0"
                                           Foreground="{DynamicResource AlduneMutedTextBrush}" FontSize="{DynamicResource AlduneTextSmall}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding Snippet}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                       Foreground="{DynamicResource AlduneHintBrush}" FontSize="{DynamicResource AlduneTextSmall}"
                                       Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="NoneText" Grid.Row="2" Text="{x:Static res:Strings.QuickFindNone}" Visibility="Collapsed"
                       Foreground="{DynamicResource AlduneMutedTextBrush}" FontSize="{DynamicResource AlduneTextBody}"
                       Margin="24,10,24,18" HorizontalAlignment="Center" />

            <Border Grid.Row="3" BorderBrush="{DynamicResource AlduneBorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                <TextBlock x:Name="FooterText" AutomationProperties.LiveSetting="Polite" Text="{x:Static res:Strings.QuickFindFooter}" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource AlduneHintBrush}" FontSize="{DynamicResource AlduneTextSmall}" />
            </Border>
        </Grid>
    </Border>
</Window>
