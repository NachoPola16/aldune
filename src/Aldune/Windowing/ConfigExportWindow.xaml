<Window x:Class="Aldune.Windowing.ConfigExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Aldune.Resources"
        Title="{x:Static res:Strings.ConfigExportTitle}"
        Width="440" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AlduneGroundBrush}"
        PreviewKeyDown="OnWindowKeyDown"
        SourceInitialized="OnSourceInitialized">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource AlduneBorderSubtleBrush}" BorderThickness="1" Padding="20,18,20,16">
        <StackPanel>
            <TextBlock Text="{x:Static res:Strings.ConfigExportTitle}"
                       Foreground="{DynamicResource AlduneTextStrongBrush}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static res:Strings.ConfigExportHint}"
                       Foreground="{DynamicResource AlduneTextSoftBrush}" FontSize="12" TextWrapping="Wrap"
                       LineHeight="18" Margin="0,8,0,0" />

            <CheckBox x:Name="AppearanceCheck" IsChecked="True" Margin="0,18,0,0"
                      Content="{x:Static res:Strings.ConfigSectionAppearance}"
                      Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="13"
                      Style="{StaticResource AppCheckBoxStyle}" Click="OnSectionToggled" />
            <TextBlock Text="{x:Static res:Strings.ConfigSectionAppearanceHint}"
                       Foreground="{DynamicResource AlduneHintBrush}" FontSize="11" TextWrapping="Wrap" Margin="27,4,0,0" />

            <CheckBox x:Name="SettingsCheck" IsChecked="True" Margin="0,14,0,0"
                      Content="{x:Static res:Strings.ConfigSectionSettings}"
                      Foreground="{DynamicResource AlduneTextBrush}" Background="{DynamicResource AlduneGroundBrush}" FontSize="13"
                      Style="{StaticResource AppCheckBoxStyle}" Click="OnSectionToggled" />
            <TextBlock Text="{x:Static res:Strings.ConfigSectionSettingsHint}"
                       Foreground="{DynamicResource AlduneHintBrush}" FontSize="11" TextWrapping="Wrap" Margin="27,4,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{x:Static res:Strings.DialogCancel}"
                        Style="{StaticResource ColorDialogButtonStyle}" MinWidth="84" Click="OnCancelClick" />
                <Button x:Name="ExportButton" Content="{x:Static res:Strings.ConfigExportSave}"
                        Margin="8,0,0,0" MinWidth="84" Style="{StaticResource PrimaryColorDialogButtonStyle}"
                        Click="OnExportClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
