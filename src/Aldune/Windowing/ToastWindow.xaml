<Window x:Class="Aldune.Windowing.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Aldune.Resources"
        x:ClassModifier="internal"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="{DynamicResource AlduneGroundBrush}"
        SourceInitialized="OnSourceInitialized">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource AlduneGroundBrush}" BorderBrush="{DynamicResource AlduneBorderSubtleBrush}" BorderThickness="1" Padding="16,14,12,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image x:Name="Logo" Grid.RowSpan="2" Width="28" Height="28" Margin="0,1,12,0"
                   VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />

            <TextBlock x:Name="TitleText" Grid.Column="1" Foreground="{DynamicResource AlduneTextStrongBrush}" FontSize="{StaticResource AlduneTextBody}"
                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,3" />
            <TextBlock x:Name="MessageText" Grid.Column="1" Grid.Row="1" Foreground="{DynamicResource AlduneTextSoftBrush}" FontSize="{StaticResource AlduneTextSmall}"
                       TextWrapping="Wrap" LineHeight="18" />

            <Button Grid.Column="2" Content="&#x2715;" Width="24" Height="24" Margin="8,-4,0,0"
                    VerticalAlignment="Top" FontSize="10" Padding="0"
                    Style="{StaticResource ColorDialogButtonStyle}" Background="Transparent"
                    Click="OnCloseClick" ToolTip="{x:Static res:Strings.CloseTooltip}"
                    AutomationProperties.Name="{x:Static res:Strings.CloseTooltip}" />

            <StackPanel x:Name="ActionsPanel" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2"
                        Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,4,0" />
        </Grid>
    </Border>
</Window>
