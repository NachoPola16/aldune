<Window x:Class="Aldune.Windowing.CustomColorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aldune.Windowing"
        xmlns:res="clr-namespace:Aldune.Resources"
        Title="{x:Static res:Strings.CustomColorWindowTitle}"
        Width="430" Height="620"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#2A261F"
        PreviewKeyDown="OnWindowKeyDown"
        SourceInitialized="OnSourceInitialized">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border Background="#2A261F" BorderBrush="#5A5146" BorderThickness="1" Padding="20,17,20,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="128" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.CustomColorWindowTitle}"
                               Foreground="#F5F0E6" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static res:Strings.CustomColorWindowHint}"
                               Foreground="#A79E90" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="&#x2715;" Width="27" Height="27" HorizontalAlignment="Right"
                        Style="{StaticResource ColorDialogButtonStyle}" Padding="0"
                        Click="OnCancelClick" ToolTip="{x:Static res:Strings.CloseTooltip}"
                        AutomationProperties.Name="{x:Static res:Strings.CloseTooltip}" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock Text="{x:Static res:Strings.CustomColorSpectrumHint}"
                           Foreground="#A79E90" FontSize="11" Margin="0,0,0,7" />
                <local:ColorSpectrumControl x:Name="Spectrum" Height="150"
                                             ColorChanged="OnSpectrumChanged" />
            </StackPanel>

            <Border x:Name="PreviewPanel" Grid.Row="2" Margin="0,18,0,18"
                    Background="#F5E3B3" CornerRadius="9" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PreviewSwatch" Width="42" Height="42" CornerRadius="8"
                            BorderBrush="#1E1A14" BorderThickness="1" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,0,0">
                        <TextBlock x:Name="PreviewLabel" Text="{x:Static res:Strings.CustomColorPreview}"
                                   Foreground="#5A5146" FontSize="11" />
                        <TextBlock x:Name="PreviewHex" Foreground="#1E1A14"
                                   FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="132" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.CustomColorHexLabel}"
                           Foreground="#EDE7DC" FontSize="12" VerticalAlignment="Center" />
                <TextBox x:Name="HexBox" Grid.Column="1" Text="#F5E3B3"
                         Style="{StaticResource ColorTextBoxStyle}"
                         MaxLength="7" CharacterCasing="Upper"
                         TextChanged="OnHexChanged" />
            </Grid>
            <TextBlock x:Name="HexHint" Grid.Row="4" Foreground="#A79E90" FontSize="11"
                       Margin="0,5,0,12" />

            <TextBlock Grid.Row="5" Text="{x:Static res:Strings.CustomColorRgbLabel}"
                       Foreground="#A79E90" FontSize="11" Margin="0,0,0,5" />
            <Grid Grid.Row="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="27" />
                    <RowDefinition Height="27" />
                    <RowDefinition Height="27" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="R" Foreground="#D8877B" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255"
                        ValueChanged="OnSliderChanged" Foreground="#D8877B" Background="#4A443B" />
                <TextBox x:Name="RedValue" Grid.Column="2" MaxLength="3" Padding="3,1"
                         Style="{StaticResource ColorTextBoxStyle}" TextAlignment="Right"
                         TextChanged="OnRgbTextChanged" />
                <TextBlock Grid.Row="1" Text="G" Foreground="#91C58D" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255"
                        ValueChanged="OnSliderChanged" Foreground="#91C58D" Background="#4A443B" />
                <TextBox x:Name="GreenValue" Grid.Row="1" Grid.Column="2" MaxLength="3" Padding="3,1"
                         Style="{StaticResource ColorTextBoxStyle}" TextAlignment="Right"
                         TextChanged="OnRgbTextChanged" />
                <TextBlock Grid.Row="2" Text="B" Foreground="#89B9D8" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255"
                        ValueChanged="OnSliderChanged" Foreground="#89B9D8" Background="#4A443B" />
                <TextBox x:Name="BlueValue" Grid.Row="2" Grid.Column="2" MaxLength="3" Padding="3,1"
                         Style="{StaticResource ColorTextBoxStyle}" TextAlignment="Right"
                         TextChanged="OnRgbTextChanged" />
            </Grid>

            <Grid Grid.Row="7" Margin="0,16,0,0">
                <TextBlock x:Name="ContrastHint" Foreground="#A79E90" FontSize="11"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Static res:Strings.CustomColorCancel}"
                            Style="{StaticResource ColorDialogButtonStyle}" Click="OnCancelClick" />
                    <Button x:Name="ApplyButton" Content="{x:Static res:Strings.CustomColorApply}"
                            Margin="8,0,0,0" Style="{StaticResource PrimaryColorDialogButtonStyle}"
                            Click="OnApplyClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
