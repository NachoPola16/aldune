<Window x:Class="Aldune.Windowing.ImportNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Aldune.Resources"
        Title="{x:Static res:Strings.ImportNotesTitle}"
        Width="560" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AlduneGroundBrush}"
        PreviewKeyDown="OnWindowKeyDown"
        SourceInitialized="OnSourceInitialized">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource AlduneBorderSubtleBrush}" BorderThickness="1" Padding="20,18,20,16">
        <StackPanel>
            <TextBlock Text="{x:Static res:Strings.ImportNotesTitle}"
                       Foreground="{DynamicResource AlduneTextStrongBrush}" FontSize="{DynamicResource AlduneTextTitle}" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static res:Strings.ImportNotesHint}"
                       Foreground="{DynamicResource AlduneTextSoftBrush}" FontSize="{DynamicResource AlduneTextSmall}" TextWrapping="Wrap"
                       LineHeight="18" Margin="0,8,0,0" />

            <TextBlock x:Name="FromLabel" Text="{x:Static res:Strings.ImportFromLabel}"
                       Foreground="{DynamicResource AlduneTextBrush}" FontSize="{DynamicResource AlduneTextBody}" Margin="0,16,0,4" />
            <ComboBox x:Name="SourceBox" Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="OnSourceChanged"
                      AutomationProperties.LabeledBy="{Binding ElementName=FromLabel}" />

            <TextBlock x:Name="HelpText"
                       Foreground="{DynamicResource AlduneHintBrush}" FontSize="{DynamicResource AlduneTextSmall}" TextWrapping="Wrap"
                       LineHeight="17" Margin="0,8,0,0" />

            <WrapPanel Margin="0,14,0,0">
                <Button x:Name="UseWindowsButton" Content="{x:Static res:Strings.ImportUseWindows}"
                        Style="{StaticResource ColorDialogButtonStyle}" Padding="12,6" Margin="0,0,8,4" Click="OnUseWindowsClick" />
                <Button x:Name="ChooseFileButton" Content="{x:Static res:Strings.ImportChooseFile}"
                        Style="{StaticResource ColorDialogButtonStyle}" Padding="12,6" Margin="0,0,8,4" Click="OnChooseFileClick" />
                <Button x:Name="ChooseFolderButton" Content="{x:Static res:Strings.ImportChooseFolder}"
                        Style="{StaticResource ColorDialogButtonStyle}" Padding="12,6" Margin="0,0,8,4" Click="OnChooseFolderClick" />
            </WrapPanel>
            <TextBlock x:Name="PathText" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       Foreground="{DynamicResource AlduneTextSoftBrush}" FontSize="{DynamicResource AlduneTextSmall}"
                       FontFamily="Cascadia Mono, Consolas" Margin="0,10,0,0" />

            <Border Height="1" Background="{DynamicResource AlduneBorderSubtleBrush}" Margin="0,14,0,14" />

            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontWeight="SemiBold"
                       Foreground="{DynamicResource AlduneTextBrush}" FontSize="{DynamicResource AlduneTextBody}"
                       AutomationProperties.LiveSetting="Polite" />
            <ScrollViewer x:Name="DetailsScroller" MaxHeight="150" Margin="0,6,0,0" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DetailsPanel" Margin="0,0,10,0" />
            </ScrollViewer>
            <TextBlock x:Name="ColoursText" Text="{x:Static res:Strings.ImportColoursNote}" Visibility="Collapsed"
                       Foreground="{DynamicResource AlduneHintBrush}" FontSize="{DynamicResource AlduneTextSmall}" TextWrapping="Wrap" Margin="0,10,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CloseButton" Content="{x:Static res:Strings.DialogCancel}"
                        Style="{StaticResource ColorDialogButtonStyle}" MinWidth="84" Click="OnCloseClick" />
                <Button x:Name="ImportButton" Content="{x:Static res:Strings.ImportRunButton}" IsEnabled="False"
                        Margin="8,0,0,0" MinWidth="84" Style="{StaticResource PrimaryColorDialogButtonStyle}"
                        Click="OnImportClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
