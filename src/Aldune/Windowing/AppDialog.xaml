<Window x:Class="Aldune.Windowing.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AlduneGroundBrush}"
        PreviewKeyDown="OnWindowKeyDown"
        SourceInitialized="OnSourceInitialized">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Para confirmar lo que no tiene vuelta atrás (borrar para siempre, revocar el acceso): el
             mismo rojo apagado que los botones de papelera, no el dorado de "aceptar". -->
        <Style x:Key="DangerDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource ColorDialogButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AlduneDangerStrongBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AlduneOnDangerBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AlduneRadius6}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource AlduneDangerStrongHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource AlduneBorderSubtleBrush}" BorderThickness="1" Padding="20,18,20,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- A long message (What's new lists every version) scrolls inside the window instead of making it taller than the screen, which
                 pushed the buttons off it. The window's MaxHeight is set from the work area in the code-behind. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="IconGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                           Margin="0,1,14,0" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="TitleText" Foreground="{DynamicResource AlduneTextStrongBrush}" FontSize="{DynamicResource AlduneTextTitle}" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText" Foreground="{DynamicResource AlduneTextSoftBrush}" FontSize="{DynamicResource AlduneTextBody}" TextWrapping="Wrap"
                               LineHeight="19" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
            </ScrollViewer>
            <StackPanel x:Name="ButtonsPanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" />
        </Grid>
    </Border>
</Window>
