<Window x:Class="Aldune.Windowing.SyncNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Aldune.Resources"
        Width="470" Height="600" MinWidth="380" MinHeight="360"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#2A261F" AllowsTransparency="False"
        ShowInTaskbar="False" Topmost="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#EDE7DC" />
            <Setter Property="Background" Value="#3C3730" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4E4840" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SyncCheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EDE7DC" />
            <Setter Property="Background" Value="#2A261F" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,17,14,0" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.SyncNotesWindowTitle}"
                           Foreground="#F5F0E6" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static res:Strings.SyncNotesWindowHint}"
                           Foreground="#A79E90" FontSize="12" TextWrapping="Wrap" Margin="0,4,28,0" />
            </StackPanel>
            <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right"
                    Foreground="#C9C0B2" Background="Transparent" BorderThickness="0"
                    Click="OnCancelClick" />
        </Grid>

        <CheckBox x:Name="SelectAllCheck" Grid.Row="1" Content="{x:Static res:Strings.SelectAll}"
                  Style="{StaticResource SyncCheckStyle}" Margin="22,14,20,4"
                  Click="OnSelectAllClick" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,4,12,8">
            <ItemsControl x:Name="NotesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Style="{StaticResource SyncCheckStyle}"
                                  Content="{Binding DisplayText}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="EmptyText" Grid.Row="2" Text="{x:Static res:Strings.SyncNotesEmpty}"
                   Foreground="#6B6459" FontSize="13" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="20,8,20,16">
            <Button Content="{x:Static res:Strings.SyncNotesCancel}" Click="OnCancelClick"
                    Style="{StaticResource ActionButtonStyle}" />
            <Button Content="{x:Static res:Strings.SyncNotesSave}" Click="OnSaveClick"
                    Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
