<?xml version="1.0" encoding="utf-8"?>
<!--
  Fanote portable: un único .exe que se copia donde sea y funciona sin instalar nada.

  Se hace con perfil de publicación y no metiendo estas propiedades en el .csproj a propósito:
  RuntimeIdentifier sí afecta a `dotnet build` y a `dotnet run`, así que ponerlo en el proyecto
  ralentizaría cada compilación de desarrollo para algo que solo importa al publicar.

  Uso:
      dotnet publish src/Fanote -p:PublishProfile=portable

  El resultado queda en   publish/portable/aldune.exe

  Los datos siguen viviendo en %LOCALAPPDATA%\Fanote, no junto al ejecutable: la app es portable
  en el sentido de "no necesita instalación", no en el de "se lleva sus notas en el USB". Si algún
  día hace falta lo segundo, el sitio es la ruta que arma App.OnStartup.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>..\..\publish\portable\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Autocontenido: lleva su propio .NET dentro. Cuesta tamaño, pero un portable que exige
         instalar antes el runtime de .NET no es portable. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <!-- WPF arrastra librerías nativas; sin esto quedarían sueltas junto al .exe y dejaría de ser
         un solo fichero. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Sin recorte (trimming): WPF usa reflexión por todas partes y el recortador se lleva por
         delante tipos que hacen falta en tiempo de ejecución. Fallaría al abrir alguna ventana, no
         al compilar, que es la peor forma de fallar. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Sin simbolos de depuracion: los .pdb solo sirven para leer un volcado de memoria con el
         codigo delante, y aqui lo unico que hacen es acompanar al .exe y sembrar la duda de si
         tambien hay que copiarlos. La carpeta publicada tiene que ser un solo fichero. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- Lo anterior solo silencia a Fanote. El .pdb de Fanote.Core llega por otra via: se copia
         como "fichero acompanante" de la referencia a ese proyecto, y esa lista es la unica manera
         de pararlo. Vaciarla no quita la .dll, que no es un acompanante sino la referencia misma. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>
