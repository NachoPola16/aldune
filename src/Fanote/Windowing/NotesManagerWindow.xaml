<Window x:Class="Fanote.Windowing.NotesManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fanote.Windowing"
        Title="Gestionar notas"
        Width="340" Height="420"
        MinWidth="260" MinHeight="280"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="#3A3A3A"
        Topmost="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="22" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <local:NoteTitleConverter x:Key="NoteTitleConverter" />
        <local:NoteStateLabelConverter x:Key="NoteStateLabelConverter" />
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="#40CC3333" />
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="FilterToggleStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="#22FFFFFF" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <DockPanel Margin="16,20,16,16">
            <TextBlock DockPanel.Dock="Top" Text="Gestionar notas" Foreground="White"
                       FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <!-- IsChecked is set from code-behind after InitializeComponent, not here: a
                     XAML-declared IsChecked="True" fires Checked while the tree is still being
                     built, before RowsList (declared later) exists yet — see the constructor. -->
                <RadioButton x:Name="FilterAll" GroupName="NotesFilter" Content="Todas"
                             Checked="OnFilterChanged" Style="{StaticResource FilterToggleStyle}" Margin="0,0,6,6" />
                <RadioButton x:Name="FilterActive" GroupName="NotesFilter" Content="Activas"
                             Checked="OnFilterChanged" Style="{StaticResource FilterToggleStyle}" Margin="0,0,6,6" />
                <RadioButton x:Name="FilterArchived" GroupName="NotesFilter" Content="Archivadas"
                             Checked="OnFilterChanged" Style="{StaticResource FilterToggleStyle}" Margin="0,0,6,6" />
                <RadioButton x:Name="FilterTrashed" GroupName="NotesFilter" Content="Papelera"
                             Checked="OnFilterChanged" Style="{StaticResource FilterToggleStyle}" Margin="0,0,0,6" />
            </WrapPanel>
            <!-- WrapPanel, not StackPanel: these buttons don't all fit on one line at this
                 window's minimum width, and a StackPanel would let the last one run off the edge
                 of the window unclipped-but-unclickable (exactly what happened before this fix)
                 — WrapPanel instead drops overflow to a second line, usable at any size. -->
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button Content="Seleccionar todo" Click="OnSelectAllClick" Margin="0,0,6,6" Padding="8,4"
                        Style="{StaticResource ToolbarButtonStyle}" />
                <Button Click="OnArchiveSelectedClick" Margin="0,0,6,6" Padding="8,4"
                        Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Archivar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="OnRestoreSelectedClick" Margin="0,0,6,6" Padding="8,4"
                        Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Restaurar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="OnTrashSelectedClick" Margin="0,0,0,6" Padding="8,4"
                        Style="{StaticResource DangerToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="A la papelera" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Note.Color}" CornerRadius="4" Margin="0,0,0,6" Padding="8">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Note.Text, Converter={StaticResource NoteTitleConverter}}"
                                                   FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <!-- Empty (and collapsed) for Active notes — see
                                             NoteStateLabelConverter — so this manager's Active
                                             rows don't grow an extra blank line. -->
                                        <TextBlock Text="{Binding Note.State, Converter={StaticResource NoteStateLabelConverter}}"
                                                   FontSize="10" Opacity="0.65">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Note.State}" Value="Active">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
        <Button x:Name="CloseButton"
                Content="&#x2715;"
                Width="22" Height="22"
                Margin="0,2,2,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="OnCloseClick"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Style="{StaticResource CloseButtonStyle}" />
    </Grid>
</Window>
