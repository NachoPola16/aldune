<Window x:Class="Fanote.Windowing.EdgeDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fanote.Windowing"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Background="#3A3A3A">
    <Window.Resources>
        <local:NoteTitleConverter x:Key="NoteTitleConverter" />
        <local:NoteStateLabelConverter x:Key="NoteStateLabelConverter" />
        <Style x:Key="NoteTabButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Text, Converter={StaticResource NoteTitleConverter}}"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" />
                            <!-- Only ever non-empty for notes shown in the archive view (Active
                                 notes never appear there) — collapsed rather than just empty text
                                 so the active-notes view doesn't grow an extra blank line. -->
                            <TextBlock Text="{Binding State, Converter={StaticResource NoteStateLabelConverter}}"
                                       FontSize="10"
                                       Opacity="0.65">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Active">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border x:Name="HoverOverlay" Background="Black" Opacity="0" CornerRadius="4" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The default OS scrollbar chrome (light, boxy) looked jarring against the dock's dark
             background and sat flush against the window's rounded corner, getting visually cut
             off by the DWM corner clip. A slim flat thumb (no arrow buttons, invisible track)
             fixes both: it fits the dark theme and leaves clearance from the corner. -->
        <Style x:Key="SlimScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#66FFFFFF" CornerRadius="3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimScrollBarThumb}" />
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Full tab list + "+ Nueva nota", shown once the panel is (nearly) fully expanded. -->
        <Grid x:Name="PanelContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0"
                          Margin="0,0,4,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TabsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Background="{Binding Color}"
                                    Margin="4"
                                    Padding="6"
                                    Click="OnTabClick"
                                    Tag="{Binding}"
                                    Style="{StaticResource NoteTabButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <Button x:Name="NewNoteButton" Content="+ Nueva nota" Margin="4" Padding="6" Click="OnNewNoteClick" />
                <Button x:Name="ToggleArchiveButton" Content="Archivadas" Margin="4" Padding="6" Click="OnToggleArchiveClick" />
                <!-- Bulk archive/restore/trash needs real room (checkboxes + a list + a toolbar
                     don't fit this compact panel), so it opens its own properly-sized
                     NotesManagerWindow instead of trying to do it inline here. Always visible —
                     not just while viewing the archive — so it's reachable from either view. -->
                <Button x:Name="ManageArchiveButton" Margin="4" Padding="6" Click="OnManageArchiveClick"
                        ToolTip="Gestionar notas">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Compact color-swatch preview shown while the pill is resting (collapsed). No
             scrollbar here even if it overflows — Auto would show the same slim thumb as the
             tab list, but a resting pill isn't a place anyone scrolls (any hover over it expands
             the panel instead), so it's just visual noise there. -->
        <ScrollViewer x:Name="PillSwatches"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=TabsList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Color}"
                                Width="12" Height="14"
                                Margin="4,3"
                                CornerRadius="4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
