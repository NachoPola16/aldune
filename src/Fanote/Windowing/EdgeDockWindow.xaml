<Window x:Class="Fanote.Windowing.EdgeDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fanote.Windowing"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Background="#2A261F">
    <Window.Resources>
        <local:NoteTabLabelConverter x:Key="NoteTabLabelConverter" />
        <local:NoteRimConverter x:Key="NoteRimConverter" />
        <local:NoteLabelColorConverter x:Key="NoteLabelColorConverter" />

        <!-- El único modo de dar volumen a una pestaña aquí. La spec v1 descarta
             AllowsTransparency (rompe ClearType), así que cada píxel dentro de la región es
             opaco y no cabe ninguna sombra: la profundidad tiene que venir de dentro. Claro en
             el borde libre (izquierda, la que sobresale) y algo más hondo hacia el borde físico
             de pantalla, que es como caería la luz sobre una ficha que asoma de un fichero. -->
        <LinearGradientBrush x:Key="TabSheen" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#20FFFFFF" />
            <GradientStop Offset="0.45" Color="#00FFFFFF" />
            <GradientStop Offset="1" Color="#12000000" />
        </LinearGradientBrush>

        <Style x:Key="NoteTabButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Redondeada solo por la izquierda (el borde libre, lejos del borde
                             físico de pantalla contra el que está pegado el dock). El orden de
                             CornerRadius es (TopLeft, TopRight, BottomRight, BottomLeft). Que la
                             derecha quede cuadrada no es estético: SetTabFanRegion construye la
                             región a partir de estos mismos rects y da por hecho este lado. -->
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{Binding Color, Converter={StaticResource NoteRimConverter}}"
                                    BorderThickness="1,1,0,1"
                                    CornerRadius="10,0,0,10" />
                            <Border Background="{StaticResource TabSheen}" CornerRadius="10,0,0,10" />

                            <!-- Etiqueta del lomo: girada -90° con LayoutTransform (no Render:
                                 intercambia los ejes de medida, que es justo lo que hace falta
                                 para que el alto de la pestaña sea el ancho del texto). Alineada
                                 a la izquierda y no centrada porque en reposo solo asoman los
                                 16px de la derecha — así el reposo es color liso y nada más. Va
                                 en un tono oscuro del propio color de la nota, no en negro:
                                 el negro sería el único valor de la pestaña sin relación de hue
                                 con ella. -->
                            <TextBlock Text="{Binding Text, Converter={StaticResource NoteTabLabelConverter}}"
                                       Foreground="{Binding Color, Converter={StaticResource NoteLabelColorConverter}}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="92"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90" />
                                </TextBlock.LayoutTransform>
                            </TextBlock>

                            <!-- Troquelado. Marca dónde acaba el lomo y empieza el cuerpo: al
                                 abrir la nota, todo lo que queda a la izquierda de esta línea
                                 viaja con ella (ver NoteWindow y EdgeGeometry.SpineWidth). Los
                                 16px a su derecha son el trocito de cuerpo que asoma, y son
                                 exactamente lo que se ve del dock en reposo.

                                 Path + StrokeDashArray y no una OpacityMask en mosaico: es la
                                 receta estandar de WPF para una regla discontinua de alto
                                 variable. Stretch="Fill" sobre una LineGeometry degenerada estira
                                 solo el eje que tiene longitud. -->
                            <Path Stroke="{Binding Color, Converter={StaticResource NoteRimConverter}}"
                                  StrokeThickness="1"
                                  StrokeDashArray="3 3"
                                  Stretch="Fill"
                                  Width="1"
                                  Opacity="0.7"
                                  HorizontalAlignment="Right"
                                  Margin="0,10,16,10"
                                  SnapsToDevicePixels="True">
                                <Path.Data>
                                    <LineGeometry StartPoint="0,0" EndPoint="0,1" />
                                </Path.Data>
                            </Path>

                            <Border x:Name="HoverOverlay" Background="#1E1A14" Opacity="0" CornerRadius="10,0,0,10" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.08" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.16" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircularIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="#EDE7DC" />
            <Setter Property="Background" Value="#3C3730" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4E4840" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#5F584E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Un solo panel. El estado de reposo no es otro contenido: son estas mismas pestañas,
         desplazadas con RenderTransform (nunca con layout) y recortadas por la región a los 16px
         que asoman. -->
    <Grid x:Name="PanelContent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de scroll oculta, no reestilizada: la rueda sigue funcionando, y la región
             recorta cualquier cosa que no sea una pestaña, así que una barra dibujada sobre el
             fondo sería invisible igualmente. -->
        <ScrollViewer x:Name="TabsScroll"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="TabsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Ancho uniforme: si fuera una escalera, cada nota se abriría con un
                             lomo de grosor distinto (ver EdgeGeometry). -->
                        <Button Content="{Binding}"
                                Background="{Binding Color}"
                                Width="104"
                                Height="100"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Right"
                                Click="OnTabClick"
                                Loaded="OnTabLoaded"
                                Tag="{Binding}"
                                Style="{StaticResource NoteTabButtonStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel x:Name="FooterPanel" Grid.Row="1" HorizontalAlignment="Right">
            <Button x:Name="NewNoteButton" Click="OnNewNoteClick"
                    Style="{StaticResource CircularIconButtonStyle}"
                    ToolTip="Nueva nota">
                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
            </Button>
            <Button x:Name="ManageArchiveButton" Click="OnManageArchiveClick"
                    Style="{StaticResource CircularIconButtonStyle}"
                    ToolTip="Gestionar notas">
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
