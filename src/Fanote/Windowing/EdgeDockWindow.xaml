<Window x:Class="Fanote.Windowing.EdgeDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fanote.Windowing"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Background="#2A261F">
    <Window.Resources>
        <local:NoteTitleConverter x:Key="NoteTitleConverter" />
        <local:NoteRimConverter x:Key="NoteRimConverter" />

        <!-- El único modo de dar volumen a una pestaña aquí. La spec v1 descarta
             AllowsTransparency (rompe ClearType), así que cada píxel dentro de la región es
             opaco y no cabe ninguna sombra: la profundidad tiene que venir de dentro. Claro en
             el borde libre (izquierda, la que sobresale) y algo más hondo hacia el borde físico
             de pantalla, que es como caería la luz sobre una pestaña que asoma. -->
        <LinearGradientBrush x:Key="TabSheen" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#20FFFFFF" />
            <GradientStop Offset="0.45" Color="#00FFFFFF" />
            <GradientStop Offset="1" Color="#12000000" />
        </LinearGradientBrush>

        <Style x:Key="NoteTabButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#1E1A14" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <!-- Pegada al borde libre (izquierda) y no centrada: en reposo solo asoman
                             los 20px de la derecha, así que un título centrado asomaría a medias
                             en las pestañas estrechas. Aquí el reposo es color liso y nada más. -->
                        <TextBlock Text="{Binding Text, Converter={StaticResource NoteTitleConverter}}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Redondeada solo por la izquierda (el borde libre, lejos del borde
                             físico de pantalla contra el que está pegado el dock). El orden de
                             CornerRadius es (TopLeft, TopRight, BottomRight, BottomLeft). Que la
                             derecha quede cuadrada no es estético: SetTabFanRegion construye la
                             región a partir de estos mismos rects y da por hecho este lado. -->
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{Binding Color, Converter={StaticResource NoteRimConverter}}"
                                    BorderThickness="1,1,0,1"
                                    CornerRadius="9,0,0,9" />
                            <Border Background="{StaticResource TabSheen}" CornerRadius="9,0,0,9" />
                            <Border x:Name="HoverOverlay" Background="#1E1A14" Opacity="0" CornerRadius="9,0,0,9" />
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.10" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.20" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircularIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="#EDE7DC" />
            <Setter Property="Background" Value="#3C3730" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4E4840" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#5F584E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Un solo panel, no dos superpuestos con fundido cruzado. El estado de reposo ya no es otro
         contenido: son estas mismas pestañas, recortadas por la región a los 20px que asoman. Eso
         se lleva por delante el patrón de Opacity + IsHitTestVisible sincronizados a mano que
         documenta STATUS.md (punto 5 del "pulido visual"), porque ya no hay dos capas que puedan
         robarse los clics la una a la otra. -->
    <Grid x:Name="PanelContent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de scroll oculta, no reestilizada: la rueda del ratón sigue funcionando, y la
             región recorta cualquier cosa que no sea una pestaña, así que una barra dibujada
             sobre el fondo sería invisible de todos modos. Reinventar la barra de scroll era
             además el tipo de afordancia estándar que no conviene recrear en una UI de producto. -->
        <ScrollViewer x:Name="TabsScroll"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="TabsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Width se fija por código (depende del índice dentro del abanico, que
                             XAML no puede expresar limpiamente). Sin Opacity="0" inicial: ya no
                             hay animación de opacidad por pestaña — quien revela es la región. -->
                        <Button Content="{Binding}"
                                Background="{Binding Color}"
                                Height="80"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Right"
                                Padding="10,0,0,0"
                                Click="OnTabClick"
                                Loaded="OnTabLoaded"
                                Tag="{Binding}"
                                Style="{StaticResource NoteTabButtonStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel x:Name="FooterPanel" Grid.Row="1" HorizontalAlignment="Right">
            <Button x:Name="NewNoteButton" Click="OnNewNoteClick"
                    Style="{StaticResource CircularIconButtonStyle}"
                    ToolTip="Nueva nota">
                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
            </Button>
            <Button x:Name="ManageArchiveButton" Click="OnManageArchiveClick"
                    Style="{StaticResource CircularIconButtonStyle}"
                    ToolTip="Gestionar notas">
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
