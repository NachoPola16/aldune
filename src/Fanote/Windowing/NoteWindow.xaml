<Window x:Class="Fanote.Windowing.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fanote"
        Width="260" Height="300"
        WindowStyle="ToolWindow"
        Topmost="True">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4">
            <Button Content="Archivar" Click="OnArchiveClick" Margin="0,0,4,0" Padding="6,2" />
            <Button Content="Papelera" Click="OnTrashClick" Padding="6,2" />
        </StackPanel>
        <StackPanel x:Name="ColorSwatches" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4,4,4,0" />
        <TextBox x:Name="TextBody"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Padding="8"
                 BorderThickness="0" />
    </DockPanel>
</Window>
