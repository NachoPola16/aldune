<Window x:Class="Fanote.Windowing.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fanote"
        Width="348" Height="300"
        MinWidth="268" MinHeight="160"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Topmost="True">
    <WindowChrome.WindowChrome>
        <!-- No visible title bar: the top CaptionHeight strip is just the note's own tinted
             background, draggable like a real sticky note, with only the close button opted
             back into being clickable (see CloseButton below). GlassFrameThickness="-1" is the
             standard WindowChrome shorthand for the native drop shadow on a borderless window;
             rounded corners come separately from NativeMethods.ApplyRoundedCorners. -->
        <WindowChrome CaptionHeight="22" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="NoteActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#26000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Same shape/behavior as NoteActionButtonStyle, but tinted red — Papelera is
             destructive, so it gets a visually distinct "danger" cue at a glance. A separate
             template (rather than BasedOn) because the hover color needs to shift red too, not
             just the resting color that TemplateBinding would pick up. -->
        <Style x:Key="NoteDangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#33CC3333" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55CC3333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource NoteActionButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="PlaceholderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A1E1A14" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=TextBody}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <!-- Mismo borde de 1px del hue de la nota que llevan las pestañas del dock (ver
         NoteColorPalette.RimFor). Es lo único que puede separar la nota del escritorio: la spec v1
         descarta AllowsTransparency para no romper ClearType, así que no hay sombra posible dentro
         de la ventana. BorderBrush se fija por código en ApplyColor, que ya sabe el color. -->
    <Border x:Name="WindowRim" BorderThickness="1">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- El lomo: exactamente EdgeGeometry.SpineWidth. Es la misma pestaña que estaba en el
                 mazo, que ha viajado con la nota al abrirla — por eso el dock oculta la suya
                 mientras esta ventana existe (ver AppCoordinator.IsNoteOpen). -->
            <ColumnDefinition Width="88" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="Spine" Grid.Column="0">
            <TextBlock x:Name="SpineLabel"
                       FontSize="11"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="14,0,0,0">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="-90" />
                </TextBlock.LayoutTransform>
            </TextBlock>

            <!-- El troquelado, en el mismo sitio que en la pestaña del dock: el pliegue por donde
                 el lomo se une al cuerpo. Stroke se fija en ApplyColor. -->
            <Path x:Name="Perforation"
                  StrokeThickness="1"
                  StrokeDashArray="3 3"
                  Stretch="Fill"
                  Width="1"
                  Opacity="0.7"
                  HorizontalAlignment="Right"
                  Margin="0,14,0,14"
                  SnapsToDevicePixels="True">
                <Path.Data>
                    <LineGeometry StartPoint="0,0" EndPoint="0,1" />
                </Path.Data>
            </Path>
        </Grid>

        <Grid Grid.Column="1">
        <DockPanel Margin="20">
            <StackPanel x:Name="ActiveActions" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Click="OnArchiveClick" Margin="0,0,6,0" Padding="10,4"
                        Style="{StaticResource NoteActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Archivar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="OnTrashClick" Padding="10,4"
                        Style="{StaticResource NoteDangerButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Papelera" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <!-- Shown instead of ActiveActions when the note isn't Active (i.e. opened from
                 "Gestionar notas" while browsing archived/trashed notes) — restoring is the
                 only action offered, see STATUS.md. -->
            <StackPanel x:Name="InactiveActions" DockPanel.Dock="Bottom" Orientation="Horizontal"
                        Margin="0,8,0,0" Visibility="Collapsed">
                <Button Click="OnRestoreClick" Padding="10,4"
                        Style="{StaticResource NoteActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Restaurar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel x:Name="ColorSwatches" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0" />
            <Grid>
                <TextBlock Text="Escribe algo…" FontSize="14" Style="{StaticResource PlaceholderStyle}" />
                <!-- Tinta tintada hacia el cálido, nunca #000 puro: sobre un pastel, el negro
                     absoluto es el único color de la ventana que no comparte hue con nada. -->
                <TextBox x:Name="TextBody"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontSize="14"
                         Foreground="#1E1A14"
                         CaretBrush="#1E1A14"
                         BorderThickness="0" />
            </Grid>
        </DockPanel>
        <Button x:Name="CloseButton"
                Content="&#x2715;"
                Width="22" Height="22"
                Margin="0,2,2,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="OnCloseClick"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Style="{StaticResource CloseButtonStyle}" />
    </Grid>
    </Grid>
    </Border>
</Window>