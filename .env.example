# Copy to .env on the server and replace with a long random secret.
ALDUNE_SYNC_TOKEN=replace-with-a-long-random-token
# Optional rotation window: comma-separated active tokens. If set, this takes precedence over
# ALDUNE_SYNC_TOKEN. Keep old and new together temporarily, then remove the old token.
ALDUNE_SYNC_TOKENS=
ALDUNE_SYNC_PORT=8087
# Nombre fisico del volumen que guarda los objetos sincronizados (opcional). Solo hace falta si
# actualizas un servidor que ya sincronizaba antes del cambio de marca: ver docs/SYNC.md.
# ALDUNE_SYNC_VOLUME=aldune-sync-data
# ALDUNE_SYNC_DOMAIN=sync.example.com  # only for docker-compose.sync.https.yml
# Failed-token rate limit per client address (default 10 failures per minute, then 429). 0 disables it.
# ALDUNE_SYNC_MAX_AUTH_FAILURES_PER_MINUTE=10
# Set to 1 ONLY when the server is behind a reverse proxy that sets X-Forwarded-For (Caddy, nginx, Cloudflare Tunnel):
# the limit then counts the address the proxy saw instead of the proxy's own. The https compose file already sets it.
# ALDUNE_SYNC_TRUST_PROXY=1
