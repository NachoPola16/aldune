# Copy to .env on the server and replace with a long random secret.
FANOTE_SYNC_TOKEN=replace-with-a-long-random-token
# Optional rotation window: comma-separated active tokens. If set, this takes precedence over
# FANOTE_SYNC_TOKEN. Keep old and new together temporarily, then remove the old token.
FANOTE_SYNC_TOKENS=
FANOTE_SYNC_PORT=8087
