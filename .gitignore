bin/
obj/
.vs/
*.user

# Worktrees y estado local de herramientas: nunca deben versionarse.
.claude/

# Salida de `dotnet publish -p:PublishProfile=portable`: 80 MB de .NET autocontenido que se
# regeneran con un comando. Lo que se versiona es el perfil, no su resultado.
publish/
dist/

# Informes y artefactos locales de herramientas de análisis.
graphify-out/

# Datos locales de ejecución si alguna prueba manual o configuración alternativa los deja en el
# directorio del proyecto. La aplicación normal los guarda en %LOCALAPPDATA%\Aldune.
notes.db
notes.db-*
settings.json
settings.json.*
*.corrupt-*

# Logs, volcados y archivos temporales.
tmp/
*.log
*.dmp
*.tmp
*.bak

# Credenciales o certificados que nunca deben terminar en el repositorio.
.env
.env.*
!.env.example
*.pfx
*.p12
*.pem
*.key
# Claves de firma de Android (también ignoradas dentro de android/).
*.jks
*.keystore

# Configuración local habitual de otros editores y herramientas.
.idea/
.vscode/
*.suo
*.userosscache
*.sln.docstates

# APK firmado de una release de Android: se sube al GitHub Release, no al repositorio (docs/RELEASING.md).
android/*.apk

# Instrucciones y estado local de asistentes de código y de herramientas de prueba: viven en el disco del
# autor, no en el repositorio.
/AGENTS.md
/CLAUDE.md
/GEMINI.md
.mcp.json
.superpowers/
.cursor/
.codex/
.gemini/
.windsurf/
.cline/
.continue/
.aider*
.playwright-mcp/
